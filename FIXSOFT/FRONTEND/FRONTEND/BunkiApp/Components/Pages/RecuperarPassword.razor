@page "/recuperar-password"
@rendermode InteractiveServer
@layout EmptyLayout
@inject BunkiApp.Services.UsuarioProvider UsuarioProvider

<PageTitle>Bunki · Recuperar contraseña</PageTitle>

<header>
    <div class="navbar container">
        <a href="/login" class="logo"><i class="fas fa-home"></i> Bunki</a>
    </div>
</header>

<div class="section">
    <div class="container" style="max-width: 440px;">
        <h2 class="section-title">Recuperar contraseña</h2>

        @if (!Exito)
        {
            <p class="card-text" style="margin-bottom: 22px;">
                Verifica tu identidad con tu correo y tu número de documento, y define una nueva contraseña.
            </p>

            <EditForm Model="Formulario" OnValidSubmit="Recuperar">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label>Correo electrónico</label>
                    <InputText @bind-Value="Formulario.Email" type="email" placeholder="tu@ejemplo.com" />
                    <ValidationMessage For="() => Formulario.Email" class="validation-message" />
                </div>

                <div class="form-group">
                    <label>Número de documento (DNI / Pasaporte)</label>
                    <InputText @bind-Value="Formulario.Documento" placeholder="Ej: 40111222" />
                    <ValidationMessage For="() => Formulario.Documento" class="validation-message" />
                </div>

                <div class="form-group">
                    <label>Nueva contraseña</label>
                    <InputText @bind-Value="Formulario.NuevaPassword" type="password" placeholder="Mínimo 6 caracteres" />
                    <ValidationMessage For="() => Formulario.NuevaPassword" class="validation-message" />
                </div>

                <div class="form-group">
                    <label>Confirmar contraseña</label>
                    <InputText @bind-Value="Formulario.ConfirmarPassword" type="password" placeholder="Repite la contraseña" />
                    <ValidationMessage For="() => Formulario.ConfirmarPassword" class="validation-message" />
                </div>

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div style="background: var(--danger-tint); color: var(--danger-text); padding: 12px 14px; border-radius: 8px; border: 1px solid var(--danger); margin-bottom: 16px; font-size: 14px;">
                        <i class="fas fa-circle-exclamation"></i> @Error
                    </div>
                }

                <button type="submit" class="btn btn-primary btn-large" disabled="@Cargando" style="width: 100%;">
                    @if (Cargando)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                    }
                    Actualizar contraseña
                </button>
            </EditForm>
        }
        else
        {
            <div style="text-align: center; padding: 26px 0;">
                <div class="empty-state-icon" style="margin: 0 auto 16px;"><i class="fas fa-circle-check"></i></div>
                <h3 style="margin-bottom: 10px;">Contraseña actualizada</h3>
                <p class="card-text" style="margin-bottom: 22px;">Ya puedes iniciar sesión con tu nueva contraseña.</p>
                <a href="/login" class="btn btn-primary">Iniciar sesión</a>
            </div>
        }

        <p style="text-align: center; margin-top: 20px; color: var(--ink-muted);">
            ¿Recordaste tu contraseña? <a href="/login" style="color: var(--accent); text-decoration: none;">Inicia sesión</a>
        </p>
    </div>
</div>

<footer>
    <div class="container">
        <p>&copy; 2026 Bunki. Todos los derechos reservados.</p>
    </div>
</footer>

@code {
    private RecuperarPasswordForm Formulario = new();
    private bool Cargando = false;
    private bool Exito = false;
    private string Error = "";

    private async Task Recuperar()
    {
        Error = "";
        Cargando = true;
        try
        {
            var (ok, error) = await UsuarioProvider.RecuperarAsync(
                Formulario.Email.Trim(),
                Formulario.Documento.Trim(),
                Formulario.NuevaPassword);

            if (ok)
            {
                Exito = true;
            }
            else
            {
                Error = string.IsNullOrWhiteSpace(error)
                    ? "Los datos no coinciden con ninguna cuenta."
                    : error;
            }
        }
        finally
        {
            Cargando = false;
        }
    }
}
