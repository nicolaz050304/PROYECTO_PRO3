@page "/recuperar-password"
@rendermode InteractiveServer
@layout EmptyLayout
@inject BunkiApp.Services.UsuarioProvider UsuarioProvider

<PageTitle>Bunki · Recuperar contraseña</PageTitle>

@* Mismo split-layout de marca que Login/Registro (panel visual + formulario). La lógica del
   EditForm, los campos y el @code quedan intactos: solo se reubica el marcado en la estructura
   .auth-split para mantener coherencia visual en todo el flujo de autenticación. *@
<div class="auth-split">

    <!-- Panel visual de marca -->
    <aside class="auth-visual">
        <a href="/login" class="logo"><i class="fas fa-home"></i> Bunki</a>
        <div class="auth-visual-content">
            <span class="auth-visual-eyebrow">Seguridad de la cuenta</span>
            <h2 class="auth-visual-title">Recupera el acceso a tu <span class="editorial-accent">cuenta</span></h2>
            <p class="auth-visual-sub">Verifica tu identidad y define una contraseña nueva para volver a entrar.</p>
        </div>
    </aside>

    <!-- Formulario -->
    <main class="auth-form-side">
        <div class="auth-form">
            <a href="/login" class="logo auth-mini-logo"><i class="fas fa-home"></i> Bunki</a>

            @if (!Exito)
            {
                <h1 class="auth-title">Recuperar contraseña</h1>
                <p class="auth-sub">Verifica tu identidad con tu correo y tu número de documento, y define una nueva contraseña.</p>

                <EditForm Model="Formulario" OnValidSubmit="Recuperar">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label>Correo electrónico</label>
                        <InputText @bind-Value="Formulario.Email" type="email" placeholder="tu@ejemplo.com" />
                        <ValidationMessage For="() => Formulario.Email" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>Número de documento (DNI / Pasaporte)</label>
                        <InputText @bind-Value="Formulario.Documento" placeholder="Ej: 40111222" />
                        <ValidationMessage For="() => Formulario.Documento" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>Nueva contraseña</label>
                        <InputText @bind-Value="Formulario.NuevaPassword" type="password" placeholder="Mínimo 6 caracteres" />
                        <ValidationMessage For="() => Formulario.NuevaPassword" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>Confirmar contraseña</label>
                        <InputText @bind-Value="Formulario.ConfirmarPassword" type="password" placeholder="Repite la contraseña" />
                        <ValidationMessage For="() => Formulario.ConfirmarPassword" class="validation-message" />
                    </div>

                    @if (!string.IsNullOrEmpty(Error))
                    {
                        <AlertMessage Tipo="danger" Mensaje="@Error" />
                    }

                    <button type="submit" class="btn btn-primary btn-large auth-submit" disabled="@Cargando">
                        @if (Cargando)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                        }
                        Actualizar contraseña
                    </button>
                </EditForm>

                <p class="auth-alt">¿Recordaste tu contraseña? <a href="/login">Inicia sesión</a></p>
            }
            else
            {
                <div style="text-align: center;">
                    <div class="empty-state-icon" style="margin: 0 auto 16px;"><i class="fas fa-circle-check"></i></div>
                    <h1 class="auth-title">Contraseña actualizada</h1>
                    <p class="auth-sub">Ya puedes iniciar sesión con tu nueva contraseña.</p>
                    <a href="/login" class="btn btn-primary btn-large auth-submit">Iniciar sesión</a>
                </div>
            }

            <p class="auth-foot">© 2026 Bunki. Todos los derechos reservados.</p>
        </div>
    </main>
</div>

@code {
    private RecuperarPasswordForm Formulario = new();
    private bool Cargando = false;
    private bool Exito = false;
    private string Error = "";

    private async Task Recuperar()
    {
        Error = "";
        Cargando = true;
        try
        {
            var (ok, error) = await UsuarioProvider.RecuperarAsync(
                Formulario.Email.Trim(),
                Formulario.Documento.Trim(),
                Formulario.NuevaPassword);

            if (ok)
            {
                Exito = true;
            }
            else
            {
                Error = string.IsNullOrWhiteSpace(error)
                    ? "Los datos no coinciden con ninguna cuenta."
                    : error;
            }
        }
        finally
        {
            Cargando = false;
        }
    }
}
