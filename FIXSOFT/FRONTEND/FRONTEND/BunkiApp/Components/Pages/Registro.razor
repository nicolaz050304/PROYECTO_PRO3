@page "/registro"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@layout EmptyLayout
@inject BunkiApp.Models.AppState AppState
@inject Services.UsuarioProvider UsuarioProvider
<PageTitle>Bunki - Crear Cuenta</PageTitle>

@* Split-layout: panel de marca + formulario. El EditForm, sus binds, validaciones y Registrar() quedan
   EXACTAMENTE iguales; solo cambia la composición visual y se añaden los toggles de contraseña. *@
<div class="auth-split">

    <!-- Panel visual de marca -->
    <aside class="auth-visual">
        <a href="/" class="logo"><i class="fas fa-home"></i> Bunki</a>
        <div class="auth-visual-content">
            <span class="auth-visual-eyebrow">Una cuenta, dos formas de viajar</span>
            <h2 class="auth-visual-title">Encuentra estadías <span class="editorial-accent">extraordinarias</span> en Perú</h2>
            <p class="auth-visual-sub">Con una sola cuenta reservas alojamientos y publicas los tuyos.</p>
        </div>
    </aside>

    <!-- Formulario -->
    <main class="auth-form-side">
        <div class="auth-form">
            <a href="/" class="logo auth-mini-logo"><i class="fas fa-home"></i> Bunki</a>

            <h1 class="auth-title">Crea tu cuenta</h1>
            <p class="auth-sub">Empieza a reservar y a publicar en minutos.</p>

            @if (_exito)
            {
                <AlertMessage Tipo="success" Mensaje="¡Cuenta creada! Redirigiendo..." Cerrable="false" />
            }
            @if (!string.IsNullOrEmpty(_errorMsg))
            {
                <AlertMessage Tipo="danger" Mensaje="@_errorMsg" />
            }

            <EditForm Model="_form" OnValidSubmit="Registrar">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-message" style="margin-bottom:16px;" />

                <div class="form-row">
                    <div class="form-group">
                        <label>Nombre</label>
                        <InputText @bind-Value="_form.Nombre" placeholder="Juan" />
                        <ValidationMessage For="() => _form.Nombre" class="validation-message" />
                    </div>
                    <div class="form-group">
                        <label>Apellido</label>
                        <InputText @bind-Value="_form.Apellido" placeholder="Pérez" />
                        <ValidationMessage For="() => _form.Apellido" class="validation-message" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Correo electrónico</label>
                    <InputText @bind-Value="_form.Email" type="email" placeholder="tu@ejemplo.com" />
                    <ValidationMessage For="() => _form.Email" class="validation-message" />
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    @* Toggle mostrar/ocultar con estado Blazor (no toca el bind ni la validación). *@
                    <div class="pw-field">
                        <InputText @bind-Value="_form.Password" type="@(_verPassword ? "text" : "password")" placeholder="••••••••" />
                        <button type="button" class="pw-toggle" aria-label="Mostrar contraseña"
                                @onclick="() => _verPassword = !_verPassword">
                            <i class="fas @(_verPassword ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                    <ValidationMessage For="() => _form.Password" class="validation-message" />
                </div>

                <div class="form-group">
                    <label>Confirmar contraseña</label>
                    @* Confirmar contraseña SE CONSERVA: quitarla tocaría el modelo y la validación; se pule
                       visualmente y se le añade su propio toggle. *@
                    <div class="pw-field">
                        <InputText @bind-Value="_form.ConfirmarPassword" type="@(_verConfirm ? "text" : "password")" placeholder="••••••••" />
                        <button type="button" class="pw-toggle" aria-label="Mostrar contraseña"
                                @onclick="() => _verConfirm = !_verConfirm">
                            <i class="fas @(_verConfirm ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                    <ValidationMessage For="() => _form.ConfirmarPassword" class="validation-message" />
                </div>

                @* Checkbox + etiqueta alineados via .auth-terms (antes el reset global input{width:100%}
                   deformaba el checkbox). *@
                <div class="auth-terms">
                    <InputCheckbox @bind-Value="_form.AceptaTerminos" id="terms" />
                    <label for="terms">Acepto los <a href="#">términos y condiciones</a></label>
                </div>

                @if (!_form.AceptaTerminos && _intentoEnviar)
                {
                    <p class="validation-message">Debes aceptar los términos y condiciones.</p>
                }

                <button type="submit" class="btn btn-primary btn-large auth-submit"
                        @onclick="() => _intentoEnviar = true" disabled="@_cargando">
                    @if (_cargando) { <i class="fas fa-spinner fa-spin"></i> }
                    Crear cuenta
                </button>
            </EditForm>

            <p class="auth-alt">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
            <p class="auth-foot">© 2026 Bunki. Todos los derechos reservados.</p>
        </div>
    </main>
</div>

@code {
    private readonly RegistroForm _form = new();
    private bool _cargando    = false;
    private bool _exito       = false;
    private bool _intentoEnviar = false;
    private string _errorMsg  = "";

    // Estado SOLO de presentación para los toggles de ojo (no afecta binds ni validación).
    private bool _verPassword = false;
    private bool _verConfirm  = false;

    private async Task Registrar()
    {
        if (!_form.AceptaTerminos) return;

        _errorMsg = "";
        if (_form.Password != _form.ConfirmarPassword)
        {
            _errorMsg = "Las contraseñas no coinciden.";
            return;
        }

        _cargando = true;
        try
        {
            // Crea el usuario REAL en el backend (POST UsuarioRS) y hashea la contraseña.
            // Modelo de negocio: toda cuenta nace ANFITRION (puede publicar y, como Anfitrion
            // extiende Cliente, también reservar).
            var usuario = new Usuario
            {
                Nombre      = _form.Nombre,
                Apellido    = _form.Apellido,   // serializa a "apellidoPaterno"
                Email       = _form.Email,      // serializa a "correo"
                Password    = _form.Password,   // serializa a "password"; el backend lo hashea
                TipoUsuario = "ANFITRION"
            };
            await UsuarioProvider.RegistrarAsync(usuario);

            // Creado OK: hacemos LOGIN REAL con las credenciales recién registradas para que la
            // sesión nazca con el TipoUsuario real del backend (ANFITRION) y se vea el menú completo
            // sin re-login. Mismo patrón que Login.razor.
            var usuarioLogueado = await UsuarioProvider.LoginAsync(_form.Email, _form.Password);
            if (usuarioLogueado is not null)
            {
                AppState.LoginConUsuario(usuarioLogueado);   // sesión con el TipoUsuario real (ANFITRION)
            }
            // (si el login devuelve null, igual continúa al home; el usuario podrá loguear manual)
            _exito = true;
            await Task.Delay(800);
            Navigation.NavigateTo("/");
        }
        catch
        {
            _errorMsg = "No se pudo crear la cuenta. ¿Quizás el correo ya está registrado?";
        }
        finally
        {
            _cargando = false;
        }
    }
}
