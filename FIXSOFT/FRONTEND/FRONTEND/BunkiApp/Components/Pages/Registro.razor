@page "/registro"
@layout EmptyLayout
<PageTitle>Bunki - Crear Cuenta</PageTitle>

@* Split-layout de marca + formulario. IMPORTANTE: es un form POST ESTÁTICO a /auth/register (igual
   que Login.razor → /auth/login), NO un EditForm interactivo. Solo el endpoint puede escribir la cookie
   de sesión con SignInAsync antes de comprometer la respuesta; un circuito interactivo dejaría al
   usuario logueado solo en memoria y lo desconectaría al recargar. Las validaciones viven en el
   endpoint y los errores vuelven por ?error=. *@
<div class="auth-split">

    <!-- Panel visual de marca -->
    <aside class="auth-visual">
        <a href="/" class="logo"><i class="fas fa-home"></i> Bunki</a>
        <div class="auth-visual-content">
            <span class="auth-visual-eyebrow">Una cuenta, dos formas de viajar</span>
            <h2 class="auth-visual-title">Encuentra estadías <span class="editorial-accent">extraordinarias</span> en Perú</h2>
            <p class="auth-visual-sub">Con una sola cuenta reservas alojamientos y publicas los tuyos.</p>
        </div>
    </aside>

    <!-- Formulario -->
    <main class="auth-form-side">
        <div class="auth-form">
            <a href="/" class="logo auth-mini-logo"><i class="fas fa-home"></i> Bunki</a>

            <h1 class="auth-title">Crea tu cuenta</h1>
            <p class="auth-sub">Empieza a reservar y a publicar en minutos.</p>

            @if (Error is not null)
            {
                <AlertMessage Tipo="danger" Mensaje="@MensajeError" />
            }

            @* Form POST estático: action, method y los name de los campos los lee /auth/register. *@
            <form action="/auth/register" method="post">
                <div class="form-row">
                    <div class="form-group">
                        <label>Nombre</label>
                        <input name="nombre" type="text" placeholder="Juan" required />
                    </div>
                    <div class="form-group">
                        <label>Apellido</label>
                        <input name="apellido" type="text" placeholder="Pérez" required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Correo electrónico</label>
                    <input name="correo" type="email" placeholder="tu@ejemplo.com" required />
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    @* Toggle de ojo: mismo JS mínimo que Login (bunkiPw.toggle), sin interactividad Blazor. *@
                    <div class="pw-field">
                        <input id="reg-pw" name="password" type="password" placeholder="••••••••" minlength="6" required />
                        <button type="button" class="pw-toggle" aria-label="Mostrar contraseña" onclick="bunkiPw.toggle(this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Confirmar contraseña</label>
                    <div class="pw-field">
                        <input id="reg-pw2" name="confirmar" type="password" placeholder="••••••••" minlength="6" required />
                        <button type="button" class="pw-toggle" aria-label="Mostrar contraseña" onclick="bunkiPw.toggle(this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="auth-terms">
                    <input type="checkbox" name="terminos" id="terms" value="true" required />
                    <label for="terms">Acepto los <a href="#">términos y condiciones</a></label>
                </div>

                <button type="submit" class="btn btn-primary btn-large auth-submit">Crear cuenta</button>
            </form>

            <p class="auth-alt">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
            <p class="auth-foot">© 2026 Bunki. Todos los derechos reservados.</p>
        </div>
    </main>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private string MensajeError => Error switch
    {
        "campos"    => "Completa todos los campos.",
        "terminos"  => "Debes aceptar los términos y condiciones.",
        "password"  => "Las contraseñas no coinciden.",
        "duplicado" => "No se pudo crear la cuenta. ¿Quizás el correo ya está registrado?",
        _           => "No se pudo crear la cuenta. Inténtalo de nuevo."
    };
}
