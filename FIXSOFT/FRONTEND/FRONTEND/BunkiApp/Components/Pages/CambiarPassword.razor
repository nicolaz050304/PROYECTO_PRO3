@page "/perfil/cambiar-password"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState
@inject BunkiApp.Services.UsuarioProvider UsuarioProvider

<PageTitle>Bunki - Cambiar Contraseña</PageTitle>

<div class="section">
    <div class="container" style="max-width: 500px;">
        <div style="background: var(--card-bg); padding: 35px; border-radius: var(--radius-xl); box-shadow: var(--shadow); border: 1px solid var(--border);">
            <div style="text-align: center; margin-bottom: 30px;">
                <!-- CORRECCIÓN: Ajuste de fondo del ícono para que resalte en modo oscuro -->
                <div style="width: 80px; height: 80px; background: rgba(31, 107, 94, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; border: 1px solid rgba(31, 107, 94, 0.2);">
                    <i class="fas fa-lock" style="font-size: 32px; color: var(--primary);"></i>
                </div>
                <h2 style="margin-bottom: 10px; color: var(--light-text); font-weight: 700;">Cambiar Contraseña</h2>
                <p class="card-text">Actualiza tu contraseña para mantener tu cuenta segura.</p>
            </div>

            @if (!string.IsNullOrEmpty(MensajeExito))
            {
                <AlertMessage Tipo="success" Mensaje="@MensajeExito" />
            }
            @if (!string.IsNullOrEmpty(MensajeError))
            {
                <AlertMessage Tipo="danger" Mensaje="@MensajeError" />
            }

            <EditForm Model="Formulario" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label>Contraseña Actual</label>
                    <div style="position: relative;">
                        <InputText @bind-Value="Formulario.PasswordActual" type="password"
                                   placeholder="Ingresa tu contraseña actual" />
                        <i class="fas fa-lock" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: var(--text-light); pointer-events: none;"></i>
                    </div>
                    <ValidationMessage For="() => Formulario.PasswordActual" class="validation-message" />
                </div>

                <div class="form-group">
                    <label>Nueva Contraseña</label>
                    <div style="position: relative;">
                        <InputText @bind-Value="Formulario.NuevaPassword" type="password"
                                   placeholder="Ingresa tu nueva contraseña" />
                        <i class="fas fa-key" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: var(--text-light); pointer-events: none;"></i>
                    </div>
                    <ValidationMessage For="() => Formulario.NuevaPassword" class="validation-message" />
                </div>

                <div class="form-group">
                    <label>Confirmar Nueva Contraseña</label>
                    <div style="position: relative;">
                        <InputText @bind-Value="Formulario.ConfirmarPassword" type="password"
                                   placeholder="Repite tu nueva contraseña" />
                        <i class="fas fa-check-circle" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: var(--text-light); pointer-events: none;"></i>
                    </div>
                    <ValidationMessage For="() => Formulario.ConfirmarPassword" class="validation-message" />
                </div>

                <!-- REQUISITOS -->
                <div style="background: rgba(255, 255, 255, 0.02); padding: 18px; border-radius: 12px; margin-bottom: 25px; border: 1px solid var(--border);">
                    <h4 style="margin-bottom: 12px; color: var(--light-text); font-size: 14px; font-weight: 600;">Requisitos de la contraseña</h4>

                    <p class="card-text" style="font-size: 13px; display: flex; align-items: center;">
                        <i class="fas fa-@(Formulario.NuevaPassword.Length >= 8 ? "check" : "times")"
                           style="color: var(--@(Formulario.NuevaPassword.Length >= 8 ? "success" : "text-light")); margin-right: 10px; width: 14px; text-align: center;"></i>
                        Mínimo 8 caracteres
                    </p>

                    <p class="card-text" style="margin-top: 10px; font-size: 13px; display: flex; align-items: center;">
                        <i class="fas fa-@(Formulario.NuevaPassword.Any(char.IsUpper) ? "check" : "times")"
                           style="color: var(--@(Formulario.NuevaPassword.Any(char.IsUpper) ? "success" : "text-light")); margin-right: 10px; width: 14px; text-align: center;"></i>
                        Al menos una mayúscula
                    </p>

                    <p class="card-text" style="margin-top: 10px; font-size: 13px; display: flex; align-items: center;">
                        <i class="fas fa-@(Formulario.NuevaPassword.Any(char.IsDigit) ? "check" : "times")"
                           style="color: var(--@(Formulario.NuevaPassword.Any(char.IsDigit) ? "success" : "text-light")); margin-right: 10px; width: 14px; text-align: center;"></i>
                        Al menos un número
                    </p>
                </div>

                <div class="flex gap-15">
                    <button type="button" class="btn btn-outline" style="flex: 1;"
                            @onclick='() => Navigation.NavigateTo("/perfil")'>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" style="flex: 1;" disabled="@Guardando">
                        @if (Guardando)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                        }
                        Guardar Cambios
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!AppState.EstaAutenticado) { Navigation.NavigateTo("/login"); return; }
    }

    private CambiarPasswordForm Formulario = new();
    private string MensajeExito = "";
    private string MensajeError = "";
    private bool Guardando = false;

    private async Task Guardar()
    {
        Guardando = true;
        MensajeError = "";
        MensajeExito = "";

        var id = AppState.UsuarioActual?.Id ?? 0;
        if (id <= 0)
        {
            MensajeError = "Sesión no válida. Vuelve a iniciar sesión.";
            Guardando = false;
            return;
        }

        try
        {
            // Verifica la contraseña actual (BCrypt) y cambia a la nueva en el backend.
            var (ok, error) = await UsuarioProvider.CambiarPasswordAsync(
                id, Formulario.PasswordActual, Formulario.NuevaPassword);

            if (ok)
            {
                MensajeExito = "Contraseña actualizada correctamente.";
                await Task.Delay(1200);
                Navigation.NavigateTo("/perfil");
            }
            else
            {
                MensajeError = string.IsNullOrWhiteSpace(error)
                    ? "No se pudo cambiar la contraseña. Intenta de nuevo."
                    : error;
            }
        }
        finally
        {
            Guardando = false;
        }
    }
}
