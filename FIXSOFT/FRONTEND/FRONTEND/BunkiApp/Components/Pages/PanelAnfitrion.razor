@page "/panel-anfitrion"
@rendermode InteractiveServer
@inject AlojamientoProvider AlojamientoProvider
@inject Services.ReservaProvider ReservaProvider
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState
@inject Services.PagoProvider PagoProvider
@inject IJSRuntime JS
@using System.Globalization
@implements IDisposable
<PageTitle>Bunki - Centro de Anfitrión</PageTitle>

<div class="section host-page">
    <div class="container">

        <!-- CABECERA -->
        <header class="host-head">
            <div>
                <span class="host-head-eyebrow">Bunki Host Center</span>
                <h1 class="host-head-title">Hola, @NombreAnfitrion</h1>
                <p class="host-head-sub">Gestiona tus alojamientos, reservas e ingresos desde un solo lugar.</p>
            </div>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/crear-alojamiento")'>
                <i class="fas fa-plus-circle"></i> Crear alojamiento
            </button>
        </header>

        <!-- OVERVIEW BENTO -->
        <div class="host-overview">

            <!-- Spotlight: ingresos + mini bar-chart -->
            <div class="spotlight">
                <span class="spotlight-label"><i class="fas fa-sack-dollar"></i> Ganancias totales (neto)</span>
                @* data-countup: el dato estrella cuenta de 0 a su valor al cargar (count-up vía /js/countup.js).
                   El destino va como número invariante; el formato de moneda lo conserva Blazor (snap final). *@
                <div class="spotlight-value" data-countup="@GananciasReales.ToString(CultureInfo.InvariantCulture)">@AppState.FormatearPrecio(GananciasReales)</div>
                <p class="spotlight-sub"><span class="up"><i class="fas fa-receipt"></i> @CantidadPagos</span> pagos recibidos</p>
                <div class="spark-bars" aria-hidden="true">
                    @foreach (var m in Ingresos6m)
                    {
                        <div class="spark-col">
                            <div class="spark-bar" style="height:@(BarH(m.Valor))px"></div>
                            <div class="spark-cap">@m.Mes</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Anillo de ocupación -->
            <div class="gauge-card">
                @* Selector de período: la ocupación se PROYECTA hacia adelante (ventana futura desde hoy).
                   Al cambiar, recalcula con los datos ya cargados, sin volver a pedir al backend. *@
                <div class="periodo-selector" style="display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap; justify-content:center;">
                    <button class="@(_diasPeriodo==30 ? "btn btn-small btn-primary" : "btn btn-small btn-outline")"
                            @onclick="() => CambiarPeriodo(30)">Próximos 30 días</button>
                    <button class="@(_diasPeriodo==90 ? "btn btn-small btn-primary" : "btn btn-small btn-outline")"
                            @onclick="() => CambiarPeriodo(90)">Próximos 3 meses</button>
                    <button class="@(_diasPeriodo==365 ? "btn btn-small btn-primary" : "btn btn-small btn-outline")"
                            @onclick="() => CambiarPeriodo(365)">Próximos 12 meses</button>
                </div>
                <div class="gauge" style="--val:@(Stats.TasaOcupacion)" role="img"
                     aria-label="Ocupación proyectada @(Stats.TasaOcupacion) por ciento">
                    @* El arco se dibuja por CSS (@@property --val); el número cuenta hasta el % por count-up. *@
                    <span class="gauge-num" data-countup="@Stats.TasaOcupacion" data-countup-decimals="0">@(Stats.TasaOcupacion)%</span>
                </div>
                <span class="gauge-label">Ocupación proyectada</span>
            </div>

            <!-- Métricas de apoyo -->
            <div class="metric-stack">
                <div class="metric-mini">
                    <span class="metric-mini-icon metric-mini-icon--warning"><i class="fas fa-clock"></i></span>
                    <div class="metric-mini-body">
                        <div class="metric-mini-value" data-countup="@ReservasPendientes">@ReservasPendientes</div>
                        <div class="metric-mini-label">Reservas pendientes</div>
                    </div>
                </div>
                <div class="metric-mini">
                    <span class="metric-mini-icon metric-mini-icon--info"><i class="fas fa-house"></i></span>
                    <div class="metric-mini-body">
                        <div class="metric-mini-value" data-countup="@AlojamientosActivos">@AlojamientosActivos</div>
                        <div class="metric-mini-label">Alojamientos activos</div>
                    </div>
                </div>
                <div class="metric-mini">
                    <span class="metric-mini-icon"><i class="fas fa-star"></i></span>
                    <div class="metric-mini-body">
                        <div class="metric-mini-value" data-countup="@Stats.RatingPromedio.ToString(CultureInfo.InvariantCulture)" data-countup-decimals="1">@Stats.RatingPromedio.ToString("F1")</div>
                        <div class="metric-mini-label">Calificación promedio</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LAYOUT PRINCIPAL -->
        <div class="host-grid">

            <!-- COLUMNA PRINCIPAL -->
            <div style="display: flex; flex-direction: column; gap: 24px;">

                <!-- GANANCIAS -->
                <div class="host-panel">
                    <div class="host-panel-head">
                        <h2 class="host-panel-title"><i class="fas fa-chart-pie"></i> Rentabilidad y ganancias</h2>
                        <div class="flex items-center gap-10" style="flex-wrap: wrap;">
                            <input type="text" id="host-filtro-inicio" class="host-flatpickr" placeholder="dd/mm/aaaa"
                                   value="@Fmt(FiltroInicio)" @onchange="OnInicioChanged" autocomplete="off"
                                   style="max-width: 140px; height: 38px; font-size: 13px;" />
                            <input type="text" id="host-filtro-fin" class="host-flatpickr" placeholder="dd/mm/aaaa"
                                   value="@Fmt(FiltroFin)" @onchange="OnFinChanged" autocomplete="off"
                                   style="max-width: 140px; height: 38px; font-size: 13px;" />
                            <button class="btn btn-small btn-secondary" @onclick="RecalcularGananciasAnfitrion">
                                <i class="fas fa-filter"></i> Filtrar
                            </button>
                            @* RF23 · Estado de cuenta del anfitrión (PDF, JasperReports) con sus pagos y neto a cobrar. *@
                            <a class="btn btn-small btn-primary"
                               href="@($"http://localhost:8080/BunkiBackend/webresources/ReporteRS/estado-anfitrion/pdf?anfitrion={AppState.UsuarioActual?.Id ?? 0}")"
                               target="_blank" rel="noopener">
                                <i class="fas fa-file-pdf"></i> Estado de cuenta
                            </a>
                        </div>
                    </div>

                    <div class="host-earnings">
                        @* data-countup: los montos del desglose cuentan de 0 a su valor al cargar. *@
                        <div class="earn-card">
                            <span class="earn-label">Ingresos brutos</span>
                            <span class="earn-value" data-countup="@IngresosBrutosReales.ToString(CultureInfo.InvariantCulture)">@AppState.FormatearPrecio(IngresosBrutosReales)</span>
                        </div>
                        <div class="earn-card earn-card--fee">
                            <span class="earn-label">Comisión Bunki (10%)</span>
                            <span class="earn-value" data-countup="@ComisionReal.ToString(CultureInfo.InvariantCulture)">- @AppState.FormatearPrecio(ComisionReal)</span>
                        </div>
                        <div class="earn-card earn-card--net">
                            <span class="earn-label">Ganancia neta</span>
                            <span class="earn-value" data-countup="@GananciasReales.ToString(CultureInfo.InvariantCulture)">@AppState.FormatearPrecio(GananciasReales)</span>
                        </div>
                    </div>
                </div>

                <!-- RESERVAS RECIENTES -->
                <div class="host-panel">
                    <div class="host-panel-head">
                        <h2 class="host-panel-title"><i class="fas fa-calendar-check"></i> Reservas recientes</h2>
                        <a href="/reservas-recibidas" class="host-panel-link">Ver todas <i class="fas fa-arrow-right"></i></a>
                    </div>

                    <div class="host-recent-reservations">
                        @foreach (var r in ReservasRecientes)
                        {
                            <div class="host-recent-booking">
                                <div class="host-recent-guest">
                                    <div class="avatar host-recent-avatar">@r.Iniciales</div>
                                    <div>
                                        <div class="host-recent-name">@r.Huesped</div>
                                        <div class="host-recent-sub">
                                            <i class="fas fa-house"></i>
                                            @r.Alojamiento
                                        </div>
                                    </div>
                                </div>

                                <div class="host-recent-date">
                                    <span class="host-recent-label">Fechas</span>
                                    <strong><i class="fas fa-calendar-day"></i> @r.Fechas</strong>
                                </div>

                                <div class="host-recent-total">
                                    <span class="host-recent-label">Total</span>
                                    <strong class="price">@r.Total</strong>
                                </div>

                                <div class="host-recent-state">
                                    <StatusBadge Estado="@r.Estado" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- COLUMNA LATERAL -->
            <div style="display: flex; flex-direction: column; gap: 24px;">

                <!-- ACCIONES RÁPIDAS -->
                <div class="host-panel">
                    <div class="host-panel-head">
                        <h2 class="host-panel-title"><i class="fas fa-bolt"></i> Acciones rápidas</h2>
                    </div>
                    <div class="host-actions">
                        <a href="/crear-alojamiento" class="host-action">
                            <span class="host-action-icon"><i class="fas fa-plus"></i></span>
                            <span class="host-action-text"><strong>Crear alojamiento</strong><span>Publica un espacio</span></span>
                            <i class="fas fa-chevron-right host-action-arrow"></i>
                        </a>
                        <a href="/mis-alojamientos" class="host-action">
                            <span class="host-action-icon"><i class="fas fa-home"></i></span>
                            <span class="host-action-text"><strong>Mis alojamientos</strong><span>Gestiona tus propiedades</span></span>
                            <i class="fas fa-chevron-right host-action-arrow"></i>
                        </a>
                        <a href="/reservas-recibidas" class="host-action">
                            <span class="host-action-icon"><i class="fas fa-inbox"></i></span>
                            <span class="host-action-text"><strong>Revisar reservas</strong><span>@ReservasPendientes pendientes</span></span>
                            <i class="fas fa-chevron-right host-action-arrow"></i>
                        </a>
                        <a href="/mensajes" class="host-action">
                            <span class="host-action-icon"><i class="fas fa-comments"></i></span>
                            <span class="host-action-text"><strong>Mensajes</strong><span>Habla con tus huéspedes</span></span>
                            <i class="fas fa-chevron-right host-action-arrow"></i>
                        </a>
                    </div>
                </div>

                <!-- ACTIVIDAD RECIENTE -->
                <div class="host-panel">
                    <div class="host-panel-head">
                        <h2 class="host-panel-title"><i class="fas fa-list-check"></i> Tareas y actividad</h2>
                    </div>
                    <div class="host-feed">
                        @foreach (var a in Actividad)
                        {
                            <div class="host-feed-item">
                                <div class="host-feed-icon host-feed-icon--@a.Tono"><i class="fas @a.Icono"></i></div>
                                <div class="host-feed-body">
                                    <p>@((MarkupString)a.Texto)</p>
                                    <div class="host-feed-time">@a.Tiempo</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Alojamiento> Alojamientos = new();
    private (int ReservasActivas, decimal IngresosEsteMes, double RatingPromedio, int TasaOcupacion) Stats;

    // El count-up solo debe dispararse cuando los datos REALES ya están en el DOM. Con el prerender/
    // hidratación de Blazor Server, el PRIMER render ocurre con los valores aún en 0 (OnInitializedAsync
    // todavía await-eando los providers); si el count-up corre ahí, "congela" esos ceros encima del dato
    // real que llega después. Estas banderas lo retrasan hasta que los datos están cargados, y a una sola vez.
    private bool _datosCargados = false;
    private bool _countUpHecho = false;

    // Filtro de período para la ocupación PROYECTADA (en días, ventana hacia adelante desde hoy). 30 por defecto.
    private int _diasPeriodo = 30;
    // Reservas del anfitrión ya cargadas: las guardamos para recalcular al cambiar de período sin re-pedir al backend.
    private List<Reserva> _reservasAnfitrion = new();

    // Pagos REALES recibidos por el anfitrión (de las reservas pagadas de SUS alojamientos),
    // vía GET PagoRS/anfitrion/{id}. Alimentan las ganancias reales (ver más abajo).
    private List<ResultadoPago> _pagos = new();
    private int CantidadPagos => _pagos.Count;

    private string NombreAnfitrion => AppState.UsuarioActual?.Nombre ?? "anfitrión";
    private int AlojamientosActivos => Alojamientos.Count(a => a.EstadoPublicacion == "Activo");
    private int ReservasPendientes => _reservasAnfitrion.Count(r => r.Estado == "Pendiente");

    private record ReservaResumen(string Iniciales, string Huesped, string Alojamiento, string Fechas, string Total, string Estado);
    private record Evento(string Icono, string Tono, string Texto, string Tiempo);
    private record Punto(string Mes, decimal Valor);

    // Todas REALES: se construyen en ConstruirResumenes() a partir de _reservasAnfitrion.
    private List<Punto> Ingresos6m = new();
    private List<ReservaResumen> ReservasRecientes = new();
    private List<Evento> Actividad = new();

    private int BarH(decimal valor)
    {
        decimal max = Ingresos6m.Count > 0 ? Ingresos6m.Max(p => p.Valor) : 0m;
        if (max <= 0) return 8;                  // sin ingresos: barra mínima
        return (int)(valor / max * 60m) + 8;     // alto en px (8–68)
    }

    // Construye, con datos REALES, las tres colecciones que antes eran mock.
    private void ConstruirResumenes()
    {
        // Reservas recientes (las 4 más recientes por fecha de entrada).
        ReservasRecientes = _reservasAnfitrion
            .OrderByDescending(r => r.FechaEntrada)
            .Take(4)
            .Select(r => new ReservaResumen(
                Iniciales(r.HuespedNombre),
                string.IsNullOrWhiteSpace(r.HuespedNombre) ? "Huésped" : r.HuespedNombre,
                r.AlojamientoNombre,
                r.FechasTexto,
                AppState.FormatearPrecio(r.Total),
                r.Estado))
            .ToList();

        // Ingresos de los últimos 6 meses (cobrados: Confirmada/Completada), por mes de entrada.
        var hoy = DateTime.Today;
        var es = new CultureInfo("es");
        var serie = new List<Punto>();
        for (int i = 5; i >= 0; i--)
        {
            var mes = hoy.AddMonths(-i);
            decimal val = _reservasAnfitrion
                .Where(r => (r.Estado == "Confirmada" || r.Estado == "Completada")
                            && r.FechaEntrada.Month == mes.Month && r.FechaEntrada.Year == mes.Year)
                .Sum(r => r.Total);
            var etiqueta = es.TextInfo.ToTitleCase(mes.ToString("MMM", es)).Replace(".", "");
            serie.Add(new Punto(etiqueta, val));
        }
        Ingresos6m = serie;

        // Feed de actividad: estado de las reservas más recientes (evento real por reserva).
        Actividad = _reservasAnfitrion
            .OrderByDescending(r => r.FechaEntrada)
            .Take(5)
            .Select(EventoDeReserva)
            .ToList();
    }

    private Evento EventoDeReserva(Reserva r)
    {
        var (icono, tono, verbo) = r.Estado switch
        {
            "Pendiente"  => ("fa-clock", "warning", "Reserva pendiente de confirmar en"),
            "Confirmada" => ("fa-calendar-check", "success", "Reserva confirmada en"),
            "Completada" => ("fa-circle-check", "info", "Estadía completada en"),
            "Cancelada"  => ("fa-ban", "warning", "Reserva cancelada en"),
            _            => ("fa-calendar", "info", "Reserva en")
        };
        return new Evento(icono, tono, $"{verbo} <strong>{r.AlojamientoNombre}</strong>", TiempoRel(r.FechaEntrada));
    }

    private static string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "HU";
        var p = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 1) return p[0].Substring(0, Math.Min(2, p[0].Length)).ToUpperInvariant();
        return $"{p[0][0]}{p[1][0]}".ToUpperInvariant();
    }

    private static string TiempoRel(DateTime f)
    {
        var d = (f.Date - DateTime.Today).Days;
        if (d == 0) return "hoy";
        if (d > 0) return d == 1 ? "mañana" : $"en {d} días";
        var dd = -d;
        if (dd == 1) return "ayer";
        if (dd < 7) return $"hace {dd} días";
        if (dd < 30) return $"hace {dd / 7} sem";
        return f.ToString("dd MMM");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.EstaAutenticado) { Navigation.NavigateTo("/login"); return; }

        AppState.OnChange += OnMonedaChanged;
        // Fuente: REST con fallback automático a mock (provider).
        var anfitrionId = AppState.UsuarioActual?.Id ?? 0;
        Alojamientos = await AlojamientoProvider.ListarPorAnfitrionAsync(anfitrionId);
        _reservasAnfitrion = await ReservaProvider.ListarPorAnfitrionAsync(anfitrionId);
        // Stats arranca en cero; RecalcularOcupacion() rellena ocupación y rating REALES.
        // (ReservasActivas/IngresosEsteMes del tuple ya no se renderizan: las métricas visibles
        // salen de _reservasAnfitrion y de _pagos.)
        Stats = (0, 0m, 0, 0);

        // Ocupación + rating reales para el período inicial (30 días).
        RecalcularOcupacion();

        // Construye, con datos REALES, el mini-chart de ingresos, las reservas recientes y el feed.
        ConstruirResumenes();

        // Ganancias REALES: pagos de las reservas pagadas de sus alojamientos (sustituye el mock de ingresos).
        if (AppState.UsuarioActual != null)
        {
            _pagos = await PagoProvider.ListarPorAnfitrionAsync(AppState.UsuarioActual.Id);
        }

        // Datos ya cargados: a partir del re-render que dispara esto, el count-up puede leer valores reales.
        _datosCargados = true;
    }

    public void Dispose() => AppState.OnChange -= OnMonedaChanged;
    private void OnMonedaChanged() => InvokeAsync(StateHasChanged);

    // Cambia el período de la ocupación y recalcula con los datos YA cargados (sin re-pedir al backend).
    private void CambiarPeriodo(int dias)
    {
        _diasPeriodo = dias;
        RecalcularOcupacion();
    }

    // Recalcula la ocupación para la ventana [hoy, hoy + _diasPeriodo) y actualiza Stats.TasaOcupacion.
    // Reconstruye Stats con ocupación Y rating REALES en la MISMA línea, para que ninguno pise al otro.
    private void RecalcularOcupacion()
    {
        int ocup = CalcularOcupacionPeriodo(Alojamientos.Count, _reservasAnfitrion, _diasPeriodo);
        double ratingReal = CalcularRatingAnfitrion(Alojamientos);
        Stats = (Stats.ReservasActivas, Stats.IngresosEsteMes, ratingReal, ocup);
    }

    // Rating REAL del anfitrión (RF19): promedio de las calificaciones de sus alojamientos que ya tienen
    // reseñas. Antes era mock (4.8 fijo). Cada alojamiento trae su Rating (AVG de sus reseñas) del backend.
    // Se excluyen los que aún no tienen reseñas (Rating 0) para no hundir el promedio con ceros.
    // 0 si ninguno tiene reseñas todavía. Así coincide con el rating real que ya muestra MisResenas.
    private double CalcularRatingAnfitrion(List<Alojamiento> alojamientos)
    {
        var conResenas = alojamientos.Where(a => a.Rating > 0).ToList();
        if (conResenas.Count == 0) return 0;
        return Math.Round(conResenas.Average(a => a.Rating), 1);
    }

    // Ocupación PROYECTADA (RF21): noches reservadas / noches disponibles en los próximos 'dias' días.
    // Miramos HACIA ADELANTE porque la ocupación futura es la métrica accionable para el anfitrión
    // (estilo Airbnb/hotelería). Noches disponibles = nº alojamientos * dias. Noches reservadas =
    // intersección de cada reserva activa (Confirmada/Completada, las que de verdad ocupan) con la
    // ventana [hoy, hoy+dias): una reserva puede solaparse parcialmente, así que solo cuentan las
    // noches que caen dentro de la ventana.
    private int CalcularOcupacionPeriodo(int numAlojamientos, List<Reserva> reservas, int dias)
    {
        if (numAlojamientos <= 0 || dias <= 0) return 0;
        var inicio = DateTime.Today;
        var fin = inicio.AddDays(dias);            // exclusivo
        int nochesDisponibles = numAlojamientos * dias;
        if (nochesDisponibles <= 0) return 0;

        int nochesReservadas = 0;
        foreach (var r in reservas)
        {
            if (r.Estado != "Confirmada" && r.Estado != "Completada") continue;
            var ini = r.FechaEntrada.Date > inicio ? r.FechaEntrada.Date : inicio;
            var f   = r.FechaSalida.Date  < fin    ? r.FechaSalida.Date  : fin;
            int noches = (f - ini).Days;
            if (noches > 0) nochesReservadas += noches;
        }
        // Tope al 100% por robustez (si los datos se solaparan raro).
        int pct = (int)Math.Round(100.0 * nochesReservadas / nochesDisponibles);
        return Math.Min(pct, 100);
    }

    // (El mapeo estado→clase del badge ahora vive en <StatusBadge>, fuente única de verdad.)

    // Calendario dark unificado (mismo Flatpickr que el resto de Bunki).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("bunkiDatePicker.initHostDate", "#host-filtro-inicio");
            await JS.InvokeVoidAsync("bunkiDatePicker.initHostDate", "#host-filtro-fin");
        }

        // Count-up de los KPIs (ingresos, ocupación, rating, desglose): SOLO cuando los datos reales ya
        // están en el DOM (no en el primer render con ceros) y una única vez. Así anima desde el valor real
        // y nunca deja 0; si el JS no corriera, el dato real ya está pintado por Blazor. Respeta reduced-motion.
        if (_datosCargados && !_countUpHecho)
        {
            _countUpHecho = true;
            await JS.InvokeVoidAsync("bunkiCountUp.init", "[data-countup]");
        }
    }

    private string Fmt(DateTime fecha) => fecha.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);

    private DateTime ParseFecha(string? value, DateTime fallback)
    {
        if (!string.IsNullOrWhiteSpace(value) &&
            DateTime.TryParseExact(value, "dd/MM/yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var f))
            return f;
        return fallback;
    }

    private void OnInicioChanged(ChangeEventArgs e) => FiltroInicio = ParseFecha(e.Value?.ToString(), FiltroInicio);
    private void OnFinChanged(ChangeEventArgs e) => FiltroFin = ParseFecha(e.Value?.ToString(), FiltroFin);

    // Filtro de fechas (visual): el endpoint del backend devuelve TODOS los pagos del anfitrión
    // sin rango, así que el filtro por fecha aún no está cableado. Se conserva la UI.
    private DateTime FiltroInicio = DateTime.Today.AddDays(-30);
    private DateTime FiltroFin = DateTime.Today;

    // Ganancias REALES (de _pagos, ver arriba). Reemplazan los montos mock (8500/11400):
    //   IngresosBrutosReales = total cobrado al huésped (suma de montoBruto)
    //   ComisionReal         = lo que retiene Bunki (bruto - neto)
    //   GananciasReales      = lo que recibe el anfitrión tras la comisión del 10% (suma de montoNeto)
    private decimal IngresosBrutosReales => (decimal)_pagos.Sum(p => p.MontoBruto);
    private decimal GananciasReales => (decimal)_pagos.Sum(p => p.MontoNeto);
    private decimal ComisionReal => IngresosBrutosReales - GananciasReales;

    // El filtro por fecha no está cableado al backend; solo refresca la vista (sin números falsos).
    private void RecalcularGananciasAnfitrion() => StateHasChanged();
