    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        MensajeImagen = "";
        // Varios archivos a la vez (multiple). Validamos y subimos cada uno; los inválidos se omiten.
        var archivos = e.GetMultipleFiles(MaxImagenes);
        if (archivos.Count == 0) return;

        foreach (var file in archivos)
        {
            if (_imagenes.Count >= MaxImagenes)
            {
                MensajeImagen = $"Máximo {MaxImagenes} fotos por alojamiento.";
                break;
            }
            // Validar por content-type O extensión (algunos navegadores mandan el tipo vacío).
            var ext = System.IO.Path.GetExtension(file.Name);
            var extOk = new[] { ".jpg", ".jpeg", ".png", ".webp", ".gif" }.Contains((ext ?? "").ToLowerInvariant());
            if (!file.ContentType.StartsWith("image/") && !extOk)
            {
                MensajeImagen = $"\"{file.Name}\" no es una imagen válida (se omitió).";
                continue;
            }
            if (file.Size > 5 * 1024 * 1024)
            {
                MensajeImagen = $"\"{file.Name}\" pasa de 5 MB (se omitió).";
                continue;
            }
            try
            {
                // WebRootPath puede venir null en algunos despliegues; caemos a ContentRoot/wwwroot.
                var baseDir = !string.IsNullOrWhiteSpace(Env.WebRootPath)
                    ? Env.WebRootPath
                    : System.IO.Path.Combine(Env.ContentRootPath, "wwwroot");
                var uploadsDir = System.IO.Path.Combine(baseDir, "uploads");
                System.IO.Directory.CreateDirectory(uploadsDir);
                var nombre = $"{Guid.NewGuid():N}{(string.IsNullOrEmpty(ext) ? ".jpg" : ext)}";
                var ruta = System.IO.Path.Combine(uploadsDir, nombre);
                await using (var fs = new System.IO.FileStream(ruta, System.IO.FileMode.Create))
                {
                    await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(fs);
                }
                _imagenes.Add($"/uploads/{nombre}");
            }
            catch (Exception ex)
            {
                // Antes fallaba en silencio (sin try/catch). Mostramos el motivo real (p. ej. permisos
                // de escritura en el servidor) para poder diagnosticar.
                MensajeImagen = "No se pudo subir una imagen: " + ex.Message;
            }
        }
    }

    private void QuitarImagen(int idx)
    {
        if (idx >= 0 && idx < _imagenes.Count) _imagenes.RemoveAt(idx);
    }

    private async Task Publicar()
    {
        MensajeError = "";
        MensajeExito = "";

        // RF02: refuerzo del gate (defensa en profundidad por si el form llegara a renderizarse).
        if (!_verificado)
        {
            MensajeError = "Debes verificar tu identidad antes de publicar.";
            return;
        }

        // Validación mínima (la EditForm ya valida vía DataAnnotations, pero reforzamos aquí
        // antes de enviar al backend para no mandar una publicación incompleta).
        if (string.IsNullOrWhiteSpace(Formulario.Nombre) ||
            string.IsNullOrWhiteSpace(Formulario.Tipo) ||
            string.IsNullOrWhiteSpace(Formulario.Distrito) ||
            Formulario.PrecioNoche <= 0)
        {
            MensajeError = "Completa al menos el nombre, el tipo, el distrito y un precio por noche válido.";
            return;
        }

        Publicando = true;
        try
        {
            // Servicios: el UI guarda las selecciones en ServiciosSeleccionados (claves), así que
            // armamos la lista con los nombres legibles de los servicios marcados.
            var serviciosLista = Servicios
                .Where(s => ServiciosSeleccionados.Contains(s.Key))
                .Select(s => s.Nombre)
                .ToList();

            // Reglas: mismas selecciones (por su nombre legible), ahora SÍ se persisten en el backend.
            var reglasLista = Reglas
                .Where(r => ReglasSeleccionadas.Contains(r.Key))
                .Select(r => r.Nombre)
                .ToList();

            var alojamiento = new Alojamiento
            {
                Nombre = Formulario.Nombre,
                Tipo = Formulario.Tipo,                 // "Casa" / "Departamento" / "Habitación" (con tilde, como el backend)
                Descripcion = Formulario.Descripcion,
                Ubicacion = string.IsNullOrWhiteSpace(Formulario.Direccion)
                                ? Formulario.Distrito
                                : $"{Formulario.Direccion}, {Formulario.Distrito}",
                Distrito = Formulario.Distrito,
                Provincia = Formulario.Provincia,
                Pais = "Perú",                          // columna 'pais' es NOT NULL en BD; el form no la captura
                PrecioNoche = Formulario.PrecioNoche,
                TarifaLimpieza = Formulario.TarifaLimpieza,
                MaxHuespedes = Formulario.MaxHuespedes,
                Habitaciones = Formulario.Habitaciones,
                Servicios = serviciosLista,
                Reglas = reglasLista,
                AnfitrionId = AppState.UsuarioActual?.Id ?? 0,  // anfitrión = usuario logueado
                Latitud = 0,    // TODO: el formulario no captura coordenadas todavía; quedará sin pin
                Longitud = 0,   //       en el mapa hasta agregar selección de ubicación.
                ImagenUrl = _imagenes.FirstOrDefault() ?? "",  // portada = primera foto
                Imagenes = _imagenes.ToList(),                 // galería completa

                // Atributos específicos por tipo (RF05): se copian del Formulario al objeto que se envía.
                // El backend solo usa los del tipo correspondiente; los demás van con su valor por defecto.
                NumPisos = Formulario.NumPisos,
                ConPatio = Formulario.ConPatio,
                NumCocheras = Formulario.NumCocheras,
                NumHabitacionesCasa = Formulario.NumHabitacionesCasa,
                NumPiso = Formulario.NumPiso,
                NroDepartamento = Formulario.NroDepartamento,
                NroHabitacionesDepartamento = Formulario.NroHabitacionesDepartamento,
                NroHabitacion = Formulario.NroHabitacion,
                TipoCama = Formulario.TipoCama,
                ConBanhoPrivado = Formulario.ConBanhoPrivado
            };

            if (EsEdicion)
            {
                // Conserva del original lo que el form no edita, para no perderlo en el PUT.
                alojamiento.Id = Id!.Value;
                alojamiento.AnfitrionId = _original?.AnfitrionId ?? alojamiento.AnfitrionId;  // conserva el dueño
                // Las fotos vienen de la galería editada (_imagenes, precargada al abrir). Solo si quedó
                // vacía (el anfitrión no tocó/borró todo) conservamos las del original para no perderlas.
                if (alojamiento.Imagenes.Count == 0)
                {
                    alojamiento.Imagenes = _original?.Imagenes ?? new();
                    alojamiento.ImagenUrl = _original?.ImagenUrl ?? "";
                }
                alojamiento.EstadoPublicacion = _original?.EstadoPublicacion ?? "Activo";      // no lo despublica
                await AlojamientoProvider.ActualizarAsync(alojamiento);   // PUT
            }
            else
            {
                await AlojamientoProvider.RegistrarAsync(alojamiento);    // POST
            }

            MensajeExito = EsEdicion
                ? "Cambios guardados correctamente."
                : "¡Alojamiento publicado exitosamente! Está en revisión.";
            await Task.Delay(1500);
            Navigation.NavigateTo("/panel-anfitrion");
        }
        catch (Exception)
        {
            MensajeError = "No se pudo publicar el alojamiento. Revisa los datos e intenta de nuevo.";
        }
        finally
        {
            Publicando = false;
        }
    }

