    // Galería de fotos subidas (rutas servidas desde wwwroot/uploads). La primera es la portada.
    private List<string> _imagenes = new();
    private string MensajeImagen = "";
    private const int MaxImagenes = 8;

    private record ServicioInfo(string Key, string Nombre, string Icono);

