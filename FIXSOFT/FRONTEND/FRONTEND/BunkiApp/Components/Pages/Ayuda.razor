@page "/perfil/ayuda"
@page "/ayuda"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject BunkiApp.Services.IncidenciaServiceRest Incidencia
@inject BunkiApp.Models.AppState AppState

<PageTitle>Bunki - Centro de Ayuda</PageTitle>

<div class="section">
    <div class="container" style="max-width: 700px;">
        <div class="card" style="padding: 35px;">
            <div style="text-align: center; margin-bottom: 35px;">
                <div class="avatar avatar-large" style="margin: 0 auto 20px; background: var(--primary); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-headset" style="color: white; font-size: 32px;"></i>
                </div>
                <h2 style="color: var(--text); margin-bottom: 10px;">Centro de Ayuda</h2>
                <p class="card-text">¿En qué podemos ayudarte hoy? Encuentra respuestas rápidas a las dudas más comunes.</p>
            </div>

            <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 30px;">
                @for (int i = 0; i < PreguntasFrecuentes.Count; i++)
                {
                    var index = i; // Guardamos el índice actual para el evento de clic
                    bool estaAbierta = PreguntaActiva == index;

                    <div style="border: 1px solid var(--border); border-radius: 8px; overflow: hidden; transition: all 0.3s ease;">
                        <div style="padding: 15px 20px; background: @(estaAbierta ? "rgba(31, 107, 94, 0.05)" : "transparent"); cursor: pointer; display: flex; justify-content: space-between; align-items: center;"
                             @onclick="() => TogglePregunta(index)">
                            <strong style="font-size: 16px; color: var(--text);">
                                <i class="fas fa-question-circle" style="color: var(--primary); margin-right: 10px;"></i>
                                @PreguntasFrecuentes[index].Pregunta
                            </strong>
                            <i class="fas @(estaAbierta ? "fa-chevron-up" : "fa-chevron-down")" style="color: var(--text-light); transition: 0.3s;"></i>
                        </div>

                        @if (estaAbierta)
                        {
                            <div style="padding: 0 20px 20px 46px; font-size: 14px; color: var(--text-light); line-height: 1.6;">
                                @PreguntasFrecuentes[index].Respuesta
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- REPORTAR UN PROBLEMA (incidencia real) -->
            <div style="border-top: 1px solid var(--border); margin-top: 10px; padding-top: 28px; margin-bottom: 28px;">
                <h3 style="color: var(--text); margin-bottom: 6px;">
                    <i class="fas fa-life-ring" style="color: var(--primary); margin-right: 8px;"></i>¿No encontraste lo que buscabas?
                </h3>
                <p class="card-text" style="margin-bottom: 18px;">Reporta un problema y nuestro equipo de soporte lo revisará.</p>

                @if (!AppState.EstaAutenticado)
                {
                    <p class="card-text">
                        <a href="/login">Inicia sesión</a> para reportar un problema.
                    </p>
                }
                else if (_enviado)
                {
                    <div style="background: var(--success-tint, rgba(31,107,94,.08)); color: var(--success, #1F6B5E); border-radius: 10px; padding: 16px 18px;">
                        <i class="fas fa-circle-check"></i> Tu reporte fue enviado. Nuestro equipo te contactará pronto.
                        <button class="btn btn-small btn-outline" style="margin-top: 12px;" @onclick="Reset">Reportar otro problema</button>
                    </div>
                }
                else
                {
                    <div class="form-group" style="margin-bottom: 14px;">
                        <label>Asunto</label>
                        <input type="text" class="form-control" maxlength="150" placeholder="Ej. No puedo confirmar mi reserva"
                               @bind="_asunto" @bind:event="oninput" />
                    </div>
                    <div class="form-group" style="margin-bottom: 14px;">
                        <label>Prioridad</label>
                        <SelectMenu @bind-Value="_prioridad" Options="_prioridades" />
                    </div>
                    <div class="form-group" style="margin-bottom: 14px;">
                        <label>Descripción (opcional)</label>
                        <textarea rows="4" maxlength="1000" class="form-control" placeholder="Cuéntanos qué ocurrió, con el mayor detalle posible..."
                                  @bind="_descripcion" @bind:event="oninput"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <p style="color: var(--danger); margin-bottom: 12px;">@_error</p>
                    }

                    <button class="btn btn-primary" style="width: 100%;"
                            disabled="@(_enviando || string.IsNullOrWhiteSpace(_asunto))"
                            @onclick="EnviarIncidencia">
                        <i class="fas @(_enviando ? "fa-spinner fa-spin" : "fa-paper-plane")"></i>
                        @(_enviando ? "Enviando..." : "Enviar reporte")
                    </button>
                }
            </div>

            <div style="display: flex; justify-content: center;">
                <button class="btn btn-outline" style="width: 100%; max-width: 300px;" @onclick='() => Navigation.NavigateTo("/perfil")'>
                    <i class="fas fa-arrow-left" style="margin-right: 8px;"></i> Volver al Perfil
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    // --- Reportar un problema (incidencia real) ---
    private string _asunto = "";
    private string _prioridad = "MEDIA";
    private string _descripcion = "";
    private string _error = "";
    private bool _enviando;
    private bool _enviado;
    private readonly List<SelectMenu.Opcion> _prioridades = new()
    {
        new("ALTA", "Alta"),
        new("MEDIA", "Media"),
        new("BAJA", "Baja")
    };

    private async Task EnviarIncidencia()
    {
        var usuarioId = AppState.UsuarioActual?.Id ?? 0;
        if (usuarioId <= 0) { _error = "Debes iniciar sesión."; return; }
        if (string.IsNullOrWhiteSpace(_asunto)) return;

        _enviando = true;
        _error = "";
        try
        {
            await Incidencia.AgregarAsync(usuarioId, _asunto.Trim(),
                string.IsNullOrWhiteSpace(_descripcion) ? null : _descripcion.Trim(), _prioridad);
            _enviado = true;
        }
        catch (Exception)
        {
            _error = "No se pudo enviar el reporte. Inténtalo de nuevo.";
        }
        finally
        {
            _enviando = false;
        }
    }

    private void Reset()
    {
        _enviado = false;
        _asunto = "";
        _descripcion = "";
        _prioridad = "MEDIA";
        _error = "";
    }

    // Variable para saber cuál pregunta está abierta. Inicia en 0 (la primera abierta) o en -1 (todas cerradas).
    private int PreguntaActiva = 0;

    private void TogglePregunta(int index)
    {
        // Si hace clic en la que ya está abierta, la cierra. Si no, abre la nueva.
        if (PreguntaActiva == index)
            PreguntaActiva = -1;
        else
            PreguntaActiva = index;
    }

    // Lista de preguntas y respuestas al estilo Airbnb
    private List<(string Pregunta, string Respuesta)> PreguntasFrecuentes = new()
    {
        ("¿Cómo cancelo una reserva y qué reembolsos aplican?", "Ve a 'Mis Reservas', selecciona tu próximo viaje y haz clic en 'Cancelar'. El reembolso dependerá de la política de cancelación elegida por el anfitrión (Flexible, Moderada o Estricta)."),

("¿Cuándo se me cobrará la reserva?", "Te cobraremos el importe total en el momento en que el anfitrión confirme la reserva. Si envías una 'Solicitud de reserva', solo retendremos el dinero hasta que sea aceptada."),

("¿Cómo me comunico con el anfitrión?", "Usa el botón 'Mensajes' en el menú principal o entra a los detalles de tu reserva para chatear directamente. Por tu seguridad, mantén siempre la comunicación dentro de la plataforma Bunki."),

("¿Qué pasa si el anfitrión cancela mi reserva?", "Si tu anfitrión cancela, te ofreceremos un reembolso total de forma automática. También te contactaremos para ayudarte a encontrar un alojamiento similar si tu viaje está cerca."),

("¿Cómo me convierto en anfitrión en Bunki?", "Ve a 'Mi Perfil' y entra a tus 'Métodos de Pago' para registrar tu cuenta bancaria (CCI). Luego ve al Panel de Anfitrión y publica tus espacios de forma gratuita.")
    };
}