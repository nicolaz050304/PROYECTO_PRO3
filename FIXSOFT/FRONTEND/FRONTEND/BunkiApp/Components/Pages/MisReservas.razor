@page "/mis-reservas"
@rendermode InteractiveServer
@inject DataService Data
@inject ReservaProvider ReservaProvider
@inject ResenaProvider ResenaProvider
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState
<PageTitle>Bunki - Mis Reservas</PageTitle>

<div class="section">
    <div class="container">
        <header class="page-head">
            <span class="eyebrow">Tu actividad</span>
            <h1 class="page-head-title">Mis Reservas</h1>
            <p class="page-head-sub">Gestiona tus próximas estadías, revisa tu historial y mantén todo bajo control.</p>
        </header>

        @if (!string.IsNullOrEmpty(MensajeAccion))
        {
            <AlertMessage Tipo="success" Mensaje="@MensajeAccion" />
        }
        @if (!string.IsNullOrEmpty(MensajeError))
        {
            <AlertMessage Tipo="danger" Mensaje="@MensajeError" />
        }

        <!-- TABS -->
        <div class="tabs">
            @foreach (var tab in Tabs)
            {
                <button class="tab-btn @(TabActiva == tab ? "active" : "")"
                        @onclick="() => CambiarTab(tab)">
                    @tab
                    <span class="tab-count">@ContarReservasPorTab(tab)</span>
                </button>
            }
        </div>

        <!-- CONTENIDO -->
        @if (Cargando)
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-spinner fa-spin"></i></div>
                <h2>Cargando...</h2>
                <p>Un momento, estamos obteniendo la información.</p>
            </div>
        }
        else if (TabActiva == "Próximas")
        {
            @if (!Proximas.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-calendar-day"></i></div>
                    <h3>No tienes reservas próximas</h3>
                    <p>Cuando reserves un alojamiento, aparecerá aquí con sus fechas y detalles.</p>
                    <div class="empty-state-actions">
                        <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/explorar")'>Explorar alojamientos</button>
                    </div>
                </div>
            }
            else
            {
                @foreach (var r in Proximas)
                {
                    <ReservaCard Reserva="r"
                                 OnCancelarReserva="CancelarReserva"
                                 OnReprogramarCallback="AbrirReprogramar"
                                 OnDejarResenaCallback="DejarResena" />
                }
            }
        }
        else if (TabActiva == "Pasadas")
        {
            @if (!Pasadas.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-clock-rotate-left"></i></div>
                    <h3>Aún no tienes reservas pasadas</h3>
                    <p>Tu historial de estancias completadas se mostrará aquí.</p>
                </div>
            }
            else
            {
                @foreach (var r in Pasadas)
                {
                    <ReservaCard Reserva="r"
                                 OnCancelarReserva="CancelarReserva"
                                 OnDejarResenaCallback="DejarResena" />
                }
            }
        }
        else
        {
            @if (!Canceladas.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-circle-check"></i></div>
                    <h3>No tienes reservas canceladas</h3>
                    <p>Las reservas que canceles quedarán registradas aquí.</p>
                </div>
            }
            else
            {
                @foreach (var r in Canceladas)
                {
                    <ReservaCard Reserva="r" />
                }
            }
        }
    </div>
</div>

@if (MostrarModalResena && ReservaParaResenar is not null)
{
    <div class="modal-overlay" @onclick="CerrarModalResena">
        <div class="modal-panel" style="max-width: 480px; text-align: left;" @onclick:stopPropagation="true">
            <div class="flex flex-between" style="margin-bottom: 6px;">
                <h2 style="margin: 0;">Reseñar tu estadía</h2>
                <button @onclick="CerrarModalResena" aria-label="Cerrar"
                        style="background: none; border: none; cursor: pointer; font-size: 20px; color: var(--ink-faint);">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
            <p class="card-text" style="margin-bottom: 20px;">
                @ReservaParaResenar.AlojamientoNombre
            </p>

            <div class="form-group">
                <label>Tu calificación</label>
                <div class="rating" style="font-size: 28px; gap: 4px;">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var estrella = i;
                        <span class="star"
                              style="cursor: pointer;"
                              @onclick="() => EstrellasSeleccionadas = estrella">
                            @(estrella <= EstrellasSeleccionadas ? "★" : "☆")
                        </span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label for="comentarioResena">Tu comentario</label>
                <textarea id="comentarioResena"
                          rows="4"
                          maxlength="500"
                          placeholder="Cuéntanos cómo fue tu experiencia (mínimo 10 caracteres)..."
                          @bind="ComentarioResena"
                          @bind:event="oninput"></textarea>
                <p class="field-help">
                    @(ComentarioResena?.Trim().Length ?? 0) / 10 caracteres mínimos
                </p>
            </div>

            @* RF19: reseña OPCIONAL al anfitrión (la persona), aparte del alojamiento. *@
            <div class="form-group" style="border-top: 1px solid var(--hairline); padding-top: 16px;">
                <label>
                    Califica al anfitrión
                    @if (!string.IsNullOrWhiteSpace(ReservaParaResenar.AnfitrionNombre))
                    {
                        <text> (@ReservaParaResenar.AnfitrionNombre)</text>
                    }
                    <span style="color: var(--ink-faint); font-weight: 400;"> · opcional</span>
                </label>
                <div class="rating" style="font-size: 28px; gap: 4px;">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var estrella = i;
                        <span class="star" style="cursor: pointer;"
                              @onclick="() => EstrellasAnfitrion = (EstrellasAnfitrion == estrella ? 0 : estrella)">
                            @(estrella <= EstrellasAnfitrion ? "★" : "☆")
                        </span>
                    }
                </div>
                @if (EstrellasAnfitrion >= 1)
                {
                    <textarea rows="3" maxlength="500" style="margin-top: 10px;"
                              placeholder="¿Cómo fue el trato del anfitrión? (mínimo 10 caracteres)..."
                              @bind="ComentarioAnfitrion" @bind:event="oninput"></textarea>
                    <p class="field-help">@(ComentarioAnfitrion?.Trim().Length ?? 0) / 10 caracteres mínimos</p>
                }
            </div>

            @if (!string.IsNullOrEmpty(ErrorResena))
            {
                <div style="margin-top: 14px;">
                    <AlertMessage Tipo="danger" Mensaje="@ErrorResena" />
                </div>
            }

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button class="btn btn-outline" style="flex: 1;"
                        @onclick="CerrarModalResena" disabled="@EnviandoResena">
                    Cancelar
                </button>
                <button class="btn btn-primary" style="flex: 1;"
                        @onclick="EnviarResena" disabled="@EnviandoResena">
                    @(EnviandoResena ? "Enviando..." : "Enviar reseña")
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarModalReprogramar && ReservaParaReprogramar is not null)
{
    <div class="modal-overlay" @onclick="CerrarModalReprogramar">
        <div class="modal-panel" style="max-width: 460px; text-align: left;" @onclick:stopPropagation="true">
            <div class="flex flex-between" style="margin-bottom: 6px;">
                <h2 style="margin: 0;">Reprogramar reserva</h2>
                <button @onclick="CerrarModalReprogramar" aria-label="Cerrar"
                        style="background:none; border:none; cursor:pointer; font-size:20px; color:var(--ink-faint);">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
            <p class="card-text" style="margin-bottom: 18px;">
                @ReservaParaReprogramar.AlojamientoNombre · actual: @ReservaParaReprogramar.FechasTexto
            </p>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom: 12px;">
                <div class="form-group" style="margin:0;">
                    <label>Nueva entrada</label>
                    <input type="date" class="form-control" min="@HoyIso" @bind="NuevaEntrada" />
                </div>
                <div class="form-group" style="margin:0;">
                    <label>Nueva salida</label>
                    <input type="date" class="form-control" min="@HoyIso" @bind="NuevaSalida" />
                </div>
            </div>

            @if (NuevasNoches > 0)
            {
                <p class="card-text" style="margin-bottom: 12px;">
                    @NuevasNoches @(NuevasNoches == 1 ? "noche" : "noches") · nuevo total estimado:
                    <strong>@AppState.FormatearPrecio(NuevoTotalEstimado)</strong>
                </p>
            }

            @if (!string.IsNullOrEmpty(ErrorReprogramar))
            {
                <div style="margin-bottom: 14px;"><AlertMessage Tipo="danger" Mensaje="@ErrorReprogramar" /></div>
            }

            <div style="display:flex; gap:12px; margin-top: 8px;">
                <button class="btn btn-outline" style="flex:1;" @onclick="CerrarModalReprogramar" disabled="@Reprogramando">Cancelar</button>
                <button class="btn btn-primary" style="flex:1;" @onclick="ConfirmarReprogramacion" disabled="@Reprogramando">
                    @(Reprogramando ? "Guardando..." : "Reprogramar")
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarModalCancelar && ReservaParaCancelar is not null)
{
    <div class="modal-overlay" @onclick="CerrarModalCancelar">
        <div class="modal-panel" style="max-width: 440px; text-align: left;" @onclick:stopPropagation="true">
            <div class="flex flex-between" style="margin-bottom: 6px;">
                <h2 style="margin: 0;">Cancelar reserva</h2>
                <button @onclick="CerrarModalCancelar" aria-label="Cerrar"
                        style="background:none; border:none; cursor:pointer; font-size:20px; color:var(--ink-faint);">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
            <p class="card-text" style="margin-bottom: 24px;">
                ¿Seguro que deseas cancelar tu reserva en <strong>@ReservaParaCancelar.AlojamientoNombre</strong>?
                Esta acción no se puede deshacer.
            </p>
            <div style="display:flex; gap:12px;">
                <button class="btn btn-outline" style="flex:1;" @onclick="CerrarModalCancelar" disabled="@Cancelando">
                    No, volver
                </button>
                <button class="btn btn-primary" style="flex:1;" @onclick="ConfirmarCancelacion" disabled="@Cancelando">
                    @(Cancelando ? "Cancelando..." : "Sí, cancelar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] Tabs = { "Próximas", "Pasadas", "Canceladas" };
    private string TabActiva = "Próximas";
    private string MensajeAccion = "";
    private string MensajeError = "";

    private bool Cargando = true;
    private List<Reserva> Proximas = new();
    private List<Reserva> Pasadas = new();
    private List<Reserva> Canceladas = new();

    // --- Estado del modal de reseña ---
    private bool MostrarModalResena = false;
    private Reserva? ReservaParaResenar = null;
    private int EstrellasSeleccionadas = 0;
    private string ComentarioResena = "";
    private string ErrorResena = "";
    private bool EnviandoResena = false;
    // RF19: reseña OPCIONAL al anfitrión (persona). Si el huésped no la llena, no se crea.
    private int EstrellasAnfitrion = 0;
    private string ComentarioAnfitrion = "";

    // --- Estado del modal de cancelación ---
    private bool MostrarModalCancelar = false;
    private Reserva? ReservaParaCancelar = null;
    private bool Cancelando = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.EstaAutenticado) { Navigation.NavigateTo("/login"); return; }

        Cargando = true;
        try
        {
            await CargarDatosAsync();
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task CargarDatosAsync()
    {
        // Filtra por el INVITADO logueado (una sola llamada REST: ReservaRS/usuario/{id}).
        // Las pestañas se derivan por Estado en memoria, así no golpeamos 3 veces el endpoint.
        var uid = AppState.UsuarioActual!.Id;
        var mias = await ReservaProvider.ListarPorUsuarioAsync(uid);

        Proximas   = mias.Where(r => r.Estado is "Confirmada" or "Pendiente").ToList();
        Pasadas    = mias.Where(r => r.Estado == "Completada").ToList();
        Canceladas = mias.Where(r => r.Estado == "Cancelada").ToList();
    }

    private void CambiarTab(string tab) => TabActiva = tab;
    
    private int ContarReservasPorTab(string tab) => tab switch
    {
        "Próximas" => Proximas.Count,
        "Pasadas" => Pasadas.Count,
        "Canceladas" => Canceladas.Count,
        _ => 0
    };

    private void CancelarReserva(Reserva reserva)
    {
        // Acción irreversible: abre el modal de confirmación propio (no el confirm nativo).
        ReservaParaCancelar = reserva;
        MostrarModalCancelar = true;
    }

    private async Task ConfirmarCancelacion()
    {
        if (ReservaParaCancelar is null) return;
        Cancelando = true;
        MensajeError = "";
        MensajeAccion = "";
        try
        {
            // Persiste la baja lógica en el backend (DELETE -> estado CANCELADA).
            await ReservaProvider.CancelarAsync(ReservaParaCancelar.Id);
            MensajeAccion = $"Reserva en {ReservaParaCancelar.AlojamientoNombre} cancelada correctamente.";
            MostrarModalCancelar = false;
            ReservaParaCancelar = null;
            // Recarga para que la reserva salga de Próximas y aparezca en Canceladas.
            await CargarDatosAsync();
        }
        catch
        {
            MensajeError = "No se pudo cancelar la reserva. Intenta de nuevo.";
        }
        finally { Cancelando = false; }
    }

    private void CerrarModalCancelar() { MostrarModalCancelar = false; ReservaParaCancelar = null; }

    // --- Reprogramación (RF10): el huésped cambia las fechas de una reserva próxima ---
    private bool MostrarModalReprogramar = false;
    private Reserva? ReservaParaReprogramar = null;
    private DateTime? NuevaEntrada;
    private DateTime? NuevaSalida;
    private bool Reprogramando = false;
    private string ErrorReprogramar = "";

    private string HoyIso => DateTime.Today.ToString("yyyy-MM-dd");
    private int NuevasNoches => (NuevaEntrada.HasValue && NuevaSalida.HasValue)
        ? Math.Max(0, (NuevaSalida.Value.Date - NuevaEntrada.Value.Date).Days) : 0;

    // Nuevo total proporcional a la tarifa por noche ORIGINAL (conserva limpieza/comisión ya cobradas).
    private decimal NuevoTotalEstimado
    {
        get
        {
            if (ReservaParaReprogramar is null || NuevasNoches <= 0) return 0;
            var nochesOrig = Math.Max(1, ReservaParaReprogramar.Noches);
            return Math.Round(ReservaParaReprogramar.Total / nochesOrig * NuevasNoches, 2);
        }
    }

    private void AbrirReprogramar(Reserva r)
    {
        ReservaParaReprogramar = r;
        NuevaEntrada = r.FechaEntrada;
        NuevaSalida = r.FechaSalida;
        ErrorReprogramar = "";
        MostrarModalReprogramar = true;
    }

    private void CerrarModalReprogramar() { MostrarModalReprogramar = false; ReservaParaReprogramar = null; }

    private async Task ConfirmarReprogramacion()
    {
        if (ReservaParaReprogramar is null) return;
        ErrorReprogramar = "";
        if (!NuevaEntrada.HasValue || !NuevaSalida.HasValue) { ErrorReprogramar = "Elige las dos fechas."; return; }
        if (NuevaEntrada.Value.Date < DateTime.Today) { ErrorReprogramar = "La entrada no puede ser en el pasado."; return; }
        if (NuevasNoches <= 0) { ErrorReprogramar = "La salida debe ser posterior a la entrada."; return; }

        Reprogramando = true;
        try
        {
            // Disponibilidad (RF11): las nuevas fechas no deben chocar con otras reservas/bloqueos del
            // alojamiento, EXCLUYENDO el rango actual de esta misma reserva.
            var e = NuevaEntrada.Value.Date;
            var s = NuevaSalida.Value.Date;
            var ocupadas = await ReservaProvider.ObtenerFechasOcupadasAsync(ReservaParaReprogramar.AlojamientoId);
            foreach (var oc in ocupadas)
            {
                if (!DateTime.TryParse(oc.FechaInicio, out var oi) || !DateTime.TryParse(oc.FechaFin, out var of)) continue;
                if (oi.Date == ReservaParaReprogramar.FechaEntrada.Date && of.Date == ReservaParaReprogramar.FechaSalida.Date) continue; // es ella misma
                if (e < of.Date && s > oi.Date) { ErrorReprogramar = "Esas fechas no están disponibles. Elige otras."; Reprogramando = false; return; }
            }

            ReservaParaReprogramar.FechaEntrada = e;
            ReservaParaReprogramar.FechaSalida = s;
            ReservaParaReprogramar.Total = NuevoTotalEstimado;
            await ReservaProvider.ActualizarAsync(ReservaParaReprogramar);   // PUT -> persiste fechas + total

            MensajeAccion = $"Reserva en {ReservaParaReprogramar.AlojamientoNombre} reprogramada ({e:dd/MM/yyyy} – {s:dd/MM/yyyy}).";
            MostrarModalReprogramar = false;
            ReservaParaReprogramar = null;
            await CargarDatosAsync();
        }
        catch
        {
            ErrorReprogramar = "No se pudo reprogramar. Intenta de nuevo.";
        }
        finally { Reprogramando = false; }
    }

    private void DejarResena(Reserva reserva)
    {
        ReservaParaResenar = reserva;
        EstrellasSeleccionadas = 0;
        ComentarioResena = "";
        EstrellasAnfitrion = 0;
        ComentarioAnfitrion = "";
        ErrorResena = "";
        MostrarModalResena = true;
    }

    private async Task EnviarResena()
    {
        ErrorResena = "";
        if (EstrellasSeleccionadas < 1 || EstrellasSeleccionadas > 5)
        { ErrorResena = "Selecciona una calificación de 1 a 5 estrellas."; return; }
        if (string.IsNullOrWhiteSpace(ComentarioResena) || ComentarioResena.Trim().Length < 10)
        { ErrorResena = "El comentario debe tener al menos 10 caracteres."; return; }
        if (ReservaParaResenar is null) return;

        // RF19: si el huésped marcó estrellas al anfitrión, su comentario también es obligatorio (≥10).
        bool resenaAnfitrion = EstrellasAnfitrion >= 1;
        if (resenaAnfitrion && (string.IsNullOrWhiteSpace(ComentarioAnfitrion) || ComentarioAnfitrion.Trim().Length < 10))
        { ErrorResena = "El comentario sobre el anfitrión debe tener al menos 10 caracteres."; return; }

        EnviandoResena = true;
        try
        {
            // 1) Reseña al ALOJAMIENTO (comportamiento histórico).
            var nueva = new Resena
            {
                Estrellas = EstrellasSeleccionadas,
                Comentario = ComentarioResena.Trim(),
                ReservaId = ReservaParaResenar.Id,
                AlojamientoId = ReservaParaResenar.AlojamientoId,
                TipoAutor = "INVITADO",
                Objetivo = "ALOJAMIENTO",
                Activo = true
            };
            await ResenaProvider.RegistrarAsync(nueva);

            // 2) RF19: reseña AL ANFITRIÓN (persona), solo si el huésped la llenó.
            if (resenaAnfitrion)
            {
                var resenaHost = new Resena
                {
                    Estrellas = EstrellasAnfitrion,
                    Comentario = ComentarioAnfitrion.Trim(),
                    ReservaId = ReservaParaResenar.Id,
                    AlojamientoId = ReservaParaResenar.AlojamientoId,
                    TipoAutor = "INVITADO",
                    Objetivo = "ANFITRION",
                    Activo = true
                };
                await ResenaProvider.RegistrarAsync(resenaHost);
            }

            MensajeAccion = resenaAnfitrion
                ? $"¡Gracias por reseñar {ReservaParaResenar.AlojamientoNombre} y a su anfitrión!"
                : $"¡Gracias por tu reseña sobre {ReservaParaResenar.AlojamientoNombre}!";
            MostrarModalResena = false;
        }
        catch (Exception)
        {
            ErrorResena = "No se pudo enviar la reseña. Intenta de nuevo.";
        }
        finally { EnviandoResena = false; }
    }

    private void CerrarModalResena() => MostrarModalResena = false;
}
