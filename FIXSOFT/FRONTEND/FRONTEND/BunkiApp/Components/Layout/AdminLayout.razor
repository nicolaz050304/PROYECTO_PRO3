@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject BunkiApp.Models.AppState AppState
@inject BunkiApp.Services.DenunciaServiceRest DenunciaSvc
@inject BunkiApp.Services.IncidenciaServiceRest IncidenciaSvc
@inject BunkiApp.Services.ReservaProvider ReservaProvider

<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <a href="/admin" class="admin-logo">
            <i class="fas fa-shield-halved"></i><span class="admin-logo-text">BUNKI ADMIN</span>
        </a>

        <nav class="admin-nav">
            <NavLink class="admin-nav-link" href="/admin" Match="NavLinkMatch.All">
                <i class="fas fa-gauge-high"></i><span>Dashboard</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="/admin/moderacion">
                <i class="fas fa-scale-balanced"></i><span>Moderación</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="/admin/moderar-resenas">
                <i class="fas fa-star-half-stroke"></i><span>Moderar Reseñas</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="/admin/usuarios">
                <i class="fas fa-users"></i><span>Usuarios</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="/admin/reportes-financieros">
                <i class="fas fa-coins"></i><span>Reportes Financieros</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="/admin/tipo-cambio">
                <i class="fas fa-money-bill-transfer"></i><span>Tasas de Cambio</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="/admin/analytics">
                <i class="fas fa-chart-line"></i><span>Analytics</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="/admin/incidencias">
                <i class="fas fa-triangle-exclamation"></i><span>Incidencias</span>
            </NavLink>
        </nav>

        <a href="/" class="admin-back">
            <i class="fas fa-arrow-left"></i><span>Volver al sitio</span>
        </a>
    </aside>

    <!-- CONTENIDO -->
    <div class="admin-content">

        <!-- TOPBAR -->
        <header class="admin-topbar">
            <h1 class="admin-topbar-title">@Titulo</h1>

            <div class="admin-topbar-actions">

                <!-- Notificaciones -->
                <div class="admin-dropdown-wrap">
                    <button class="admin-iconbtn" @onclick="ToggleNotif" aria-label="Notificaciones">
                        <i class="fas fa-bell"></i>
                        @if (_avisoCount > 0)
                        {
                            <span class="admin-badge">@_avisoCount</span>
                        }
                    </button>

                    @if (_notif)
                    {
                        <div class="admin-dropdown">
                            <div class="admin-dd-title">Notificaciones</div>
                            @if (!_notificaciones.Any())
                            {
                                <div class="admin-dd-item"><span class="admin-dd-msg">Sin novedades</span></div>
                            }
                            @foreach (var n in _notificaciones)
                            {
                                <div class="admin-dd-item">
                                    <i class="fas @n.Icono"></i>
                                    <span>
                                        <span class="admin-dd-msg">@n.Mensaje</span>
                                        <span class="admin-dd-time">@n.Tiempo</span>
                                    </span>
                                </div>
                            }
                            <div class="admin-dd-footer">
                                <a href="/admin/notificaciones" @onclick="CerrarMenus">Ver todas</a>
                            </div>
                        </div>
                    }
                </div>

                <!-- Usuario -->
                <div class="admin-dropdown-wrap">
                    <button class="admin-avatar" @onclick="ToggleUser" aria-label="Cuenta">@(AppState.UsuarioActual?.Iniciales ?? "AD")</button>

                    @if (_user)
                    {
                        <div class="admin-dropdown admin-dropdown--user">
                            <div class="admin-dropdown-head">
                                <span class="admin-avatar">@(AppState.UsuarioActual?.Iniciales ?? "AD")</span>
                                <div>
                                    <div class="admin-dd-name">@(AppState.UsuarioActual?.NombreCompleto ?? "Administrador")</div>
                                    <div class="admin-dd-sub">@(AppState.UsuarioActual?.Email ?? "")</div>
                                </div>
                            </div>
                            <a href="/admin/perfil" class="admin-dd-item" @onclick="CerrarMenus">
                                <i class="fas fa-user"></i> Mi Perfil
                            </a>
                            <div class="admin-dd-divider"></div>
                            <button class="admin-dd-item danger" @onclick="CerrarSesion">
                                <i class="fas fa-right-from-bracket"></i> Cerrar Sesión
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>

        <main class="admin-main">
            @Body
        </main>
    </div>
</div>

@if (_notif || _user)
{
    <div class="admin-overlay" @onclick="CerrarMenus"></div>
}

@code {
    private bool _notif;
    private bool _user;

    private record Notif(string Icono, string Mensaje, string Tiempo);
    // Feed REAL (derivado de denuncias/incidencias/reservas). El badge cuenta lo "pendiente".
    private List<Notif> _notificaciones = new();
    private int _avisoCount;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await CargarAvisosAsync();
    }

    private async Task CargarAvisosAsync()
    {
        var items = new List<(DateTime fecha, Notif n, bool pendiente)>();
        try
        {
            var denuncias = await DenunciaSvc.ListarAsync();
            foreach (var d in denuncias.Where(d => d.Estado == "EN_REVISION"))
                items.Add((F(d.Fecha), new Notif("fa-flag", $"Denuncia #{d.Id} sobre \"{d.AlojamientoNombre}\"", Cuando(F(d.Fecha))), true));
        }
        catch { }
        try
        {
            var incidencias = await IncidenciaSvc.ListarAsync();
            foreach (var i in incidencias.Where(i => i.Estado is "ABIERTO" or "EN_PROCESO"))
                items.Add((F(i.Fecha), new Notif("fa-triangle-exclamation", $"Incidencia {i.Codigo}: {i.Asunto}", Cuando(F(i.Fecha))), true));
        }
        catch { }
        try
        {
            var reservas = await ReservaProvider.ListarTodasAsync();
            foreach (var r in reservas.OrderByDescending(r => r.FechaEntrada).Take(5))
                items.Add((r.FechaEntrada, new Notif("fa-calendar-plus", $"Reserva en \"{r.AlojamientoNombre}\"", Cuando(r.FechaEntrada)), false));
        }
        catch { }

        _avisoCount = items.Count(i => i.pendiente);   // badge = denuncias/incidencias por atender
        _notificaciones = items.OrderByDescending(i => i.fecha).Take(6).Select(i => i.n).ToList();
    }

    private static DateTime F(string? iso) => DateTime.TryParse(iso, out var d) ? d : DateTime.MinValue;

    private static string Cuando(DateTime f)
    {
        if (f == DateTime.MinValue) return "—";
        var dias = (DateTime.Today - f.Date).Days;
        if (dias < 0) return f.ToString("dd MMM");
        if (dias == 0) return "hoy";
        if (dias == 1) return "ayer";
        if (dias < 7) return $"hace {dias} días";
        return f.ToString("dd MMM");
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        CerrarMenus();
        InvokeAsync(StateHasChanged);
    }

    private void ToggleNotif() { _notif = !_notif; _user = false; }
    private void ToggleUser() { _user = !_user; _notif = false; }
    private void CerrarMenus() { _notif = false; _user = false; }

    private void CerrarSesion()
    {
        CerrarMenus();
        AppState.Logout();
        Nav.NavigateTo("/login");
    }

    private string Titulo
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri);
            var q = path.IndexOf('?');
            if (q >= 0) path = path[..q];
            path = path.TrimEnd('/');

            return path switch
            {
                "admin" => "Dashboard",
                "admin/moderacion" => "Moderación",
                "admin/moderar-resenas" => "Moderar Reseñas",
                "admin/usuarios" => "Usuarios",
                "admin/reportes-financieros" => "Reportes Financieros",
                "admin/tipo-cambio" => "Tasas de Cambio",
                "admin/analytics" => "Analytics",
                "admin/incidencias" => "Incidencias",
                "admin/perfil" => "Mi Perfil",
                "admin/notificaciones" => "Notificaciones",
                _ => "Admin"
            };
        }
    }
}
