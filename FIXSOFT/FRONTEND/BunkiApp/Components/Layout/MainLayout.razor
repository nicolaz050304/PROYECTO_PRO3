@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page-wrapper">
    @if (MostrarNav)
    {
        <NavMenu />
    }
    <main>@Body</main>
    @* Footer del sitio en 3 columnas (marca, navegación, contacto/redes) + línea legal inferior.
       Vive en el layout para ser consistente en todas las páginas, no solo en el Home. *@
    <footer>
        <div class="container footer-inner">
            <div class="footer-col footer-brand">
                <span class="footer-logo">Bunki</span>
                <p class="footer-tagline">Alojamientos seleccionados en Perú, reservados con la confianza de una plataforma profesional.</p>
            </div>

            <div class="footer-col">
                <h4 class="footer-title">Navegación</h4>
                <nav class="footer-links">
                    <a href="/explorar">Explorar</a>
                    <a href="/mis-reservas">Mis Reservas</a>
                    <a href="/perfil/ayuda">Ayuda</a>
                </nav>
            </div>

            <div class="footer-col">
                <h4 class="footer-title">Síguenos</h4>
                <div class="footer-social">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="X"><i class="fab fa-x-twitter"></i></a>
                </div>
                <p class="footer-contact"><i class="fas fa-envelope"></i> hola@bunki.pe</p>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container">
                <p>&copy; 2026 Bunki. Plataforma de alojamientos.</p>
            </div>
        </div>
    </footer>
</div>

<style>
    .page-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
    }
</style>

@code {
    private bool MostrarNav =>
        !new[] { "/login", "/registro", "/recuperar-password" }
            .Any(p => Navigation.Uri.Contains(p));
}