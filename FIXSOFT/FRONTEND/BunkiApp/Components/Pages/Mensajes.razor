@page "/mensajes"
@rendermode InteractiveServer
@inject DataService Data
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState

<PageTitle>Bunki - Mensajes</PageTitle>

<div class="section">
    <div class="container" style="max-width: 1200px;">
        <div class="chat-main-grid">

            <div class="chat-sidebar-left">
                <div style="padding: 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                    <h3>Conversaciones</h3>
                    <button class="btn btn-small btn-secondary">+ Nuevo</button>
                </div>

                <div style="flex: 1; overflow-y: auto;">
                    @foreach (var conv in Conversaciones)
                    {
                        <div class="conversation-item @(ConversacionActiva?.Id == conv.Id ? "active" : "")"
                             @onclick="() => SeleccionarConversacion(conv)">
                            <div class="avatar">@conv.ContactoInicial</div>
                            <div style="flex: 1; min-width: 0;">
                                <div class="flex flex-between">
                                    <h4 style="font-size: 14px;">@conv.ContactoNombre</h4>
                                    @if (conv.MensajesNoLeidos > 0)
                                    {
                                        <span class="badge badge-primary" style="font-size: 11px;">@conv.MensajesNoLeidos</span>
                                    }
                                </div>
                                <p class="card-text" style="font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 3px;">
                                    @conv.UltimoMensaje
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="chat-window">
                @if (ConversacionActiva is not null)
                {
                    <div class="chat-header">
                        <div class="flex gap-15 items-center">
                            <div class="avatar">@ConversacionActiva.ContactoInicial</div>
                            <div>
                                <h4>@ConversacionActiva.ContactoNombre</h4>
                                <p class="card-text" style="font-size: 12px;">@ConversacionActiva.Rol</p>
                            </div>
                        </div>
                    </div>

                    <div class="chat-messages" id="chat-messages">
                        @foreach (var msg in ConversacionActiva.Mensajes)
                        {
                            <div>
                                <div class="message-bubble @(msg.EsMio ? "message-sent" : "message-received")">
                                    @msg.Texto
                                </div>
                                <p class="message-meta" style="text-align: @(msg.EsMio ? "right" : "left");">
                                    @msg.Hora
                                </p>
                            </div>
                        }
                    </div>

                    <div class="chat-input-area">
                        <input type="text" placeholder="Escribe tu mensaje..."
                               style="flex: 1; padding: 12px;"
                               @bind:event="oninput" @bind="TextoMensaje"
                               @onkeypress="TeclaPresionada" />
                        <button class="btn btn-secondary" style="padding: 12px 20px;" @onclick="EnviarMensaje">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                }
                else
                {
                    <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: var(--text-light);">
                        <div style="text-align: center;">
                            <i class="fas fa-comments" style="font-size: 48px; margin-bottom: 16px; display: block;"></i>
                            <p>Selecciona una conversación</p>
                        </div>
                    </div>
                }
            </div>

            <div class="chat-sidebar-right">
                @if (ConversacionActiva != null && ConversacionActiva.ReservaAsociada != null)
                {
                    <div style="padding: 20px;">
                        <h4 style="margin-bottom: 15px; border-bottom: 1px solid var(--border); padding-bottom: 10px;">Detalle de Reserva</h4>
                        <img src="@ConversacionActiva.ReservaAsociada.ImagenAlojamiento" style="width: 100%; border-radius: 8px; margin-bottom: 15px;" />
                        <p style="font-weight: bold; margin-bottom: 5px;">@ConversacionActiva.ReservaAsociada.AlojamientoNombre</p>
                        
                        <p class="card-text" style="font-size: 13px; margin-bottom: 5px;"><i class="fas fa-calendar"></i> @ConversacionActiva.ReservaAsociada.FechasTexto</p>
                        <p class="card-text" style="font-size: 13px; margin-bottom: 5px;"><i class="fas fa-users"></i> @ConversacionActiva.ReservaAsociada.NumHuespedes Huéspedes</p>
                        <p class="card-text" style="font-size: 13px; margin-bottom: 15px;"><i class="fas fa-money-bill"></i> Total: S/ @ConversacionActiva.ReservaAsociada.Total</p>
                        
                        <div style="margin-bottom: 15px;">
                            @if (ConversacionActiva.ReservaAsociada.Estado == "Confirmada" || ConversacionActiva.ReservaAsociada.Estado == "Completada")
                            {
                                <span class="badge badge-success"><i class="fas fa-check-circle"></i> Pagado</span>
                            }
                            else
                            {
                                <span class="badge badge-warning"><i class="fas fa-clock"></i> Pendiente</span>
                            }
                        </div>

                        <button class="btn btn-secondary btn-block" @onclick='() => Navigation.NavigateTo($"/alojamiento/{ConversacionActiva.ReservaAsociada.AlojamientoId}")'>
                            Ver Alojamiento
                        </button>
                    </div>
                }
                else
                {
                    <div style="padding: 20px; color: var(--text-light); font-size: 13px; text-align: center;">
                        <i class="fas fa-info-circle" style="display: block; margin-bottom: 10px; font-size: 24px;"></i>
                        No hay reserva vinculada.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .chat-main-grid {
        display: grid;
        grid-template-columns: 300px 1fr 280px;
        background: var(--card-bg);
        border-radius: var(--radius-lg);
        height: 600px;
        border: 1px solid var(--border);
        overflow: hidden; /* Importante para que no se desborde */
    }

    .chat-window {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden; /* Evita que el chat se "rompa" */
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto; /* Permite scroll interno */
        padding: 20px;
    }

    .chat-input-area {
        padding: 15px;
        border-top: 1px solid var(--border);
        background: var(--card-bg);
        display: flex;
        gap: 10px;
    }
</style>

@code {
    private List<Conversacion> Conversaciones = new();
    private Conversacion? ConversacionActiva;
    private string TextoMensaje = "";

    protected override void OnInitialized()
    {
        if (!AppState.EstaAutenticado) { Navigation.NavigateTo("/login"); return; }
        Conversaciones = Data.ObtenerConversaciones();
        ConversacionActiva = Conversaciones.FirstOrDefault();
    }

    private void SeleccionarConversacion(Conversacion conv) { ConversacionActiva = conv; conv.MensajesNoLeidos = 0; }
    
    private void EnviarMensaje()
    {
        if (string.IsNullOrWhiteSpace(TextoMensaje) || ConversacionActiva is null) return;

        ConversacionActiva.Mensajes.Add(new Mensaje
        {
            Texto = TextoMensaje,
            Hora = DateTime.Now.ToString("hh:mm tt"),
            EsMio = true
        });

        TextoMensaje = ""; 
        StateHasChanged();
    }
    private void TeclaPresionada(KeyboardEventArgs e) { if (e.Key == "Enter") EnviarMensaje(); }
}