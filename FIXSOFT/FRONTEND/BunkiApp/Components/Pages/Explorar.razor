@page "/explorar"
@page "/buscar"
@rendermode InteractiveServer
@inject DataService Data
@inject IJSRuntime JS
@using System.Globalization

<PageTitle>Bunki - Explorar Alojamientos</PageTitle>

<div class="section">
    <div class="container">

        <!-- ===== CABECERA COMPACTA + TOGGLE VISTA ===== -->
        <div class="explorar-head">
            <div>
                <span class="eyebrow">Explorar</span>
                <h1 class="explorar-title">Alojamientos en Perú</h1>
                <p class="explorar-count">
                    <strong>@AlojamientosFiltrados.Count</strong>
                    @(AlojamientosFiltrados.Count == 1 ? "alojamiento disponible" : "alojamientos disponibles")
                </p>
            </div>

            <div class="view-toggle">
                <button type="button"
                        class="view-toggle-btn @(Vista == "lista" ? "active" : "")"
                        aria-pressed="@(Vista == "lista" ? "true" : "false")"
                        @onclick='() => Vista = "lista"'>
                    <i class="fas fa-table-cells-large"></i> Lista
                </button>
                <button type="button"
                        class="view-toggle-btn @(Vista == "mapa" ? "active" : "")"
                        aria-pressed="@(Vista == "mapa" ? "true" : "false")"
                        @onclick='() => Vista = "mapa"'>
                    <i class="fas fa-map-location-dot"></i> Mapa
                </button>
            </div>
        </div>

        <div class="explorar-layout">

            <!-- ===== FILTROS ===== -->
            <aside class="filter-panel">
                <div class="filter-panel-head">
                    <h2>Filtros</h2>
                    <button type="button" class="filter-clear" @onclick="LimpiarFiltros">Limpiar</button>
                </div>

                <!-- Ubicación -->
                <div class="filter-group">
                    <label class="filter-group-label">Ubicación</label>
                    <div class="filter-input-icon">
                        <i class="fas fa-location-dot"></i>
                        <input type="text" placeholder="Ej: Miraflores"
                               value="@Filtros.Ubicacion"
                               @oninput="@(e => Filtros.Ubicacion = e.Value?.ToString() ?? string.Empty)" />
                    </div>
                </div>

                <!-- Fechas (Flatpickr, consistente con Home; no filtran) -->
                <div class="filter-group">
                    <label class="filter-group-label">Fechas</label>
                    <div class="filter-dates">
                        <input class="flatpickr-date"
                               type="text"
                               placeholder="Entrada"
                               aria-label="Fecha de entrada"
                               value="@FormatPickerDate(Filtros.FechaEntrada)"
                               @onchange="OnFechaEntradaChanged"
                               autocomplete="off" />

                        <input class="flatpickr-date"
                               type="text"
                               placeholder="Salida"
                               aria-label="Fecha de salida"
                               value="@FormatPickerDate(Filtros.FechaSalida)"
                               @onchange="OnFechaSalidaChanged"
                               autocomplete="off" />
                    </div>
                </div>

                <!-- Huéspedes (chips, consistente con Home) -->
                <div class="filter-group">
                    <label class="filter-group-label">Huéspedes</label>
                    <div class="guest-chip-group">
                        @for (int g = 1; g <= 4; g++)
                        {
                            int n = g;
                            <button type="button"
                                    class="guest-chip @(Filtros.Huespedes == n ? "active" : "")"
                                    @onclick="() => Filtros.Huespedes = n">
                                @(n == 4 ? "4+" : n.ToString())
                            </button>
                        }
                    </div>
                </div>

                <!-- Precio máximo -->
                <div class="filter-group">
                    <label class="filter-group-label">
                        <span>Precio máximo</span>
                        <span class="price-value">S/ @Filtros.PrecioMaximo<span class="price-value-unit"> /noche</span></span>
                    </label>
                    <div class="price-range">
                        <input type="range" min="50" max="500" step="10"
                               value="@Filtros.PrecioMaximo"
                               @oninput="@(e => Filtros.PrecioMaximo = decimal.Parse(e.Value!.ToString()!))" />
                    </div>
                </div>

                <!-- Tipo de alojamiento (chips multi-selección) -->
                <div class="filter-group">
                    <label class="filter-group-label">Tipo de alojamiento</label>
                    <div class="filter-chips">
                        @foreach (var tipo in TiposAlojamiento)
                        {
                            var t = tipo;
                            <button type="button"
                                    class="filter-btn @(Filtros.TiposSeleccionados.Contains(t) ? "active" : "")"
                                    @onclick="() => ToggleTipo(t)">
                                @t
                            </button>
                        }
                    </div>
                </div>

                <!-- Clasificación mínima (chips) -->
                <div class="filter-group">
                    <label class="filter-group-label">Clasificación mínima</label>
                    <div class="filter-chips">
                        @foreach (var r in RatingsOpciones)
                        {
                            var opt = r;
                            <button type="button"
                                    class="filter-btn @(Filtros.RatingMinimo == opt ? "active" : "")"
                                    @onclick="() => Filtros.RatingMinimo = opt">
                                @(opt == "Cualquiera" ? opt : opt.Replace(" estrellas", "") + " ★")
                            </button>
                        }
                    </div>
                </div>

                <button class="btn btn-primary btn-block" @onclick="AplicarFiltros">
                    <i class="fas fa-sliders"></i> Aplicar filtros
                </button>
            </aside>

            <!-- ===== RESULTADOS ===== -->
            <div class="explorar-results">
                @if (Vista == "mapa")
                {
                    <!-- Zona reservada para futura integración con Google Maps (NO implementada) -->
                    <div class="map-placeholder">
                        <div class="map-placeholder-inner">
                            <span class="map-placeholder-icon"><i class="fas fa-map-location-dot"></i></span>
                            <h3>Vista de mapa</h3>
                            <p>Pronto podrás explorar los @AlojamientosFiltrados.Count alojamientos sobre el mapa, con precios y ubicación.</p>
                            <span class="badge badge-primary">Próximamente</span>
                        </div>
                    </div>
                }
                else if (AlojamientosFiltrados.Count == 0)
                {
                    <AlertMessage Tipo="warning" Mensaje="No se encontraron alojamientos con los filtros seleccionados. Intenta ajustar la búsqueda." Cerrable="false" />
                }
                else
                {
                    <div class="grid grid-3">
                        @foreach (var item in AlojamientosPaginados)
                        {
                            <AlojamientoCard Alojamiento="item" UrlDetalle="@ConstruirUrlDetalle(item.Id)" />
                        }
                    </div>

                    @if (TotalPaginas > 1)
                    {
                        <div class="pagination">
                            @if (PaginaActual > 1)
                            {
                                <a href="#" @onclick:preventDefault @onclick="() => CambiarPagina(PaginaActual - 1)" aria-label="Página anterior">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            }
                            @for (int i = 1; i <= TotalPaginas; i++)
                            {
                                int num = i;
                                @if (num == PaginaActual)
                                {
                                    <span class="active">@num</span>
                                }
                                else
                                {
                                    <a href="#" @onclick:preventDefault @onclick="() => CambiarPagina(num)">@num</a>
                                }
                            }
                            @if (PaginaActual < TotalPaginas)
                            {
                                <a href="#" @onclick:preventDefault @onclick="() => CambiarPagina(PaginaActual + 1)" aria-label="Página siguiente">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            }
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</div>

@code {
    // Lee el query string que envía la Home (Buscar). No cambia servicios ni modelos.
    [Parameter, SupplyParameterFromQuery(Name = "ubicacion")] public string? UbicacionQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "huespedes")] public int? HuespedesQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "entrada")] public DateTime? EntradaQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "salida")] public DateTime? SalidaQuery { get; set; }

    private BusquedaFiltros Filtros = new() { PrecioMaximo = 500 };
    private List<Alojamiento> AlojamientosFiltrados = new();
    private int PaginaActual = 1;
    private int ElementosPorPagina = 6;
    private string Vista = "lista";

    private static readonly string[] TiposAlojamiento = { "Casa", "Departamento", "Habitación", "Cabaña" };
    private static readonly string[] RatingsOpciones = { "Cualquiera", "4+ estrellas", "4.5+ estrellas", "5 estrellas" };

    private List<Alojamiento> AlojamientosPaginados =>
        AlojamientosFiltrados
            .Skip((PaginaActual - 1) * ElementosPorPagina)
            .Take(ElementosPorPagina)
            .ToList();

    private int TotalPaginas => (int)Math.Ceiling((double)AlojamientosFiltrados.Count / ElementosPorPagina);

    protected override void OnInitialized()
    {
        AlojamientosFiltrados = Data.ObtenerAlojamientos();

        // Precarga de filtros desde el query string (Home → Buscar). Idempotente.
        bool hayQuery = false;
        if (!string.IsNullOrWhiteSpace(UbicacionQuery)) { Filtros.Ubicacion = UbicacionQuery; hayQuery = true; }
        if (HuespedesQuery is > 0) { Filtros.Huespedes = HuespedesQuery.Value; hayQuery = true; }
        if (EntradaQuery.HasValue) { Filtros.FechaEntrada = EntradaQuery; hayQuery = true; }
        if (SalidaQuery.HasValue) { Filtros.FechaSalida = SalidaQuery; hayQuery = true; }

        if (hayQuery)
        {
            PaginaActual = 1;
            AlojamientosFiltrados = Data.FiltrarAlojamientos(Filtros);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Reutiliza el mismo inicializador de Flatpickr que la Home.
            await JS.InvokeVoidAsync("bunkiDatePicker.init", ".flatpickr-date");
        }
    }

    private void AplicarFiltros()
    {
        PaginaActual = 1;
        AlojamientosFiltrados = Data.FiltrarAlojamientos(Filtros);
    }

    private void LimpiarFiltros()
    {
        Filtros = new BusquedaFiltros { PrecioMaximo = 500 };
        PaginaActual = 1;
        AlojamientosFiltrados = Data.ObtenerAlojamientos();
    }

    private void ToggleTipo(string tipo)
    {
        if (Filtros.TiposSeleccionados.Contains(tipo))
            Filtros.TiposSeleccionados.Remove(tipo);
        else
            Filtros.TiposSeleccionados.Add(tipo);
    }

    private void CambiarPagina(int pagina)
    {
        PaginaActual = pagina;
    }
    private string ConstruirUrlDetalle(int id)
    {
        var query = new List<string>();

        if (Filtros.FechaEntrada.HasValue)
            query.Add($"entrada={Filtros.FechaEntrada.Value:yyyy-MM-dd}");

        if (Filtros.FechaSalida.HasValue)
            query.Add($"salida={Filtros.FechaSalida.Value:yyyy-MM-dd}");

        if (Filtros.Huespedes > 0)
            query.Add($"huespedes={Filtros.Huespedes}");

        return query.Any()
            ? $"/alojamiento/{id}?{string.Join("&", query)}"
            : $"/alojamiento/{id}";
    }

    private string FormatPickerDate(DateTime? fecha)
    {
        return fecha?.ToString("yyyy-MM-dd") ?? "";
    }

    private void OnFechaEntradaChanged(ChangeEventArgs e)
    {
        Filtros.FechaEntrada = ParsePickerDate(e.Value?.ToString());

        if (Filtros.FechaEntrada.HasValue &&
            Filtros.FechaSalida.HasValue &&
            Filtros.FechaSalida <= Filtros.FechaEntrada)
        {
            Filtros.FechaSalida = null;
        }
    }

    private void OnFechaSalidaChanged(ChangeEventArgs e)
    {
        Filtros.FechaSalida = ParsePickerDate(e.Value?.ToString());
    }

    private DateTime? ParsePickerDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        if (DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var fecha))
            return fecha;

        if (DateTime.TryParse(value, out fecha))
            return fecha;

        return null;
    }
}
