@page "/panel-anfitrion"
@rendermode InteractiveServer
@inject DataService Data
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState
@inject IJSRuntime JS
@using System.Globalization
@implements IDisposable
<PageTitle>Bunki - Centro de Anfitrión</PageTitle>

<div class="section host-page">
    <div class="container">

        <!-- CABECERA -->
        <header class="host-head">
            <div>
                <span class="host-head-eyebrow">Bunki Host Center</span>
                <h1 class="host-head-title">Hola, @NombreAnfitrion</h1>
                <p class="host-head-sub">Gestiona tus alojamientos, reservas e ingresos desde un solo lugar.</p>
            </div>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/crear-alojamiento")'>
                <i class="fas fa-plus-circle"></i> Crear alojamiento
            </button>
        </header>

        <!-- OVERVIEW BENTO -->
        <div class="host-overview">

            <!-- Spotlight: ingresos + mini bar-chart -->
            <div class="spotlight">
                <span class="spotlight-label"><i class="fas fa-sack-dollar"></i> Ingresos estimados (mes)</span>
                <div class="spotlight-value">@AppState.FormatearPrecio(Stats.IngresosEsteMes)</div>
                <p class="spotlight-sub"><span class="up"><i class="fas fa-arrow-trend-up"></i> +12%</span> vs. mes anterior</p>
                <div class="spark-bars" aria-hidden="true">
                    @foreach (var m in Ingresos6m)
                    {
                        <div class="spark-col">
                            <div class="spark-bar" style="height:@(BarH(m.Valor))px"></div>
                            <div class="spark-cap">@m.Mes</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Anillo de ocupación -->
            <div class="gauge-card">
                <div class="gauge" style="--val:@(Stats.TasaOcupacion)" role="img"
                     aria-label="Ocupación @(Stats.TasaOcupacion) por ciento">
                    <span class="gauge-num">@(Stats.TasaOcupacion)%</span>
                </div>
                <span class="gauge-label">Ocupación · últimos 30 días</span>
            </div>

            <!-- Métricas de apoyo -->
            <div class="metric-stack">
                <div class="metric-mini">
                    <span class="metric-mini-icon metric-mini-icon--warning"><i class="fas fa-clock"></i></span>
                    <div class="metric-mini-body">
                        <div class="metric-mini-value">@ReservasPendientes</div>
                        <div class="metric-mini-label">Reservas pendientes</div>
                    </div>
                </div>
                <div class="metric-mini">
                    <span class="metric-mini-icon metric-mini-icon--info"><i class="fas fa-house"></i></span>
                    <div class="metric-mini-body">
                        <div class="metric-mini-value">@AlojamientosActivos</div>
                        <div class="metric-mini-label">Alojamientos activos</div>
                    </div>
                </div>
                <div class="metric-mini">
                    <span class="metric-mini-icon"><i class="fas fa-star"></i></span>
                    <div class="metric-mini-body">
                        <div class="metric-mini-value">@Stats.RatingPromedio.ToString("F1")</div>
                        <div class="metric-mini-label">Calificación promedio</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LAYOUT PRINCIPAL -->
        <div class="host-grid">

            <!-- COLUMNA PRINCIPAL -->
            <div style="display: flex; flex-direction: column; gap: 24px;">

                <!-- GANANCIAS -->
                <div class="host-panel">
                    <div class="host-panel-head">
                        <h2 class="host-panel-title"><i class="fas fa-chart-pie"></i> Rentabilidad y ganancias</h2>
                        <div class="flex items-center gap-10" style="flex-wrap: wrap;">
                            <input type="text" id="host-filtro-inicio" class="host-flatpickr" placeholder="dd/mm/aaaa"
                                   value="@Fmt(FiltroInicio)" @onchange="OnInicioChanged" autocomplete="off"
                                   style="max-width: 140px; height: 38px; font-size: 13px;" />
                            <input type="text" id="host-filtro-fin" class="host-flatpickr" placeholder="dd/mm/aaaa"
                                   value="@Fmt(FiltroFin)" @onchange="OnFinChanged" autocomplete="off"
                                   style="max-width: 140px; height: 38px; font-size: 13px;" />
                            <button class="btn btn-small btn-secondary" @onclick="RecalcularGananciasAnfitrion">
                                <i class="fas fa-filter"></i> Filtrar
                            </button>
                        </div>
                    </div>

                    <div class="host-earnings">
                        <div class="earn-card">
                            <span class="earn-label">Ingresos brutos</span>
                            <span class="earn-value">@AppState.FormatearPrecio(MontoBrutoAnfitrion)</span>
                        </div>
                        <div class="earn-card earn-card--fee">
                            <span class="earn-label">Comisión Bunki (10%)</span>
                            <span class="earn-value">- @AppState.FormatearPrecio(MontoComisionBunki)</span>
                        </div>
                        <div class="earn-card earn-card--net">
                            <span class="earn-label">Ganancia neta</span>
                            <span class="earn-value">@AppState.FormatearPrecio(MontoNetoAnfitrion)</span>
                        </div>
                    </div>
                </div>

                <!-- RESERVAS RECIENTES -->
                <div class="host-panel">
                    <div class="host-panel-head">
                        <h2 class="host-panel-title"><i class="fas fa-calendar-check"></i> Reservas recientes</h2>
                        <a href="/reservas-recibidas" class="host-panel-link">Ver todas <i class="fas fa-arrow-right"></i></a>
                    </div>

                    <div class="host-recent-reservations">
                        @foreach (var r in ReservasRecientes)
                        {
                            <div class="host-recent-booking">
                                <div class="host-recent-guest">
                                    <div class="avatar host-recent-avatar">@r.Iniciales</div>
                                    <div>
                                        <div class="host-recent-name">@r.Huesped</div>
                                        <div class="host-recent-sub">
                                            <i class="fas fa-house"></i>
                                            @r.Alojamiento
                                        </div>
                                    </div>
                                </div>

                                <div class="host-recent-date">
                                    <span class="host-recent-label">Fechas</span>
                                    <strong><i class="fas fa-calendar-day"></i> @r.Fechas</strong>
                                </div>

                                <div class="host-recent-total">
                                    <span class="host-recent-label">Total</span>
                                    <strong class="price">@r.Total</strong>
                                </div>

                                <div class="host-recent-state">
                                    <span class="state @EstadoState(r.Estado)">
                                        <span class="state-dot"></span>
                                        @r.Estado
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- COLUMNA LATERAL -->
            <div style="display: flex; flex-direction: column; gap: 24px;">

                <!-- ACCIONES RÁPIDAS -->
                <div class="host-panel">
                    <div class="host-panel-head">
                        <h2 class="host-panel-title"><i class="fas fa-bolt"></i> Acciones rápidas</h2>
                    </div>
                    <div class="host-actions">
                        <a href="/crear-alojamiento" class="host-action">
                            <span class="host-action-icon"><i class="fas fa-plus"></i></span>
                            <span class="host-action-text"><strong>Crear alojamiento</strong><span>Publica un espacio</span></span>
                            <i class="fas fa-chevron-right host-action-arrow"></i>
                        </a>
                        <a href="/mis-alojamientos" class="host-action">
                            <span class="host-action-icon"><i class="fas fa-home"></i></span>
                            <span class="host-action-text"><strong>Mis alojamientos</strong><span>Gestiona tus propiedades</span></span>
                            <i class="fas fa-chevron-right host-action-arrow"></i>
                        </a>
                        <a href="/reservas-recibidas" class="host-action">
                            <span class="host-action-icon"><i class="fas fa-inbox"></i></span>
                            <span class="host-action-text"><strong>Revisar reservas</strong><span>@ReservasPendientes pendientes</span></span>
                            <i class="fas fa-chevron-right host-action-arrow"></i>
                        </a>
                        <a href="/mensajes" class="host-action">
                            <span class="host-action-icon"><i class="fas fa-comments"></i></span>
                            <span class="host-action-text"><strong>Mensajes</strong><span>Habla con tus huéspedes</span></span>
                            <i class="fas fa-chevron-right host-action-arrow"></i>
                        </a>
                    </div>
                </div>

                <!-- ACTIVIDAD RECIENTE -->
                <div class="host-panel">
                    <div class="host-panel-head">
                        <h2 class="host-panel-title"><i class="fas fa-list-check"></i> Tareas y actividad</h2>
                    </div>
                    <div class="host-feed">
                        @foreach (var a in Actividad)
                        {
                            <div class="host-feed-item">
                                <div class="host-feed-icon host-feed-icon--@a.Tono"><i class="fas @a.Icono"></i></div>
                                <div class="host-feed-body">
                                    <p>@((MarkupString)a.Texto)</p>
                                    <div class="host-feed-time">@a.Tiempo</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Alojamiento> Alojamientos = new();
    private (int ReservasActivas, decimal IngresosEsteMes, double RatingPromedio, int TasaOcupacion) Stats;

    private string NombreAnfitrion => AppState.UsuarioActual?.Nombre ?? "anfitrión";
    private int AlojamientosActivos => Alojamientos.Count(a => a.EstadoPublicacion == "Activo");
    private int ReservasPendientes => ReservasRecientes.Count(r => r.Estado == "Pendiente");

    private record ReservaResumen(string Iniciales, string Huesped, string Alojamiento, string Fechas, string Total, string Estado);
    private record Evento(string Icono, string Tono, string Texto, string Tiempo);
    private record Punto(string Mes, decimal Valor);

    // Serie mensual de ingresos (mock visual para el mini bar-chart).
    private static readonly Punto[] Ingresos6m =
    {
        new("Ene", 5200m), new("Feb", 6100m), new("Mar", 5800m),
        new("Abr", 7400m), new("May", 7000m), new("Jun", 8500m)
    };

    private static int BarH(decimal valor)
    {
        decimal max = Ingresos6m.Max(p => p.Valor);
        return (int)(valor / max * 60m) + 8; // alto en px (8–68)
    }

    private List<ReservaResumen> ReservasRecientes = new()
    {
        new("JP", "Juan Pérez", "Depto en Miraflores", "15-20 Mayo", "S/ 825", "Confirmada"),
        new("LM", "Laura M.", "Casa en La Molina", "28 Mayo - 3 Jun", "S/ 1,200", "Pendiente"),
        new("CR", "Carlos R.", "Habitación en Barranco", "1-5 Mayo", "S/ 400", "Confirmada")
    };

    // Feed de actividad (mock visual de frontend).
    private List<Evento> Actividad = new()
    {
        new("fa-calendar-plus", "success", "Nueva reserva en <strong>Depto en Miraflores</strong>", "Hace 2 horas"),
        new("fa-clock", "warning", "Reserva pendiente de confirmar en <strong>Casa en La Molina</strong>", "Hace 5 horas"),
        new("fa-star", "info", "Nueva reseña de 5★ de <strong>Carlos R.</strong>", "Ayer"),
        new("fa-triangle-exclamation", "warning", "<strong>Habitación en Barranco</strong> está en revisión", "Hace 2 días")
    };

    protected override void OnInitialized()
    {
        if (!AppState.EstaAutenticado) { Navigation.NavigateTo("/login"); return; }

        AppState.OnChange += OnMonedaChanged;
        Alojamientos = Data.ObtenerAlojamientosAnfitrion();
        Stats = Data.ObtenerEstadisticasAnfitrion();
    }

    public void Dispose() => AppState.OnChange -= OnMonedaChanged;
    private void OnMonedaChanged() => InvokeAsync(StateHasChanged);

    private string EstadoState(string estado) => estado switch
    {
        "Pendiente"  => "state--pendiente",
        "Confirmada" => "state--confirmada",
        "Completada" => "state--completada",
        "Cancelada"  => "state--cancelada",
        _            => "state--completada"
    };

    // Calendario dark unificado (mismo Flatpickr que el resto de Bunki).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("bunkiDatePicker.initHostDate", "#host-filtro-inicio");
            await JS.InvokeVoidAsync("bunkiDatePicker.initHostDate", "#host-filtro-fin");
        }
    }

    private string Fmt(DateTime fecha) => fecha.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);

    private DateTime ParseFecha(string? value, DateTime fallback)
    {
        if (!string.IsNullOrWhiteSpace(value) &&
            DateTime.TryParseExact(value, "dd/MM/yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var f))
            return f;
        return fallback;
    }

    private void OnInicioChanged(ChangeEventArgs e) => FiltroInicio = ParseFecha(e.Value?.ToString(), FiltroInicio);
    private void OnFinChanged(ChangeEventArgs e) => FiltroFin = ParseFecha(e.Value?.ToString(), FiltroFin);

    // Reporte financiero del anfitrión (mock; se recalcula al filtrar).
    private DateTime FiltroInicio = DateTime.Today.AddDays(-30);
    private DateTime FiltroFin = DateTime.Today;

    private decimal MontoBrutoAnfitrion = 8500;
    private decimal MontoComisionBunki => MontoBrutoAnfitrion * 0.10m;
    private decimal MontoNetoAnfitrion => MontoBrutoAnfitrion - MontoComisionBunki;

    private void RecalcularGananciasAnfitrion() => MontoBrutoAnfitrion = 11400;
}
