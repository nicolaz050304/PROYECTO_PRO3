@page "/admin/moderacion"
@layout AdminLayout
@rendermode InteractiveServer
@inject DataService Data

<PageTitle>Bunki Admin · Moderación</PageTitle>

<h1 class="admin-page-title">Moderación</h1>
<p class="admin-page-sub">Aprueba publicaciones, revisa denuncias y gestiona incidencias.</p>

<!-- TABS -->
<div class="tabs">
    <button class="tab-btn @(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">
        Alojamientos pendientes <span class="tab-count">@_pendientes.Count</span>
    </button>
    <button class="tab-btn @(_tab == 2 ? "active" : "")" @onclick="() => _tab = 2">
        Denuncias <span class="tab-count">@_denuncias.Count</span>
    </button>
    <button class="tab-btn @(_tab == 3 ? "active" : "")" @onclick="() => _tab = 3">
        Incidencias <span class="tab-count">@_incidencias.Count</span>
    </button>
</div>

<!-- TAB 1: ALOJAMIENTOS PENDIENTES -->
@if (_tab == 1)
{
    <div class="adm-table-card">
        @if (!_pendientes.Any())
        {
            <div class="adm-empty"><i class="fas fa-circle-check" style="color: var(--success); margin-right: 8px;"></i> No hay alojamientos pendientes de revisión.</div>
        }
        else
        {
            <div class="adm-scroll">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Alojamiento</th><th>Anfitrión</th><th>Tipo</th><th>Fecha envío</th><th style="text-align: right;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _pendientes)
                        {
                            <tr>
                                <td><strong>@a.Nombre</strong></td>
                                <td>@a.Anfitrion</td>
                                <td>@a.Tipo</td>
                                <td class="adm-muted">@a.Fecha</td>
                                <td>
                                    <div class="adm-row-actions" style="justify-content: flex-end;">
                                        <button class="btn btn-small btn-success" @onclick='() => PedirConfirmacion(a, "aprobar")'>
                                            <i class="fas fa-check"></i> Aprobar
                                        </button>
                                        <button class="btn btn-small btn-soft-danger" @onclick='() => PedirConfirmacion(a, "rechazar")'>
                                            Rechazar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<!-- TAB 2: DENUNCIAS -->
@if (_tab == 2)
{
    <div class="adm-table-card">
        <div class="adm-scroll">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th><th>Usuario denunciado</th><th>Tipo</th><th>Estado</th><th>Fecha</th><th style="text-align: right;">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _denuncias)
                    {
                        <tr>
                            <td><strong>@d.Id</strong></td>
                            <td>@d.Usuario</td>
                            <td>@d.Tipo</td>
                            <td><span class="state @EstadoState(d.Estado)"><span class="state-dot"></span>@d.Estado</span></td>
                            <td class="adm-muted">@d.Fecha</td>
                            <td style="text-align: right;">
                                <button class="btn btn-small btn-outline" @onclick="() => VerDenuncia(d)">
                                    <i class="fas fa-eye"></i> Ver
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- TAB 3: INCIDENCIAS -->
@if (_tab == 3)
{
    <div class="adm-table-card">
        <div class="adm-scroll">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th><th>Asunto</th><th>Prioridad</th><th>Estado</th><th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in _incidencias)
                    {
                        <tr>
                            <td><strong>@i.Id</strong></td>
                            <td>@i.Asunto</td>
                            <td>
                                <span class="adm-prio adm-prio--@i.Prioridad.ToLower()">
                                    <span class="adm-prio-dot"></span>@i.Prioridad
                                </span>
                            </td>
                            <td><span class="state state--pendiente"><span class="state-dot"></span>@i.Estado</span></td>
                            <td class="adm-muted">@i.Fecha</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- TOAST -->
@if (!string.IsNullOrEmpty(_mensaje))
{
    <div style="position: fixed; bottom: 24px; right: 24px; z-index: var(--z-toast);">
        <AlertMessage Tipo="success" Mensaje="@_mensaje" />
    </div>
}

<!-- MODAL CONFIRMAR (aprobar / rechazar) -->
@if (_showConfirm && _target is not null)
{
    bool aprobar = _accion == "aprobar";
    <div class="modal-overlay">
        <div class="modal-panel">
            <div class="empty-state-icon"
                 style="margin-bottom: 18px; background: @(aprobar ? "var(--success-tint)" : "var(--danger-tint)"); color: @(aprobar ? "var(--success)" : "var(--danger)");">
                <i class="fas @(aprobar ? "fa-check" : "fa-xmark")"></i>
            </div>
            <h2 style="margin-bottom: 12px;">@(aprobar ? "¿Aprobar alojamiento?" : "¿Rechazar alojamiento?")</h2>
            <p class="card-text" style="margin-bottom: 24px;">
                @(aprobar ? "Se publicará " : "Se rechazará ")<strong>@_target.Nombre</strong> de @_target.Anfitrion.
            </p>
            <div class="adm-modal-actions">
                <button class="btn btn-outline" style="flex: 1;" @onclick="CerrarConfirm">Cancelar</button>
                <button class="btn @(aprobar ? "btn-success" : "btn-danger")" style="flex: 1;" @onclick="ConfirmarAccion">
                    @(aprobar ? "Aprobar" : "Rechazar")
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL DETALLE DENUNCIA -->
@if (_showDenuncia && _denunciaSel is not null)
{
    <div class="modal-overlay">
        <div class="modal-panel" style="max-width: 460px;">
            <h2 style="margin-bottom: 16px;">Denuncia @_denunciaSel.Id</h2>
            <dl class="adm-dl">
                <div><dt>Usuario denunciado</dt><dd>@_denunciaSel.Usuario</dd></div>
                <div><dt>Tipo</dt><dd>@_denunciaSel.Tipo</dd></div>
                <div><dt>Estado</dt><dd><span class="state @EstadoState(_denunciaSel.Estado)"><span class="state-dot"></span>@_denunciaSel.Estado</span></dd></div>
                <div><dt>Fecha</dt><dd>@_denunciaSel.Fecha</dd></div>
            </dl>
            <button class="btn btn-primary btn-large" style="margin-top: 22px;" @onclick="() => _showDenuncia = false">Cerrar</button>
        </div>
    </div>
}

<style>
    .adm-table-card {
        background: var(--surface);
        border: 1px solid var(--hairline);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .adm-scroll { overflow-x: auto; }

    .adm-muted { color: var(--ink-muted); font-variant-numeric: tabular-nums; }

    .adm-row-actions { display: flex; gap: 8px; }

    .adm-empty { padding: 44px 20px; text-align: center; color: var(--ink-muted); font-size: 14.5px; }

    /* Prioridad (punto + etiqueta, no solo color) */
    .adm-prio {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 4px 11px;
        border-radius: var(--radius-pill);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .adm-prio-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

    .adm-prio--alta { background: var(--danger-tint); color: var(--danger); }
    .adm-prio--alta .adm-prio-dot { background: var(--danger); }
    .adm-prio--media { background: var(--warning-tint); color: var(--warning); }
    .adm-prio--media .adm-prio-dot { background: var(--warning); }
    .adm-prio--baja { background: var(--success-tint); color: var(--success); }
    .adm-prio--baja .adm-prio-dot { background: var(--success); }

    .adm-modal-actions { display: flex; gap: 12px; }

    /* Lista de detalle en el modal de denuncia */
    .adm-dl { margin: 0; text-align: left; }

        .adm-dl > div {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 11px 0;
            border-bottom: 1px solid var(--hairline);
            font-size: 14px;
        }

            .adm-dl > div:last-child { border-bottom: none; }

        .adm-dl dt { color: var(--ink-muted); }
        .adm-dl dd { margin: 0; color: var(--ink); font-weight: 600; }
</style>

@code {
    private int _tab = 1;
    private string _mensaje = "";

    // Permite abrir directamente una pestaña desde un enlace, p. ej.
    // /admin/moderacion?tab=denuncias (usado por la tarjeta del dashboard).
    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    // ---- Datos mock ----
    private record PendingAloj(string Nombre, string Anfitrion, string Tipo, string Fecha);
    private record Denuncia(string Id, string Usuario, string Tipo, string Estado, string Fecha);
    private record Incidencia(string Id, string Asunto, string Prioridad, string Estado, string Fecha);

    // Las tres listas se cargan desde DataService (fuente única compartida con
    // el dashboard /admin y /admin/incidencias) en OnInitialized. Se mantienen
    // como copias locales mutables para reflejar aprobar/rechazar en pantalla.
    private List<PendingAloj> _pendientes = new();
    private List<Denuncia> _denuncias = new();
    private List<Incidencia> _incidencias = new();

    protected override void OnInitialized()
    {
        _tab = TabQuery switch
        {
            "denuncias" => 2,
            "incidencias" => 3,
            _ => 1
        };

        // Pendientes de aprobación: derivado real (EstadoPublicacion == "Revisión").
        // Alojamiento no modela "fecha de envío", por eso se muestra "—".
        _pendientes = Data.ObtenerAlojamientosPorAprobar()
            .Select(a => new PendingAloj(a.Nombre, a.AnfitrionNombre, a.Tipo, "—"))
            .ToList();

        _denuncias = Data.ObtenerDenunciasAdmin()
            .Select(d => new Denuncia(d.Id, d.Usuario, d.Tipo, d.Estado, d.Fecha))
            .ToList();

        _incidencias = Data.ObtenerIncidenciasAdmin()
            .Select(i => new Incidencia(i.Id, i.Asunto, i.Prioridad, i.Estado, i.Fecha))
            .ToList();
    }

    // ---- Modal confirmar (aprobar/rechazar) ----
    private bool _showConfirm;
    private PendingAloj? _target;
    private string _accion = "";

    private void PedirConfirmacion(PendingAloj a, string accion)
    {
        _target = a;
        _accion = accion;
        _showConfirm = true;
    }

    private void CerrarConfirm()
    {
        _showConfirm = false;
        _target = null;
    }

    private void ConfirmarAccion()
    {
        if (_target is null) return;
        var nombre = _target.Nombre;
        _pendientes.Remove(_target);
        _mensaje = _accion == "aprobar"
            ? $"\"{nombre}\" fue aprobado y publicado."
            : $"\"{nombre}\" fue rechazado.";
        CerrarConfirm();
    }

    // ---- Modal detalle de denuncia ----
    private bool _showDenuncia;
    private Denuncia? _denunciaSel;

    private void VerDenuncia(Denuncia d)
    {
        _denunciaSel = d;
        _showDenuncia = true;
    }

    // Estado → clase semántica reutilizando .state del sistema.
    private string EstadoState(string estado) => estado switch
    {
        "Resuelto"    => "state--confirmada",
        "En revisión" => "state--pendiente",
        "Abierto"     => "state--pendiente",
        "Cerrado"     => "state--completada",
        _             => "state--completada"
    };
}
