@page "/recuperar-password"
@rendermode InteractiveServer
@layout EmptyLayout

<PageTitle>Bunki - Recuperar Contraseña</PageTitle>

<header>
    <div class="navbar container">
        <a href="/login" class="logo"><i class="fas fa-home"></i> Bunki</a>
    </div>
</header>

<div class="section">
    <div class="container" style="max-width: 420px;">
        <h2 class="section-title">Recuperar Contraseña</h2>

        @if (!EnviadoExito)
        {
            <EditForm Model="Formulario" OnValidSubmit="Enviar">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <InputText @bind-Value="Formulario.Email" type="email" placeholder="tu@ejemplo.com" />
                    <ValidationMessage For="() => Formulario.Email" class="validation-message" />
                </div>

                <p class="card-text" style="margin-bottom: 20px;">
                    Ingresa tu correo electrónico y te enviaremos instrucciones para resetear tu contraseña.
                </p>

                <button type="submit" class="btn btn-primary btn-large" disabled="@Cargando">
                    @if (Cargando)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                    }
                    Enviar Enlace
                </button>
            </EditForm>
        }
        else
        {
            <div style="text-align: center; padding: 30px 0;">
                <div style="font-size: 60px; margin-bottom: 20px;">📧</div>
                <h3 style="margin-bottom: 12px;">¡Revisa tu correo!</h3>
                <p class="card-text">
                    Hemos enviado instrucciones a <strong>@Formulario.Email</strong>.
                    Si no ves el correo, revisa tu carpeta de spam.
                </p>
            </div>
        }

        <p style="text-align: center; margin-top: 20px; color: var(--text-light);">
            ¿Recordaste tu contraseña? <a href="/login" style="color: var(--primary); text-decoration: none;">Inicia sesión</a>
        </p>
    </div>
</div>

<footer>
    <div class="container">
        <p>&copy; 2026 Bunki. Todos los derechos reservados.</p>
    </div>
</footer>

@code {
    private RecuperarPasswordForm Formulario = new();
    private bool Cargando = false;
    private bool EnviadoExito = false;

    private async Task Enviar()
    {
        Cargando = true;
        await Task.Delay(700);
        EnviadoExito = true;
        Cargando = false;
    }
}
