@page "/perfil/documentos"
@inject NavigationManager Navigation

<PageTitle>Bunki - Mis Documentos</PageTitle>

<div class="section">
    <div class="container" style="max-width: 700px;">
        <div class="card" style="padding: 35px; text-align: center;">
            <i class="fas fa-id-card" style="font-size: 50px; color: var(--primary); margin-bottom: 20px;"></i>
            <h2 style="color: var(--text); margin-bottom: 10px;">Verificación de Identidad</h2>
            <p class="card-text" style="margin-bottom: 30px;">Sube tu DNI o Pasaporte para que un administrador verifique tu perfil (RF02).</p>

            @if (!string.IsNullOrEmpty(MensajeExito))
            {
                <div style="background: rgba(46, 204, 113, 0.1); color: #2ecc71; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #2ecc71; font-weight: bold;">
                    <i class="fas fa-check-circle"></i> @MensajeExito
                </div>
            }

            <!-- ZONA DE CARGA INTERACTIVA -->
            <label style="display: block; padding: 40px 20px; border: 2px dashed var(--border); border-radius: 12px; margin-bottom: 20px; background: var(--light); cursor: pointer; transition: 0.3s;">
                <input type="file" accept="image/*,.pdf" style="display: none;" @onchange="ArchivoSeleccionado" />

                <i class="fas @(ArchivoListo ? "fa-file-pdf" : "fa-cloud-upload-alt")"
                   style="font-size: 40px; color: @(ArchivoListo ? "var(--primary)" : "var(--text-light)"); margin-bottom: 15px;"></i>

                <p style="margin: 0; font-weight: bold; color: var(--text); font-size: 16px;">
                    @(ArchivoListo ? "documento_identidad.pdf" : "Haz clic para buscar tu documento")
                </p>

                @if (!ArchivoListo)
                {
                    <small style="color: var(--text-light); display: block; margin-top: 10px;">Formatos aceptados: JPG, PNG o PDF</small>
                }
                else
                {
                    <small style="color: var(--primary); display: block; margin-top: 10px;">¡Archivo cargado y listo para enviar!</small>
                }
            </label>

            <!-- BOTONES -->
            <div style="display: flex; gap: 15px; margin-top: 30px;">
                <button class="btn btn-outline" style="flex: 1;" @onclick='() => Navigation.NavigateTo("/perfil")'>Volver al Perfil</button>
                <button class="btn btn-primary" style="flex: 1;" @onclick="SimularSubida" disabled="@Subiendo">
                    @if (Subiendo)
                    {
                        <i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i>
                        <span>Enviando...</span>
                    }
                    else
                    {
                        <span>Subir Documento</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool ArchivoListo = false;
    private bool Subiendo = false;
    private string MensajeExito = "";

    // Se ejecuta automáticamente cuando el usuario elige un archivo de su PC
    private void ArchivoSeleccionado(ChangeEventArgs e)
    {
        ArchivoListo = true;
        MensajeExito = ""; // Limpia el mensaje si decide cambiar de archivo
    }

    // Simula que el archivo viaja a la base de datos
    private async Task SimularSubida()
    {
        // Si no ha seleccionado nada, forzamos la vista para que no falle la presentación
        if (!ArchivoListo) ArchivoListo = true;

        Subiendo = true;
        await Task.Delay(1200); // Simulamos la barrita de carga
        Subiendo = false;
        MensajeExito = "¡Documento enviado con éxito! Un administrador lo revisará pronto.";
    }
}