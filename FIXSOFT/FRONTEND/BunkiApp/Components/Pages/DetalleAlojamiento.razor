@page "/alojamiento/{Id:int}"
@rendermode InteractiveServer
@inject DataService Data
@inject AlojamientoProvider AlojamientoProvider
@inject ResenaProvider ResenaProvider
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState
@using System.Globalization
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Bunki - @(Alojamiento?.Nombre ?? "Detalle Alojamiento")</PageTitle>

@if (Alojamiento is null)
{
    <div class="section">
        <div class="container">
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-magnifying-glass"></i></div>
                <h2>Alojamiento no encontrado</h2>
                <p>El alojamiento que buscas no existe o ya no está disponible.</p>
                <div class="empty-state-actions">
                    <a href="/explorar" class="btn btn-primary">Volver al explorar</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="section">
        <div class="container">
            <!-- NAVEGACIÓN: volver a Mis Reservas (si venimos de ahí) o breadcrumb normal -->
            @if (VieneDeMisReservas)
            {
                <button type="button" class="detail-back-pill" @onclick="VolverAMisReservas">
                    <span class="detail-back-icon">
                        <i class="fas fa-arrow-left"></i>
                    </span>
                    <span>Volver a Mis Reservas</span>
                </button>
            }
            else
            {
                <div class="breadcrumb">
                    <a href="/explorar">Explorar</a>
                    <span>/</span>
                    <a href="/explorar">@Alojamiento.Distrito</a>
                    <span>/</span>
                    <span>@Alojamiento.Nombre</span>
                </div>
            }

            <div class="two-column">
                <!-- CONTENIDO PRINCIPAL -->
                <div>
                    <!-- GALERÍA -->
                    <div class="gallery">
                        @if (!string.IsNullOrWhiteSpace(Alojamiento.ImagenUrl))
                        {
                            <img src="@Alojamiento.ImagenUrl" alt="@Alojamiento.Nombre" style="width: 100%; height: 400px; object-fit: cover; border-radius: 12px;" />
                        }
                        else
                        {
                            <div class="gallery-image" style="background: @Alojamiento.GradienteColor; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; height: 400px; border-radius: 12px;">
                                <span style="font-size: 72px; line-height: 1;">🏠</span>
                                <span style="font-size: 15px; font-weight: 500; color: rgba(255,255,255,0.9);">Sin imagen</span>
                            </div>
                        }
                    </div>

                    <!-- TÍTULO Y RATING -->
                    <div class="mt-40">
                        <h2 style="margin-bottom: 12px;">@Alojamiento.Nombre</h2>
                        <StarRating Valor="Alojamiento.Rating" TotalResenas="Alojamiento.TotalResenas" />

                        <p style="margin-top: 20px; margin-bottom: 20px; color: var(--text-light); line-height: 1.8;">
                            @Alojamiento.Descripcion
                        </p>

                        <div class="grid grid-3" style="margin-bottom: 20px;">
                            <div class="stat-box">
                                <div class="stat-number">@Alojamiento.MaxHuespedes</div>
                                <div class="stat-label">Huéspedes</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-number">@Alojamiento.Habitaciones</div>
                                <div class="stat-label">Habitaciones</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-number">@Alojamiento.TotalResenas</div>
                                <div class="stat-label">Reseñas</div>
                            </div>
                        </div>

                        <!-- CARACTERÍSTICAS / SERVICIOS -->
                        <h3 style="margin-top: 30px; margin-bottom: 15px;">Características</h3>
                        <div class="grid grid-2" style="margin-bottom: 30px;">
                            @foreach (var servicio in Alojamiento.Servicios)
                            {
                                <p>
                                    <i class="fas fa-check" style="color: var(--success); margin-right: 10px;"></i>
                                    @servicio
                                </p>
                            }
                        </div>

                        <!-- SOBRE EL ANFITRIÓN -->
                        <h3 style="margin-top: 30px; margin-bottom: 15px;">Sobre el Anfitrión</h3>
                        <div class="info-panel flex flex-between" style="align-items: center;">
                            <div class="flex gap-15 items-center">
                                <div class="avatar avatar-large">@Alojamiento.AnfitrionInicial</div>
                                <div>
                                    <h4>@Alojamiento.AnfitrionNombre</h4>
                                    <p class="card-text">Anfitrión desde @Alojamiento.AnfitrionDesde</p>
                                    <p style="margin-top: 8px;">
                                        <span class="badge badge-success">Anfitrión Verificado</span>
                                    </p>
                                </div>
                            </div>
                            <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/mensajes")'>
                                Contactar
                            </button>
                        </div>

                        <!-- RESEÑAS -->
                        <h3 style="margin-top: 30px; margin-bottom: 15px;">Reseñas (@Alojamiento.TotalResenas)</h3>
                        <div style="border-top: 1px solid var(--border); padding-top: 20px;">
                            @if (Alojamiento.Resenas.Any())
                            {
                                @foreach (var resena in Alojamiento.Resenas)
                                {
                                    <div style="padding: 15px 0; border-bottom: 1px solid var(--border);">
                                        <div class="flex flex-between">
                                            <div>
                                                <strong>@resena.AutorNombre</strong>
                                                <div class="rating" style="margin-top: 5px;">
                                                    <span class="star">@GenerarEstrellas(resena.Estrellas)</span>
                                                </div>
                                            </div>
                                            <span class="card-text">@(resena.FechaPublicacion?.ToString("dd MMM yyyy") ?? "")</span>
                                        </div>
                                        <p class="card-text" style="margin-top: 10px;">@resena.Comentario</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="card-text">Aún no hay reseñas para este alojamiento.</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- SIDEBAR RESERVA -->
                <div class="sidebar">
                    <div class="info-panel" style="padding: 24px; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg);">
                        <h3 class="price price-lg" style="margin-bottom: 20px;">
                            @AppState.FormatearPrecio(Alojamiento.PrecioNoche)<span class="price-unit"> por noche</span>
                        </h3>

                        <div class="form-group">
                            <label>Fecha de Entrada</label>
                            <input type="text"
                                   id="detalle-fecha-entrada"
                                   class="detalle-flatpickr"
                                   placeholder="dd/mm/aaaa"
                                   value="@FormatPickerDate(FechaEntrada)"
                                   @onchange="OnFechaEntradaChanged"
                                   autocomplete="off" />
                        </div>

                        <div class="form-group">
                            <label>Fecha de Salida</label>
                            <input type="text"
                                   id="detalle-fecha-salida"
                                   class="detalle-flatpickr"
                                   placeholder="dd/mm/aaaa"
                                   value="@FormatPickerDate(FechaSalida)"
                                   @onchange="OnFechaSalidaChanged"
                                   autocomplete="off" />
                        </div>

                        <div class="form-group">
                            <label>Número de Huéspedes</label>
                            <InputSelect @bind-Value="NumHuespedes">
                                @for (int i = 1; i <= Alojamiento.MaxHuespedes; i++)
                                {
                                    int n = i;
                                    <option value="@n">@n @(n == 1 ? "huésped" : "huéspedes")</option>
                                }
                            </InputSelect>
                        </div>

                        <!-- RESUMEN DE PRECIOS -->
                        @if (Noches > 0)
                        {
                            <div class="info-panel" style="margin-bottom: 20px;">

                                <div class="summary-row">
                                    <span>@AppState.FormatearPrecio(Alojamiento.PrecioNoche) × @Noches noches</span>
                                    <span>@AppState.FormatearPrecio(Subtotal)</span>
                                </div>

                                <div class="summary-row">
                                    <span>Limpieza</span>
                                    <span>@AppState.FormatearPrecio(Alojamiento.TarifaLimpieza)</span>
                                </div>

                                <div class="summary-row">
                                    <span>Comisión de servicio</span>
                                    <span>@AppState.FormatearPrecio(Comision)</span>
                                </div>

                                <div class="summary-row summary-row--total">
                                    <span>Total</span>
                                    <span class="price">@AppState.FormatearPrecio(Total)</span>
                                </div>

                                @if (AppState.MonedaEsReferencial)
                                {
                                    <p class="summary-note">Conversión referencial. El cobro se realiza en S/ (PEN).</p>
                                }

                            </div>
                        }

                        @if (!AppState.EstaAutenticado)
                        {
                            <div class="info-panel info-panel--gold login-required-card">
                                <div class="login-required-icon">
                                    <i class="fas fa-lock"></i>
                                </div>

                                <p class="login-required-text">
                                    Debes iniciar sesión o registrarte para continuar.
                                </p>

                                <div class="login-required-actions">
                                    <a href="/login" class="btn btn-primary btn-small">Iniciar Sesión</a>
                                    <a href="/registro" class="btn btn-outline btn-small">Registrarse</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-large" @onclick="Reservar" disabled="@(Noches == 0)">
                                @if (Noches > 0)
                                {
                                    <span>Reservar Ahora</span>
                                }
                                else
                                {
                                    <span>Selecciona las fechas</span>
                                }
                            </button>
                            <p style="margin-top: 12px; color: var(--text-light); font-size: 12px; text-align: center;">
                                No se cobra nada por ahora
                            </p>
                        }

                        <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border);">
                            <button class="btn btn-outline" style="width: 100%;" @onclick="ToggleFavorito">
                                <i class="fas fa-heart" style="color: @(EsFavorito ? "var(--danger)" : "inherit");"></i>
                                @(EsFavorito ? "Guardado" : "Guardar")
                            </button>
                        </div>
                    </div>

                    <!-- INFORMACIÓN IMPORTANTE -->
                    <div class="card" style="margin-top: 20px;">
                        <div style="padding: 20px;">
                            <h4 style="margin-bottom: 15px;">Información Importante</h4>
                            <p class="card-text"><strong>Cancelación:</strong> @Alojamiento.PoliticaCancelacion</p>
                            <p class="card-text" style="margin-top: 10px;"><strong>Entrada:</strong> Flexible</p>
                            <p class="card-text" style="margin-top: 10px;"><strong>Reglas:</strong> @Alojamiento.Reglas</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "entrada")]
    public DateTime? EntradaQuery { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "salida")]
    public DateTime? SalidaQuery { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "huespedes")]
    public int? HuespedesQuery { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "origen")]
    public string? OrigenQuery { get; set; }

    private bool VieneDeMisReservas =>
        string.Equals(OrigenQuery, "mis-reservas", StringComparison.OrdinalIgnoreCase);

    private bool queryAplicada = false;

    protected override void OnInitialized() => AppState.OnChange += OnMonedaChanged;
    public void Dispose() => AppState.OnChange -= OnMonedaChanged;
    private void OnMonedaChanged() => InvokeAsync(StateHasChanged);

    private Alojamiento? Alojamiento;
    private DateTime? FechaEntrada;
    private DateTime? FechaSalida;
    private int NumHuespedes = 1;
    private bool EsFavorito = false;
    private int FotoActiva = 0;
    private bool _pickerInicializado = false;

    private string FechaMinima => DateTime.Today.ToString("yyyy-MM-dd");
    private int Noches => (FechaSalida.HasValue && FechaEntrada.HasValue && FechaSalida > FechaEntrada)
        ? (FechaSalida.Value - FechaEntrada.Value).Days : 0;

    private decimal Subtotal => Alojamiento is null ? 0 : Alojamiento.PrecioNoche * Noches;
    private decimal Comision => Subtotal * 0.10m;
    private decimal Total => Subtotal + (Alojamiento?.TarifaLimpieza ?? 0) + Comision;

    protected override async Task OnParametersSetAsync()
    {
        // Fuente de datos: REST con fallback automático a mock (provider).
        Alojamiento = await AlojamientoProvider.ObtenerPorIdAsync(Id);

        // Reseñas reales vía REST (GET ResenaRS/alojamiento/{id}); con fallback en el provider.
        // Si algo falla, la página sigue mostrando el alojamiento, solo sin reseñas.
        if (Alojamiento is not null)
        {
            try
            {
                var resenas = await ResenaProvider.ListarPorAlojamientoAsync(Id);
                if (resenas is not null && resenas.Count > 0)
                {
                    Alojamiento.Resenas = resenas;
                    Alojamiento.TotalResenas = resenas.Count;
                    Alojamiento.Rating = resenas.Average(r => (double)r.Estrellas);
                }
            }
            catch (Exception)
            {
                // No rompemos la página si el REST de reseñas falla.
            }
        }

        if (!queryAplicada && Alojamiento is not null)
        {
            if (EntradaQuery.HasValue)
                FechaEntrada = EntradaQuery.Value;

            if (SalidaQuery.HasValue)
                FechaSalida = SalidaQuery.Value;

            if (HuespedesQuery.HasValue)
                NumHuespedes = Math.Clamp(HuespedesQuery.Value, 1, Alojamiento.MaxHuespedes);

            queryAplicada = true;
        }
    }
    private string GenerarEstrellas(double rating)
    {
        int llenas = (int)Math.Round(rating);
        return string.Concat(Enumerable.Range(0, 5).Select(i => i < llenas ? "★" : "☆"));
    }

    private void ToggleFavorito() => EsFavorito = !EsFavorito;

    private void Reservar()
    {
        if (!AppState.EstaAutenticado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (Alojamiento is null || Noches == 0 || !FechaEntrada.HasValue || !FechaSalida.HasValue)
            return;

        var url = $"/pagos?alojamientoId={Alojamiento.Id}" +
                  $"&entrada={FechaEntrada.Value:yyyy-MM-dd}" +
                  $"&salida={FechaSalida.Value:yyyy-MM-dd}" +
                  $"&huespedes={NumHuespedes}";

        Navigation.NavigateTo(url);
    }
    // minDate por campo: "today" para reservar nuevo; si la fecha precargada es
    // anterior a hoy (reserva existente desde Mis Reservas), usamos esa fecha como
    // mínimo para que Flatpickr pueda mostrarla en vez de descartarla.
    private string MinDateFor(DateTime? fecha) =>
        fecha.HasValue && fecha.Value.Date < DateTime.Today
            ? fecha.Value.ToString("yyyy-MM-dd")
            : "today";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // El alojamiento se carga async (REST), así que los inputs del calendario recién existen
        // cuando Alojamiento != null. Inicializamos Flatpickr en el primer render en que los inputs
        // YA están en el DOM (no en firstRender, que puede ocurrir mientras el alojamiento aún carga).
        if (Alojamiento is not null && !_pickerInicializado)
        {
            _pickerInicializado = true;
            await JS.InvokeVoidAsync("bunkiDatePicker.initDetalle", "#detalle-fecha-entrada",
                new { minDate = MinDateFor(FechaEntrada) });
            await JS.InvokeVoidAsync("bunkiDatePicker.initDetalle", "#detalle-fecha-salida",
                new { minDate = MinDateFor(FechaSalida) });
        }
    }

    private string FormatPickerDate(DateTime? fecha)
    {
        // Formato visible del input de Detalle (coincide con dateFormat "d/m/Y").
        return fecha?.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "";
    }

    private void OnFechaEntradaChanged(ChangeEventArgs e)
    {
        FechaEntrada = ParsePickerDate(e.Value?.ToString());

        if (FechaEntrada.HasValue && FechaSalida.HasValue && FechaSalida <= FechaEntrada)
        {
            FechaSalida = null;
        }
    }

    private void OnFechaSalidaChanged(ChangeEventArgs e)
    {
        FechaSalida = ParsePickerDate(e.Value?.ToString());
    }

    private DateTime? ParsePickerDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        // Formato visible del picker de Detalle.
        if (DateTime.TryParseExact(value, "dd/MM/yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var fecha))
            return fecha;

        // Formato ISO (por si llega desde query/value en yyyy-MM-dd).
        if (DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out fecha))
            return fecha;

        // Fallback genérico.
        if (DateTime.TryParse(value, out fecha))
            return fecha;

        return null;
    }
    private async Task VolverAMisReservas()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
