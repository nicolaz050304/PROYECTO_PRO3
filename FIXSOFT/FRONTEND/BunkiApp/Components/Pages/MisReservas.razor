@page "/mis-reservas"
@rendermode InteractiveServer
@inject DataService Data
@inject ReservaProvider ReservaProvider
@inject ResenaProvider ResenaProvider
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState
<PageTitle>Bunki - Mis Reservas</PageTitle>

<div class="section">
    <div class="container">
        <header class="page-head">
            <span class="eyebrow">Tu actividad</span>
            <h1 class="page-head-title">Mis Reservas</h1>
            <p class="page-head-sub">Gestiona tus próximas estadías, revisa tu historial y mantén todo bajo control.</p>
        </header>

        @if (!string.IsNullOrEmpty(MensajeAccion))
        {
            <AlertMessage Tipo="success" Mensaje="@MensajeAccion" />
        }

        <!-- TABS -->
        <div class="tabs">
            @foreach (var tab in Tabs)
            {
                <button class="tab-btn @(TabActiva == tab ? "active" : "")"
                        @onclick="() => CambiarTab(tab)">
                    @tab
                    <span class="tab-count">@ContarReservasPorTab(tab)</span>
                </button>
            }
        </div>

        <!-- CONTENIDO -->
        @if (TabActiva == "Próximas")
        {
            @if (!Proximas.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-calendar-day"></i></div>
                    <h3>No tienes reservas próximas</h3>
                    <p>Cuando reserves un alojamiento, aparecerá aquí con sus fechas y detalles.</p>
                    <div class="empty-state-actions">
                        <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/explorar")'>Explorar alojamientos</button>
                    </div>
                </div>
            }
            else
            {
                @foreach (var r in Proximas)
                {
                    <ReservaCard Reserva="r"
                                 OnCancelarReserva="CancelarReserva"
                                 OnDejarResenaCallback="DejarResena" />
                }
            }
        }
        else if (TabActiva == "Pasadas")
        {
            @if (!Pasadas.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-clock-rotate-left"></i></div>
                    <h3>Aún no tienes reservas pasadas</h3>
                    <p>Tu historial de estancias completadas se mostrará aquí.</p>
                </div>
            }
            else
            {
                @foreach (var r in Pasadas)
                {
                    <ReservaCard Reserva="r"
                                 OnCancelarReserva="CancelarReserva"
                                 OnDejarResenaCallback="DejarResena" />
                }
            }
        }
        else
        {
            @if (!Canceladas.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-circle-check"></i></div>
                    <h3>No tienes reservas canceladas</h3>
                    <p>Las reservas que canceles quedarán registradas aquí.</p>
                </div>
            }
            else
            {
                @foreach (var r in Canceladas)
                {
                    <ReservaCard Reserva="r" />
                }
            }
        }
    </div>
</div>

@if (MostrarModalResena && ReservaParaResenar is not null)
{
    <div class="modal-overlay" @onclick="CerrarModalResena">
        <div class="modal-panel" style="max-width: 480px; text-align: left;" @onclick:stopPropagation="true">
            <div class="flex flex-between" style="margin-bottom: 6px;">
                <h2 style="margin: 0;">Reseñar tu estadía</h2>
                <button @onclick="CerrarModalResena" aria-label="Cerrar"
                        style="background: none; border: none; cursor: pointer; font-size: 20px; color: var(--ink-faint);">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
            <p class="card-text" style="margin-bottom: 20px;">
                @ReservaParaResenar.AlojamientoNombre
            </p>

            <div class="form-group">
                <label>Tu calificación</label>
                <div class="rating" style="font-size: 28px; gap: 4px;">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var estrella = i;
                        <span class="star"
                              style="cursor: pointer;"
                              @onclick="() => EstrellasSeleccionadas = estrella">
                            @(estrella <= EstrellasSeleccionadas ? "★" : "☆")
                        </span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label for="comentarioResena">Tu comentario</label>
                <textarea id="comentarioResena"
                          rows="4"
                          maxlength="500"
                          placeholder="Cuéntanos cómo fue tu experiencia (mínimo 10 caracteres)..."
                          @bind="ComentarioResena"
                          @bind:event="oninput"></textarea>
                <p class="field-help">
                    @(ComentarioResena?.Trim().Length ?? 0) / 10 caracteres mínimos
                </p>
            </div>

            @if (!string.IsNullOrEmpty(ErrorResena))
            {
                <div style="margin-top: 14px;">
                    <AlertMessage Tipo="danger" Mensaje="@ErrorResena" />
                </div>
            }

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button class="btn btn-outline" style="flex: 1;"
                        @onclick="CerrarModalResena" disabled="@EnviandoResena">
                    Cancelar
                </button>
                <button class="btn btn-primary" style="flex: 1;"
                        @onclick="EnviarResena" disabled="@EnviandoResena">
                    @(EnviandoResena ? "Enviando..." : "Enviar reseña")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] Tabs = { "Próximas", "Pasadas", "Canceladas" };
    private string TabActiva = "Próximas";
    private string MensajeAccion = "";

    private List<Reserva> Proximas = new();
    private List<Reserva> Pasadas = new();
    private List<Reserva> Canceladas = new();

    // --- Estado del modal de reseña ---
    private bool MostrarModalResena = false;
    private Reserva? ReservaParaResenar = null;
    private int EstrellasSeleccionadas = 0;
    private string ComentarioResena = "";
    private string ErrorResena = "";
    private bool EnviandoResena = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.EstaAutenticado) { Navigation.NavigateTo("/login"); return; }

        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        // Fuente: REST con fallback automático a mock (provider).
        Proximas = await ReservaProvider.ListarProximasAsync();
        Pasadas = await ReservaProvider.ListarPasadasAsync();
        Canceladas = await ReservaProvider.ListarCanceladasAsync();
    }

    private void CambiarTab(string tab) => TabActiva = tab;

    private int ContarReservasPorTab(string tab) => tab switch
    {
        "Próximas" => Proximas.Count,
        "Pasadas" => Pasadas.Count,
        "Canceladas" => Canceladas.Count,
        _ => 0
    };

    private void CancelarReserva(Reserva reserva)
    {
        Proximas.Remove(reserva);
        reserva.Estado = "Cancelada";
        Canceladas.Add(reserva);
        MensajeAccion = $"Reserva en {reserva.AlojamientoNombre} cancelada correctamente.";
    }

    private void DejarResena(Reserva reserva)
    {
        ReservaParaResenar = reserva;
        EstrellasSeleccionadas = 0;
        ComentarioResena = "";
        ErrorResena = "";
        MostrarModalResena = true;
    }

    private async Task EnviarResena()
    {
        ErrorResena = "";
        if (EstrellasSeleccionadas < 1 || EstrellasSeleccionadas > 5)
        { ErrorResena = "Selecciona una calificación de 1 a 5 estrellas."; return; }
        if (string.IsNullOrWhiteSpace(ComentarioResena) || ComentarioResena.Trim().Length < 10)
        { ErrorResena = "El comentario debe tener al menos 10 caracteres."; return; }
        if (ReservaParaResenar is null) return;

        EnviandoResena = true;
        try
        {
            var nueva = new Resena
            {
                Estrellas = EstrellasSeleccionadas,
                Comentario = ComentarioResena.Trim(),
                ReservaId = ReservaParaResenar.Id,
                AlojamientoId = ReservaParaResenar.AlojamientoId,
                TipoAutor = "INVITADO",
                Activo = true
            };
            await ResenaProvider.RegistrarAsync(nueva);
            MensajeAccion = $"¡Gracias por tu reseña sobre {ReservaParaResenar.AlojamientoNombre}!";
            MostrarModalResena = false;
        }
        catch (Exception)
        {
            ErrorResena = "No se pudo enviar la reseña. Intenta de nuevo.";
        }
        finally { EnviandoResena = false; }
    }

    private void CerrarModalResena() => MostrarModalResena = false;
}
