@page "/admin"
@layout AdminLayout
@rendermode InteractiveServer
@inject DataService Data
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState

<PageTitle>Bunki Admin · Dashboard</PageTitle>

<!-- ENCABEZADO -->
<div class="admin-dash-head">
    <div>
        @* Título quitado: ya lo muestra el topbar del AdminLayout (evitamos el doble título). *@
        <p class="admin-page-sub admin-page-sub--flush">Resumen general de la plataforma Bunki.</p>
    </div>
    <span class="admin-pill"><i class="fas fa-shield-halved"></i> Admin</span>
</div>

<!-- KPIs · derivados de DataService (ObtenerEstadisticasAdmin). Las tendencias son
     mock visual temporal: no hay serie histórica para calcular variación real. -->
<div class="admin-kpis">
    @* Números de KPI en neutral (--ink): el color azul/verde/dorado sobre conteos no aporta lógica.
       El color queda solo para el indicador de tendencia (flecha). El de dinero sí conserva su tono. *@
    <StatBox Valor="@Stats.Usuarios.ToString("N0")" Etiqueta="Usuarios registrados" Icono="fa-users"
             Tono="neutral" Tendencia="+12% vs. mes anterior" TendenciaTono="up" />
    <StatBox Valor="@Stats.Alojamientos.ToString("N0")" Etiqueta="Alojamientos" Icono="fa-house"
             Tono="neutral" Tendencia="+5% vs. mes anterior" TendenciaTono="up" />
    <StatBox Valor="@Stats.Reservas.ToString("N0")" Etiqueta="Reservas registradas" Icono="fa-calendar-check"
             Tono="neutral" Tendencia="+8% vs. mes anterior" TendenciaTono="up" />
    <StatBox Valor="@($"S/ {Stats.Ingresos.ToString("N0")}")" Etiqueta="Ingresos cobrados" Icono="fa-sack-dollar"
             Tono="dinero" Tendencia="+10% vs. mes anterior" TendenciaTono="up" />
</div>

<!-- PENDIENTES CRÍTICOS -->
<h2 class="admin-section-label">Pendientes críticos</h2>
<div class="admin-alerts">
    <a href="/admin/moderacion" class="admin-card admin-alert">
        <span class="admin-alert-icon"><i class="fas fa-clipboard-check"></i></span>
        <span class="admin-alert-body">
            <span class="admin-alert-count">@_porAprobar</span>
            <span class="admin-alert-label">Alojamientos por aprobar</span>
        </span>
        <i class="fas fa-chevron-right admin-alert-arrow" aria-hidden="true"></i>
    </a>

    <a href="/admin/moderacion?tab=denuncias" class="admin-card admin-alert">
        <span class="admin-alert-icon admin-alert-icon--warn"><i class="fas fa-flag"></i></span>
        <span class="admin-alert-body">
            <span class="admin-alert-count">@_denunciasNuevas</span>
            <span class="admin-alert-label">Denuncias nuevas</span>
        </span>
        <i class="fas fa-chevron-right admin-alert-arrow" aria-hidden="true"></i>
    </a>

    <a href="/admin/incidencias" class="admin-card admin-alert">
        <span class="admin-alert-icon admin-alert-icon--danger"><i class="fas fa-triangle-exclamation"></i></span>
        <span class="admin-alert-body">
            <span class="admin-alert-count">@_incidenciasAbiertas</span>
            <span class="admin-alert-label">Incidencias abiertas</span>
        </span>
        <i class="fas fa-chevron-right admin-alert-arrow" aria-hidden="true"></i>
    </a>
</div>

<!-- ACTIVIDAD + ACCESOS -->
<div class="admin-cols">

    <div class="admin-card">
        <h2 class="admin-card-title"><i class="fas fa-clock-rotate-left"></i> Actividad reciente</h2>
        <ul class="admin-activity">
            <li>
                <span class="admin-activity-dot"></span>
                <span class="admin-activity-text">
                    <strong>Juan Pérez</strong> creó el alojamiento “Casa Playa”
                    <span class="admin-activity-time">hace 2 horas</span>
                </span>
            </li>
            <li>
                <span class="admin-activity-dot admin-activity-dot--success"></span>
                <span class="admin-activity-text">
                    Denuncia <strong>#REP001</strong> resuelta
                    <span class="admin-activity-time">hace 5 horas</span>
                </span>
            </li>
            <li>
                <span class="admin-activity-dot admin-activity-dot--warn"></span>
                <span class="admin-activity-text">
                    Incidencia <strong>INC004</strong> abierta
                    <span class="admin-activity-time">hace 8 horas</span>
                </span>
            </li>
            <li>
                <span class="admin-activity-dot admin-activity-dot--danger"></span>
                <span class="admin-activity-text">
                    <strong>María López</strong> fue bloqueada
                    <span class="admin-activity-time">ayer</span>
                </span>
            </li>
        </ul>
    </div>

    <div class="admin-card">
        <h2 class="admin-card-title"><i class="fas fa-bolt"></i> Accesos rápidos</h2>
        <nav class="admin-quick" aria-label="Accesos rápidos del panel">
            <a href="/admin/moderacion" class="admin-quick-link">
                <i class="fas fa-scale-balanced" aria-hidden="true"></i>
                <span>Ir a Moderación</span>
                <i class="fas fa-chevron-right admin-quick-arrow" aria-hidden="true"></i>
            </a>
            <a href="/admin/usuarios" class="admin-quick-link">
                <i class="fas fa-users" aria-hidden="true"></i>
                <span>Ver Usuarios</span>
                <i class="fas fa-chevron-right admin-quick-arrow" aria-hidden="true"></i>
            </a>
            <a href="/admin/reportes-financieros" class="admin-quick-link">
                <i class="fas fa-coins" aria-hidden="true"></i>
                <span>Ver Reportes</span>
                <i class="fas fa-chevron-right admin-quick-arrow" aria-hidden="true"></i>
            </a>
            <a href="/admin/analytics" class="admin-quick-link">
                <i class="fas fa-chart-line" aria-hidden="true"></i>
                <span>Ver Analytics</span>
                <i class="fas fa-chevron-right admin-quick-arrow" aria-hidden="true"></i>
            </a>
            <a href="/admin/incidencias" class="admin-quick-link">
                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                <span>Ver Incidencias</span>
                <i class="fas fa-chevron-right admin-quick-arrow" aria-hidden="true"></i>
            </a>
        </nav>
    </div>
</div>

@code {
    private (int Usuarios, int Alojamientos, int Reservas, decimal Ingresos) Stats;

    // Contadores de "Pendientes críticos" derivados de la MISMA fuente que usan
    // /admin/moderacion y /admin/incidencias, para que siempre coincidan.
    private int _porAprobar;
    private int _denunciasNuevas;
    private int _incidenciasAbiertas;

    protected override void OnInitialized()
    {
        if (!AppState.EstaAutenticado || !AppState.EsAdmin())
        {
            Navigation.NavigateTo("/");
            return;
        }

        Stats = Data.ObtenerEstadisticasAdmin();

        _porAprobar = Data.ObtenerAlojamientosPorAprobar().Count;
        _denunciasNuevas = Data.ObtenerDenunciasAdmin().Count(d => d.Estado == "En revisión");
        _incidenciasAbiertas = Data.ObtenerIncidenciasAdmin().Count(i => i.Estado == "Abierto");
    }
}
