@page "/"
@rendermode InteractiveServer
@inject DataService Data
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState

<PageTitle>Bunki - Encuentra tu próximo hogar</PageTitle>

<!-- HERO -->
<div class="hero">
    <div class="container">
        <h1>Encuentra tu próximo hogar</h1>
        <p>Explora miles de alojamientos únicos en Perú</p>
        <button class="btn btn-secondary" style="display: inline-block;"
                @onclick='() => Navigation.NavigateTo("/explorar")'>
            Comienza a explorar
        </button>
        @if (!AppState.EstaAutenticado)
        {
            <a href="/registro" class="btn btn-outline"
               style="display: inline-block; margin-left: 12px; border-color: rgba(255,255,255,0.6); color: white;">
                Crear cuenta gratis
            </a>
        }
    </div>
</div>

<!-- ALOJAMIENTOS DESTACADOS -->
<div class="section">
    <div class="container">
        <h2 class="section-title">Alojamientos Destacados</h2>
        <div class="grid grid-3">
            @foreach (var alojamiento in AlojamientosDestacados)
            {
                <AlojamientoCard Alojamiento="alojamiento" />
            }
        </div>
    </div>
</div>

<!-- POR QUÉ BUNKI -->
<div class="section bg-light">
    <div class="container">
        <h2 class="section-title">¿Por qué elegir Bunki?</h2>
        <div class="grid grid-3">
            <StatBox Icono="🏠" Valor="10,000+" Etiqueta="Alojamientos disponibles" />
            <StatBox Icono="✓" Valor="100%" Etiqueta="Transacciones seguras" />
            <StatBox Icono="⭐" Valor="4.8" Etiqueta="Rating promedio" />
        </div>
    </div>
</div>

@code {
    private List<Alojamiento> AlojamientosDestacados = new();

    protected override void OnInitialized()
    {
        AlojamientosDestacados = Data.ObtenerAlojamientos().Take(3).ToList();
    }
}
