@page "/"
@rendermode InteractiveServer
@inject DataService Data
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState
@inject IJSRuntime JS
@using System.Globalization

<PageTitle>Bunki - Encuentra estadías extraordinarias en Perú</PageTitle>

<!-- ===== HERO CINEMATOGRÁFICO ===== -->
<section class="hero-home" style="@HeroStyle">
    <div class="hero-home-inner container">
        <span class="hero-eyebrow">Alojamientos seleccionados en Perú</span>
        @* Firma editorial: la palabra clave en Fraunces itálica + champán (.editorial-accent).
           Es la "voz" que se repite en los títulos de sección y rima con las citas de los testimonios. *@
        <h1>Encuentra estadías <span class="editorial-accent">extraordinarias</span></h1>
        <p class="hero-sub">
            Alojamientos elegidos para viajes, descanso y experiencias memorables —
            reservados con la confianza de una plataforma profesional.
        </p>

        <!-- Buscador estilo Airbnb integrado -->
        <div class="search-card">
            <div class="search-field">
                <label>Ubicación</label>
                <input type="text" placeholder="¿A dónde vas?" @bind="Ubicacion" @bind:event="oninput" />
            </div>
            <div class="search-field">
                <label>Entrada</label>
                <input class="flatpickr-date"
                       type="text"
                       placeholder="dd/mm/aaaa"
                       value="@FormatPickerDate(FechaEntrada)"
                       @onchange="OnFechaEntradaChanged"
                       autocomplete="off" />
            </div>
            <div class="search-field">
                <label>Salida</label>
                <input class="flatpickr-date"
                       type="text"
                       placeholder="dd/mm/aaaa"
                       value="@FormatPickerDate(FechaSalida)"
                       @onchange="OnFechaSalidaChanged"
                       autocomplete="off" />
            </div>
            <div class="search-field search-field-guests">
                <label>Huéspedes</label>

                <div class="guest-chip-group">
                    <button type="button"
                            class="guest-chip @(Huespedes == 1 ? "active" : "")"
                            @onclick="() => Huespedes = 1">
                        1
                    </button>

                    <button type="button"
                            class="guest-chip @(Huespedes == 2 ? "active" : "")"
                            @onclick="() => Huespedes = 2">
                        2
                    </button>

                    <button type="button"
                            class="guest-chip @(Huespedes == 3 ? "active" : "")"
                            @onclick="() => Huespedes = 3">
                        3
                    </button>

                    <button type="button"
                            class="guest-chip @(Huespedes == 4 ? "active" : "")"
                            @onclick="() => Huespedes = 4">
                        4+
                    </button>
                </div>
            </div>
            <button class="btn btn-primary search-submit" @onclick="Buscar">
                <i class="fas fa-search"></i> Buscar
            </button>
        </div>

        <div class="hero-links">
            <a href="/explorar" class="hero-link">
                <i class="fas fa-compass"></i> Explorar todos los alojamientos
            </a>
            @if (!AppState.EstaAutenticado)
            {
                <a href="/registro" class="hero-link hero-link--accent">Crear cuenta gratis</a>
            }
        </div>
    </div>
</section>

<!-- ===== ALOJAMIENTOS DESTACADOS ===== -->
@* section--feature: el carrusel es el contenido estrella, así que respira más que el resto (ritmo no
   uniforme). data-reveal: la sección entra al hacer scroll (IntersectionObserver / scroll-reveal.js). *@
<div class="section section--feature" data-reveal>
    <div class="container">
        @* Sin eyebrow dorado de sección: repetirlo en cada bloque es "gramática de IA"; el título serif
           (Fraunces) tiene peso suficiente para liderar. Solo el hero conserva su kicker de apertura. *@
        <div class="section-head">
            <div class="section-head-text">
                <h2 class="section-title editorial-title">Alojamientos <span class="editorial-accent">destacados</span></h2>
                <p class="section-subtitle">Una muestra de las estadías mejor valoradas por nuestros huéspedes.</p>
            </div>
            <a href="/explorar" class="section-link">Ver todos <i class="fas fa-arrow-right"></i></a>
        </div>

        @* Carrusel: reutiliza <AlojamientoCard> tal cual (tarjetas idénticas al resto). Las flechas, los
           puntos y el autoplay los controla /js/carrusel.js, inicializado vía interop igual que el datepicker. *@
        <div class="carrusel" id="carruselDestacados">
            <button type="button" class="carrusel-flecha carrusel-flecha--prev" aria-label="Anterior">‹</button>
            <div class="carrusel-track">
                @foreach (var alojamiento in AlojamientosDestacados)
                {
                    <div class="carrusel-item">
                        <AlojamientoCard Alojamiento="alojamiento" />
                    </div>
                }
            </div>
            <button type="button" class="carrusel-flecha carrusel-flecha--next" aria-label="Siguiente">›</button>
            <div class="carrusel-dots"></div>  @* los puntos se generan desde el JS según el nº de páginas *@
        </div>
    </div>
</div>

<!-- ===== CATEGORÍAS ("¿Qué clase de estadía buscas?") ===== -->
@* section--tight: se acerca a los destacados para leerse como un bloque de exploración (ritmo). *@
<div class="section section--tight" data-reveal>
    <div class="container">
        <div class="section-head section-head--center">
            <div class="section-head-text">
                <h2 class="section-title editorial-title">¿Qué clase de <span class="editorial-accent">estadía</span> buscas?</h2>
            </div>
        </div>

        @* Tarjetas de categoría en grid: ícono grande arriba + nombre debajo, centrados. Cada una es un
           punto de entrada visual al catálogo: por ahora solo navega a /explorar (no aplica filtro todavía).
           data-reveal-group: las tarjetas entran en cascada (escalonado) cuando el grid llega al viewport. *@
        <div class="categorias-grid" data-reveal-group>
            <a href="/explorar" class="categoria-card">
                <span class="categoria-icon"><i class="fas fa-house"></i></span>
                <span class="categoria-nombre">Casas</span>
            </a>
            <a href="/explorar" class="categoria-card">
                <span class="categoria-icon"><i class="fas fa-building"></i></span>
                <span class="categoria-nombre">Departamentos</span>
            </a>
            <a href="/explorar" class="categoria-card">
                <span class="categoria-icon"><i class="fas fa-bed"></i></span>
                <span class="categoria-nombre">Habitaciones</span>
            </a>
            <a href="/explorar" class="categoria-card">
                <span class="categoria-icon"><i class="fas fa-umbrella-beach"></i></span>
                <span class="categoria-nombre">Playa</span>
            </a>
            <a href="/explorar" class="categoria-card">
                <span class="categoria-icon"><i class="fas fa-city"></i></span>
                <span class="categoria-nombre">Ciudad</span>
            </a>
            <a href="/explorar" class="categoria-card">
                <span class="categoria-icon"><i class="fas fa-tree"></i></span>
                <span class="categoria-nombre">Campo</span>
            </a>
        </div>
    </div>
</div>

<!-- ===== POR QUÉ BUNKI ===== -->
<div class="section bg-light" data-reveal>
    <div class="container">
        @* Cabecera centrada vía clase .section-head--center (antes con estilos inline duplicados). *@
        <div class="section-head section-head--center">
            <div class="section-head-text">
                <h2 class="section-title editorial-title">Reserva con <span class="editorial-accent">tranquilidad</span></h2>
            </div>
        </div>
        @* grid--trio: fija 3 columnas iguales para las filas de exactamente 3 ítems del Home, evitando
           la columna vacía a la derecha que dejaba el auto-fill de .grid-3 en pantallas anchas.
           data-reveal-group: las tres señales de confianza entran escalonadas. *@
        <div class="grid grid-3 grid--trio" data-reveal-group>
            @* Señales de confianza CUALITATIVAS: evitamos cifras infladas/no verificables (antes "10,000+",
               "100%", "4.8") que restan credibilidad. Mensajes honestos sobre lo que sí garantizamos. *@
            <StatBox Tono="neutral" Icono="fa-user-check" Valor="Anfitriones verificados" Etiqueta="" />
            <StatBox Tono="neutral" Icono="fa-shield-halved" Valor="Pago protegido" Etiqueta="" />
            <StatBox Tono="neutral" Icono="fa-headset" Valor="Soporte en español" Etiqueta="" />
        </div>
    </div>
</div>

<!-- ===== TESTIMONIOS ("Lo que dicen nuestros huéspedes") ===== -->
<div class="section" data-reveal>
    <div class="container">
        <div class="section-head section-head--center">
            <div class="section-head-text">
                <h2 class="section-title editorial-title">Lo que dicen nuestros <span class="editorial-accent">huéspedes</span></h2>
            </div>
        </div>

        @* Testimonios estáticos curados: práctica habitual en una landing. No provienen del backend ni
           pretenden ser métricas; son opiniones personales de ejemplo.
           data-reveal-group: las tres tarjetas de opinión entran escalonadas al hacer scroll. *@
        <div class="grid grid-3 grid--trio" data-reveal-group>
            <figure class="testimonial">
                <div class="testimonial-stars" aria-label="5 de 5 estrellas">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </div>
                <blockquote class="testimonial-quote">
                    El departamento superó nuestras expectativas. La ubicación en Miraflores es inmejorable
                    y el anfitrión atendió cada detalle.
                </blockquote>
                <figcaption class="testimonial-author">Ana R. · Lima</figcaption>
            </figure>

            <figure class="testimonial">
                <div class="testimonial-stars" aria-label="5 de 5 estrellas">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </div>
                <blockquote class="testimonial-quote">
                    Reservar fue facilísimo y la casa estaba impecable. Volveremos sin dudarlo.
                </blockquote>
                <figcaption class="testimonial-author">Diego M. · Arequipa</figcaption>
            </figure>

            <figure class="testimonial">
                <div class="testimonial-stars" aria-label="5 de 5 estrellas">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </div>
                <blockquote class="testimonial-quote">
                    Comunicación excelente con el anfitrión y todo tal como en las fotos. Muy recomendable.
                </blockquote>
                <figcaption class="testimonial-author">Lucía P. · Cusco</figcaption>
            </figure>
        </div>
    </div>
</div>

@code {
    private List<Alojamiento> AlojamientosDestacados = new();

    // Campos del buscador del hero (solo UI; no implementan búsqueda compleja).
    private string Ubicacion = "";
    private DateTime? FechaEntrada;
    private DateTime? FechaSalida;
    private int Huespedes = 1;

    // Imagen del hero: tomada de un alojamiento real del catálogo (distinto a los destacados),
    // con respaldo en gradiente si no hubiera imagen. No altera datos ni servicios.
    private string HeroImagen = "";

    // Solo define la variable si hay imagen; si no, el CSS usa su respaldo (none).
    private string HeroStyle => "--hero-img: url('/images/premium/image (2).png')";

    protected override void OnInitialized()
    {
        var todos = Data.ObtenerAlojamientos();
        // Para el carrusel mostramos más estadías (hasta 8, o las que haya). Misma fuente de datos.
        AlojamientosDestacados = todos.Take(8).ToList();

        HeroImagen = todos.Skip(3).FirstOrDefault(a => !string.IsNullOrEmpty(a.ImagenUrl))?.ImagenUrl
                     ?? todos.FirstOrDefault(a => !string.IsNullOrEmpty(a.ImagenUrl))?.ImagenUrl
                     ?? "";
    }

    // Redirige a /explorar conservando la navegación existente.
    // Pasa los valores como query string (forward-compatible) sin cambiar la lógica de Explorar.
    private void Buscar()
    {
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(Ubicacion))
            query.Add($"ubicacion={Uri.EscapeDataString(Ubicacion)}");

        if (FechaEntrada.HasValue)
            query.Add($"entrada={FechaEntrada.Value:yyyy-MM-dd}");

        if (FechaSalida.HasValue)
            query.Add($"salida={FechaSalida.Value:yyyy-MM-dd}");

        if (Huespedes > 0)
            query.Add($"huespedes={Huespedes}");

        var url = query.Any()
            ? $"/explorar?{string.Join("&", query)}"
            : "/explorar";

        Navigation.NavigateTo(url);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("bunkiDatePicker.init", ".flatpickr-date");
            // Mismo patrón de interop que el datepicker: inicializa el carrusel ya renderizado por Blazor.
            await JS.InvokeVoidAsync("bunkiCarrusel.init", "#carruselDestacados");
            // Scroll reveal: DESPUÉS del datepicker y el carrusel (no los toca). Observa los [data-reveal]
            // y revela cada sección/tarjeta al entrar al viewport; respeta prefers-reduced-motion.
            await JS.InvokeVoidAsync("bunkiReveal.init");
        }
    }
    private string FormatPickerDate(DateTime? fecha)
    {
        return fecha?.ToString("yyyy-MM-dd") ?? "";
    }

    private void OnFechaEntradaChanged(ChangeEventArgs e)
    {
        FechaEntrada = ParsePickerDate(e.Value?.ToString());

        if (FechaEntrada.HasValue &&
            FechaSalida.HasValue &&
            FechaSalida <= FechaEntrada)
        {
            FechaSalida = null;
        }
    }

    private void OnFechaSalidaChanged(ChangeEventArgs e)
    {
        FechaSalida = ParsePickerDate(e.Value?.ToString());
    }

    private DateTime? ParsePickerDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        if (DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var fecha))
            return fecha;

        if (DateTime.TryParse(value, out fecha))
            return fecha;

        return null;
    }
}
