@page "/admin/incidencias"
@layout AdminLayout
@rendermode InteractiveServer
@inject DataService Data

<PageTitle>Bunki Admin · Incidencias</PageTitle>

@* Título quitado: ya lo muestra el topbar del AdminLayout (evitamos el doble título). *@
<p class="admin-page-sub">Tickets de soporte y problemas reportados por los usuarios.</p>

<div class="inc-table-card">
    <div class="inc-scroll">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th><th>Asunto</th><th>Usuario</th><th>Prioridad</th><th>Estado</th><th>Fecha</th><th style="text-align: right;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _tickets)
                {
                    <tr>
                        <td><strong>@t.Id</strong></td>
                        <td>@t.Asunto</td>
                        <td class="inc-muted">@t.Usuario</td>
                        <td>
                            <span class="inc-prio inc-prio--@t.Prioridad.ToLower()">
                                <span class="inc-prio-dot"></span>@t.Prioridad
                            </span>
                        </td>
                        <td>
                            <span class="state @EstadoState(t.Estado)"><span class="state-dot"></span>@t.Estado</span>
                        </td>
                        <td class="inc-muted">@t.Fecha</td>
                        <td style="text-align: right;">
                            <button class="btn btn-small btn-secondary" @onclick="() => Ver(t)">
                                <i class="fas fa-eye"></i> Ver
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- TOAST -->
@if (!string.IsNullOrEmpty(_mensaje))
{
    <div style="position: fixed; bottom: 24px; right: 24px; z-index: var(--z-toast);">
        <AlertMessage Tipo="success" Mensaje="@_mensaje" />
    </div>
}

<!-- MODAL DETALLE -->
@if (_sel is not null)
{
    <div class="modal-overlay">
        <div class="modal-panel inc-modal">
            <div class="inc-modal-head">
                <h2 class="inc-modal-title">@_sel.Id · @_sel.Asunto</h2>
                <span class="inc-prio inc-prio--@_sel.Prioridad.ToLower()">
                    <span class="inc-prio-dot"></span>@_sel.Prioridad
                </span>
            </div>

            <div class="inc-meta">
                <span><i class="fas fa-user"></i> @_sel.Usuario</span>
                <span class="state @EstadoState(_sel.Estado)"><span class="state-dot"></span>@_sel.Estado</span>
                <span><i class="fas fa-calendar-day"></i> @_sel.Fecha</span>
            </div>

            <p class="inc-desc">@_sel.Descripcion</p>

            <div class="form-group" style="margin-bottom: 16px;">
                <label>Comentario interno</label>
                <textarea rows="3" placeholder="Escribe una respuesta o nota (no se guarda)..." @bind="_comentario"></textarea>
                <p class="inc-hint">Este comentario es solo de demostración; aún no se guarda en backend.</p>
            </div>

            <div class="inc-actions">
                <button class="btn btn-outline" style="flex: 1;" @onclick="Cerrar">Cerrar</button>
                <button class="btn btn-primary" style="flex: 1;" @onclick="EnviarComentario"
                        disabled="@string.IsNullOrWhiteSpace(_comentario)">
                    <i class="fas fa-paper-plane"></i> Enviar
                </button>
            </div>
        </div>
    </div>
}

<style>
    .inc-table-card {
        background: var(--surface);
        border: 1px solid var(--hairline);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .inc-scroll { overflow-x: auto; }
    .inc-muted { color: var(--ink-muted); font-variant-numeric: tabular-nums; }

    /* Prioridad (punto + etiqueta, no solo color) */
    .inc-prio {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 4px 11px;
        border-radius: var(--radius-pill);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .inc-prio-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

    .inc-prio--alta { background: var(--danger-tint); color: var(--danger); }
    .inc-prio--alta .inc-prio-dot { background: var(--danger); }
    .inc-prio--media { background: var(--warning-tint); color: var(--warning); }
    .inc-prio--media .inc-prio-dot { background: var(--warning); }
    .inc-prio--baja { background: var(--success-tint); color: var(--success); }
    .inc-prio--baja .inc-prio-dot { background: var(--success); }

    /* Variante de estado "En proceso" (azul) que extiende .state global */
    .state--proceso { background: var(--blue-tint); color: var(--blue-strong); }
    .state--proceso .state-dot { background: var(--blue-strong); }

    /* Modal */
    .inc-modal { max-width: 560px; text-align: left; }

    .inc-modal-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 14px;
    }

    .inc-modal-title {
        font-family: var(--font-display);
        font-size: 19px;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--ink);
        line-height: 1.25;
    }

    .inc-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 18px;
        padding-bottom: 16px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--hairline);
        font-size: 13px;
        color: var(--ink-muted);
    }

        .inc-meta > span { display: inline-flex; align-items: center; gap: 7px; }
        .inc-meta i { color: var(--ink-faint); font-size: 12px; }

    .inc-desc {
        color: var(--ink);
        font-size: 14px;
        line-height: 1.65;
        margin-bottom: 22px;
    }

    .inc-hint { font-size: 12px; color: var(--ink-faint); margin-top: 6px; }

    .inc-actions { display: flex; gap: 12px; }
</style>

@code {
    private string _mensaje = "";
    private string _comentario = "";

    private record Ticket(string Id, string Asunto, string Usuario, string Prioridad, string Estado, string Fecha, string Descripcion);

    // Cargado desde DataService: misma fuente que el contador de /admin y la
    // pestaña Incidencias de /admin/moderacion.
    private List<Ticket> _tickets = new();

    protected override void OnInitialized()
    {
        _tickets = Data.ObtenerIncidenciasAdmin()
            .Select(i => new Ticket(i.Id, i.Asunto, i.Usuario, i.Prioridad, i.Estado, i.Fecha, i.Descripcion))
            .ToList();
    }

    // ---- Modal ----
    private Ticket? _sel;

    private void Ver(Ticket t)
    {
        _sel = t;
        _comentario = "";
    }

    private void Cerrar()
    {
        _sel = null;
        _comentario = "";
    }

    private void EnviarComentario()
    {
        if (string.IsNullOrWhiteSpace(_comentario)) return;
        // Solo UI: no persiste.
        _mensaje = $"Comentario registrado en {_sel?.Id} (mock, no se guarda).";
        Cerrar();
    }

    private string EstadoState(string estado) => estado switch
    {
        "Abierto"    => "state--pendiente",
        "En proceso" => "state--proceso",
        "Resuelto"   => "state--confirmada",
        "Cerrado"    => "state--completada",
        _            => "state--completada"
    };
}
