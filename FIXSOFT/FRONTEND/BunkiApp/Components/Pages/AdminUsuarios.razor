@page "/admin/usuarios"
@layout AdminLayout
@rendermode InteractiveServer
@using System.Globalization
@inject IJSRuntime JS
@inject UsuarioProvider UsuarioProvider

<PageTitle>Bunki Admin · Usuarios</PageTitle>

<h1 class="admin-page-title">Usuarios</h1>
<p class="admin-page-sub">Busca, filtra y administra las cuentas de la plataforma.</p>

<!-- TOOLBAR -->
<div class="adm-toolbar">
    <div class="filter-input-icon adm-search">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Buscar por nombre o email"
               value="@_search" @oninput="OnSearch" autocomplete="off" />
    </div>

    <select value="@_rol" @onchange="OnRol" class="adm-rol">
        <option value="Todos">Todos los roles</option>
        <option value="Cliente">Cliente</option>
        <option value="Anfitrión">Anfitrión</option>
        <option value="Admin">Admin</option>
    </select>

    <button class="btn btn-primary adm-create-btn" @onclick="() => _showCrear = true">
        <i class="fas fa-user-shield"></i> Crear Administrador
    </button>
</div>

<!-- TABLA -->
<div class="adm-table-card">
    <div class="adm-scroll">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Usuario</th><th>Email</th><th>Rol</th><th>Estado</th><th>Registro</th><th style="text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Filtrados.Any())
                {
                    <tr><td colspan="6"><div class="adm-empty">No se encontraron usuarios con esos criterios.</div></td></tr>
                }
                else
                {
                    @foreach (var u in Pagina)
                    {
                        <tr>
                            <td>
                                <div class="adm-user">
                                    <span class="adm-user-avatar">@Iniciales(u.Nombre)</span>
                                    <strong>@u.Nombre</strong>
                                </div>
                            </td>
                            <td class="adm-muted">@u.Email</td>
                            <td>@u.Rol</td>
                            <td>
                                <span class="state @EstadoClase(u.Estado)">
                                    <span class="state-dot"></span>@u.Estado
                                </span>
                            </td>
                            <td class="adm-muted">@u.Registro</td>
                            <td>
                                <div class="adm-row-actions" style="justify-content: flex-end;">
                                    <button class="btn btn-small btn-outline" title="Ver" @onclick="() => Ver(u)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn btn-small btn-secondary" title="Editar" @onclick="() => Editar(u)">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <button class="btn btn-small btn-soft-danger" title="@(u.Estado == "Activo" ? "Bloquear" : "Desbloquear")"
                                            @onclick="() => PedirBloqueo(u)" disabled="@(u.Rol == "Admin")">
                                        <i class="fas @(u.Estado == "Activo" ? "fa-ban" : "fa-unlock")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINACIÓN -->
    @if (Filtrados.Any())
    {
        <div class="adm-pager">
            <span class="adm-pager-info">
                Mostrando @Pagina.Count() de @Filtrados.Count() usuarios · Página @_pagina de @TotalPaginas
            </span>
            <div class="adm-pager-controls">
                <button class="adm-page-btn" @onclick="Anterior" disabled="@(_pagina <= 1)" aria-label="Anterior">
                    <i class="fas fa-chevron-left"></i>
                </button>
                @for (int p = 1; p <= TotalPaginas; p++)
                {
                    int pag = p;
                    <button class="adm-page-btn @(_pagina == pag ? "active" : "")" @onclick="() => _pagina = pag">@pag</button>
                }
                <button class="adm-page-btn" @onclick="Siguiente" disabled="@(_pagina >= TotalPaginas)" aria-label="Siguiente">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    }
</div>

<!-- TOAST -->
@if (!string.IsNullOrEmpty(_mensaje))
{
    <div style="position: fixed; bottom: 24px; right: 24px; z-index: var(--z-toast);">
        <AlertMessage Tipo="success" Mensaje="@_mensaje" />
    </div>
}

<!-- MODAL CREAR ADMINISTRADOR -->
@if (_showCrear)
{
    <div class="modal-overlay">
        <div class="modal-panel" style="max-width: 460px; text-align: left;">
            <h2 style="margin-bottom: 4px; text-align: center;">Crear Administrador</h2>
            <p class="card-text" style="margin-bottom: 22px; text-align: center;">El nuevo usuario tendrá permisos de administración.</p>

            <div class="form-group">
                <label>Email</label>
                <input type="email" placeholder="admin@bunki.pe" value="@_formEmail" @oninput='e => _formEmail = e.Value?.ToString() ?? ""' />
            </div>
            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" placeholder="••••••••" value="@_formPass" @oninput='e => _formPass = e.Value?.ToString() ?? ""' />
            </div>
            <div class="form-group">
                <label>Rol</label>
                <input type="text" value="Admin" readonly />
            </div>

            <div class="adm-modal-actions" style="margin-top: 8px;">
                <button class="btn btn-outline" style="flex: 1;" @onclick="CerrarCrear">Cancelar</button>
                <button class="btn btn-primary" style="flex: 1;" @onclick="GuardarAdmin" disabled="@string.IsNullOrWhiteSpace(_formEmail)">
                    Crear
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL CONFIRMAR BLOQUEO -->
@if (_showBloqueo && _target is not null)
{
    <div class="modal-overlay">
        <div class="modal-panel">
            <div class="empty-state-icon" style="margin-bottom: 18px; background: var(--danger-tint); color: var(--danger);">
                <i class="fas fa-ban"></i>
            </div>
            <h2 style="margin-bottom: 12px;">¿Bloquear usuario?</h2>
            <p class="card-text" style="margin-bottom: 24px;">
                Se bloqueará la cuenta de <strong>@_target.Nombre</strong> (@_target.Email).
            </p>
            <div class="adm-modal-actions">
                <button class="btn btn-outline" style="flex: 1;" @onclick="CerrarBloqueo">Cancelar</button>
                <button class="btn btn-danger" style="flex: 1;" @onclick="ConfirmarBloqueo">Bloquear</button>
            </div>
        </div>
    </div>
}

<style>
    .adm-toolbar {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .adm-search { flex: 1; min-width: 220px; max-width: 420px; }
    .adm-rol { max-width: 180px; }
    .adm-create-btn { margin-left: auto; }

    .adm-table-card {
        background: var(--surface);
        border: 1px solid var(--hairline);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .adm-scroll { overflow-x: auto; }
    .adm-muted { color: var(--ink-muted); }
    .adm-row-actions { display: flex; gap: 8px; }
    .adm-empty { padding: 40px 20px; text-align: center; color: var(--ink-muted); font-size: 14.5px; }
    .adm-modal-actions { display: flex; gap: 12px; }

    .adm-user { display: flex; align-items: center; gap: 11px; }

    .adm-user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--gold-tint);
        border: 1px solid rgba(214, 168, 79, 0.30);
        color: var(--gold);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* Paginación */
    .adm-pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px;
        flex-wrap: wrap;
        border-top: 1px solid var(--hairline);
    }

    .adm-pager-info { font-size: 13px; color: var(--ink-muted); }
    .adm-pager-controls { display: flex; gap: 6px; align-items: center; }

    .adm-page-btn {
        min-width: 36px;
        height: 36px;
        padding: 0 10px;
        border-radius: var(--radius);
        border: 1px solid var(--hairline-strong);
        background: transparent;
        color: var(--ink-muted);
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        cursor: pointer;
        transition: border-color var(--t), color var(--t), background var(--t);
    }

        .adm-page-btn:hover:not(:disabled) { border-color: var(--ink-faint); color: var(--ink); }
        .adm-page-btn.active { background: var(--warm-gradient); color: #1C140A; border-color: transparent; }
        .adm-page-btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .adm-page-btn:focus-visible { outline: none; box-shadow: var(--ring); }

    @@media (max-width: 560px) {
        .adm-create-btn { margin-left: 0; width: 100%; }
        .adm-search, .adm-rol { max-width: none; width: 100%; }
    }
</style>

@code {
    private string _search = "";
    private string _rol = "Todos";
    private int _pagina = 1;
    private const int PorPagina = 5;
    private string _mensaje = "";

    private class UsuarioAdmin
    {
        // Id real del backend: necesario para que bloquear/desbloquear sepan a qué usuario aplicar el cambio.
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Email { get; set; } = "";
        public string Rol { get; set; } = "";
        public string Estado { get; set; } = "Activo";
        public string Registro { get; set; } = "";
    }

    private List<UsuarioAdmin> _usuarios = new()
    {
        new() { Nombre = "Juan Pérez", Email = "juan@email.com", Rol = "Cliente", Estado = "Activo", Registro = "Ene 2024" },
        new() { Nombre = "María Andrades", Email = "maria@email.com", Rol = "Anfitrión", Estado = "Activo", Registro = "Mar 2023" },
        new() { Nombre = "Carlos Ruiz", Email = "carlos@email.com", Rol = "Anfitrión", Estado = "Activo", Registro = "Jun 2023" },
        new() { Nombre = "Laura Méndez", Email = "laura@email.com", Rol = "Cliente", Estado = "Activo", Registro = "Feb 2024" }
    };

    protected override async Task OnInitializedAsync()
    {
        // Lectura vía provider (REST). Si el backend responde con usuarios, se usan;
        // si no (offline o sin datos), se conserva la lista demo de arriba → idéntico a hoy.
        // El estado ahora viene del backend (campo "estado"); antes se asumía "Activo".
        var remotos = await UsuarioProvider.ListarAsync();
        if (remotos.Count > 0)
        {
            _usuarios = remotos.Select(u => new UsuarioAdmin
            {
                Id = u.Id,
                Nombre = string.IsNullOrWhiteSpace(u.NombreCompleto) ? u.Email : u.NombreCompleto,
                Email = u.Email,
                Rol = u.TipoUsuario,
                Estado = EstadoLegible(u.EstadoCuenta),   // estado real del backend -> etiqueta de UI
                Registro = u.MiembroDesde
            }).ToList();
        }
    }

    // Traduce el estado del backend (enum) a la etiqueta legible que muestra la UI.
    private string EstadoLegible(string estadoBackend) => estadoBackend switch
    {
        "DISPONIBLE" => "Activo",
        "SUSPENDIDO" => "Bloqueado",
        "PENDIENTE_VALIDACION" => "Pendiente",
        _ => "Activo"
    };

    // Color del badge según la etiqueta: Activo=verde, Bloqueado=rojo, Pendiente=ámbar.
    private string EstadoClase(string estado) => estado switch
    {
        "Activo" => "state--confirmada",
        "Bloqueado" => "state--cancelada",
        "Pendiente" => "state--pendiente",
        _ => "state--confirmada"
    };

    private IEnumerable<UsuarioAdmin> Filtrados => _usuarios.Where(u =>
        (_rol == "Todos" || u.Rol == _rol) &&
        (string.IsNullOrWhiteSpace(_search)
            || u.Nombre.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(Filtrados.Count() / (double)PorPagina));
    private IEnumerable<UsuarioAdmin> Pagina => Filtrados.Skip((_pagina - 1) * PorPagina).Take(PorPagina);

    private void OnSearch(ChangeEventArgs e) { _search = e.Value?.ToString() ?? ""; _pagina = 1; }
    private void OnRol(ChangeEventArgs e) { _rol = e.Value?.ToString() ?? "Todos"; _pagina = 1; }

    private void Anterior() { if (_pagina > 1) _pagina--; }
    private void Siguiente() { if (_pagina < TotalPaginas) _pagina++; }

    private string Iniciales(string nombre)
    {
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "?";
        return partes.Length == 1
            ? partes[0][..Math.Min(2, partes[0].Length)].ToUpper()
            : (partes[0][..1] + partes[1][..1]).ToUpper();
    }

    // ---- Acciones ----
    private async Task Ver(UsuarioAdmin u) =>
        await JS.InvokeVoidAsync("alert", $"Usuario: {u.Nombre}\nEmail: {u.Email}\nRol: {u.Rol}\nEstado: {u.Estado}\nRegistro: {u.Registro}");

    private async Task Editar(UsuarioAdmin u) =>
        await JS.InvokeVoidAsync("alert", $"Editar a {u.Nombre} (mock — pendiente de backend).");

    // ---- Modal bloquear ----
    private bool _showBloqueo;
    private UsuarioAdmin? _target;

    private async Task PedirBloqueo(UsuarioAdmin u)
    {
        // Si NO está Activo (bloqueado/pendiente) el clic desbloquea: persiste DISPONIBLE en BD.
        if (u.Estado != "Activo")
        {
            var ok = await UsuarioProvider.CambiarEstadoAsync(u.Id, "DISPONIBLE");
            if (ok) { u.Estado = "Activo"; _mensaje = $"{u.Nombre} fue desbloqueado."; }
            else { _mensaje = "No se pudo desbloquear."; }
            return;
        }
        // Está Activo: abrimos el modal para confirmar el bloqueo.
        _target = u;
        _showBloqueo = true;
    }

    private void CerrarBloqueo() { _showBloqueo = false; _target = null; }

    private async Task ConfirmarBloqueo()
    {
        if (_target is null) return;
        // Bloquear = persistir SUSPENDIDO en BD vía backend (antes solo cambiaba en memoria).
        var ok = await UsuarioProvider.CambiarEstadoAsync(_target.Id, "SUSPENDIDO");
        if (ok) { _target.Estado = "Bloqueado"; _mensaje = $"{_target.Nombre} fue bloqueado."; }
        else { _mensaje = "No se pudo bloquear el usuario."; }
        _showBloqueo = false;
        _target = null;
    }

    // ---- Modal crear administrador ----
    private bool _showCrear;
    private string _formEmail = "";
    private string _formPass = "";

    private void CerrarCrear() { _showCrear = false; _formEmail = ""; _formPass = ""; }

    private async Task GuardarAdmin()
    {
        if (string.IsNullOrWhiteSpace(_formEmail)) return;

        // Guardado mock: solo console.log (sin backend).
        await JS.InvokeVoidAsync("console.log", "Nuevo administrador (mock):", _formEmail, "Rol: Admin");

        _usuarios.Add(new UsuarioAdmin
        {
            Nombre = _formEmail.Split('@')[0],
            Email = _formEmail,
            Rol = "Admin",
            Estado = "Activo",
            Registro = DateTime.Now.ToString("MMM yyyy", new CultureInfo("es-ES"))
        });

        _mensaje = "Administrador creado (mock).";
        CerrarCrear();
    }
}
