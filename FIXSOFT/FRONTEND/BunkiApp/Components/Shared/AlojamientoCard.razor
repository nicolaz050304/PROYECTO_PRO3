@* Components/Shared/AlojamientoCard.razor *@
@inject BunkiApp.Models.AppState AppState
@implements IDisposable
@using System.Globalization

@* Tarjeta clicable entera (patrón Airbnb): cuando MostrarBoton es true, TODA la tarjeta es un enlace
   al detalle y se quita el viejo botón "Ver" (las auditorías lo marcaron como patrón débil). Cuando es
   false, se renderiza como <div> NO navegable: mismo contrato que antes (sin botón y sin navegar). Así
   se respeta MostrarBoton y la zona clicable es mucho mayor. *@
@if (MostrarBoton)
{
    <a class="card card--link" href="@Href">
        @Contenido
    </a>
}
else
{
    <div class="card">
        @Contenido
    </div>
}

@code {
    [Parameter, EditorRequired] public Alojamiento Alojamiento { get; set; } = default!;
    [Parameter] public bool MostrarBoton { get; set; } = true;
    [Parameter] public string? UrlDetalle { get; set; }

    protected override void OnInitialized() => AppState.OnChange += OnMonedaChanged;
    public void Dispose() => AppState.OnChange -= OnMonedaChanged;
    private void OnMonedaChanged() => InvokeAsync(StateHasChanged);

    private string Href => UrlDetalle ?? $"/alojamiento/{Alojamiento.Id}";

    // Contenido interno compartido por las dos variantes (enlace / div) para no duplicar el markup.
    private RenderFragment Contenido => @<text>
        @* .card-media: contenedor de la imagen que habilita el zoom contenido en hover y el velo
           inferior (ya definidos en .card-media). Antes la imagen iba suelta y ese zoom no se aplicaba. *@
        <div class="card-media">
            @if (!string.IsNullOrWhiteSpace(Alojamiento.ImagenUrl))
            {
                @* Tamaño/recorte movidos a la clase .card-image (antes inline). loading=lazy para no
                   penalizar el render de la cuadrícula con imágenes fuera de viewport. *@
                <img src="@Alojamiento.ImagenUrl" alt="@Alojamiento.Nombre" class="card-image" loading="lazy" />
            }
            else
            {
                @* Respaldo sin imagen: el degradado es dato del alojamiento (queda inline por dinámico);
                   el resto del estilo vive en .card-image-placeholder. Ícono FA en vez del emoji 🏠. *@
                <div class="card-image-placeholder" style="background: @Alojamiento.GradienteColor;">
                    <i class="fas fa-house card-placeholder-icon"></i>
                    <span class="card-placeholder-text">Sin imagen</span>
                </div>
            }
        </div>

        <div class="card-body">
            <h3 class="card-title">@Alojamiento.Nombre</h3>

            <div class="card-rating-row">
                @if (Alojamiento.TotalResenas > 0)
                {
                    @* Estrellas con íconos Font Awesome (llena / media / vacía) en dorado: más finas y
                       premium que los caracteres unicode ★ ☆ de antes; soportan media estrella. *@
                    <span class="card-rating">
                        @foreach (var clase in Estrellas(Alojamiento.Rating))
                        {
                            <i class="@clase"></i>
                        }
                        <span class="card-rating-score">@Alojamiento.Rating.ToString("0.0", CultureInfo.InvariantCulture)</span>
                        <span class="count">(@Alojamiento.TotalResenas)</span>
                    </span>
                }
                else
                {
                    <span class="card-rating-new">Nuevo · Sin reseñas</span>
                }
            </div>

            @* Descripción completa: el recorte a 2 líneas lo hace el CSS (.card-text con line-clamp),
               más limpio que el Substring(0,60) anterior que cortaba a media palabra. *@
            <p class="card-text">@Alojamiento.Descripcion</p>

            <div class="card-footer">
                @* El precio es el dato clave → mayor peso visual (champán, font-display, tabular). *@
                <span class="card-price">@AppState.FormatearPrecio(Alojamiento.PrecioNoche)<small> /noche</small></span>
                @if (MostrarBoton)
                {
                    @* Afordancia direccional (NO un botón aparte): toda la tarjeta navega; la flecha solo
                       refuerza la acción y se desplaza en hover. aria-hidden: el enlace ya da el destino. *@
                    <span class="card-go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
                }
            </div>
        </div>
    </text>;

    // Mapea el rating (0..5) a 5 clases de ícono FA: llena, media o vacía. Redondeo a la media estrella
    // más cercana para reflejar fielmente p.ej. "4.5" sin inventar precisión. Mantiene el propósito del
    // antiguo GenerarEstrellas, pero devolviendo markup de íconos en vez de caracteres unicode.
    private IEnumerable<string> Estrellas(double rating)
    {
        var medios = (int)Math.Round(Math.Clamp(rating, 0, 5) * 2, MidpointRounding.AwayFromZero);
        for (int i = 1; i <= 5; i++)
        {
            if (medios >= i * 2) yield return "fas fa-star";                       // llena
            else if (medios == i * 2 - 1) yield return "fas fa-star-half-stroke";  // media
            else yield return "far fa-star";                                       // vacía
        }
    }
}
