@* Components/Shared/AlojamientoCard.razor *@
@inject BunkiApp.Models.AppState AppState
@implements IDisposable
<div class="card">
    @if (!string.IsNullOrWhiteSpace(Alojamiento.ImagenUrl))
    {
        <!-- Si tiene imagen, cargamos la foto real llenando el contenedor (sin deformar) -->
        <img src="@Alojamiento.ImagenUrl" alt="@Alojamiento.Nombre" class="card-image" loading="lazy" style="width: 100%; height: 200px; object-fit: cover;" />
    }
    else
    {
        <!-- Fallback lindo: degradado suave + casa + "Sin imagen" -->
        <div class="card-image-placeholder" style="background: @Alojamiento.GradienteColor; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;">
            <span style="font-size: 42px; line-height: 1;">🏠</span>
            <span style="font-size: 12px; font-weight: 500; color: rgba(255, 255, 255, 0.85);">Sin imagen</span>
        </div>
    }

    <div class="card-body">
        <h3 class="card-title">@Alojamiento.Nombre</h3>
        <div class="rating mb-20">
            @if (Alojamiento.TotalResenas > 0)
            {
                <span class="star">@GenerarEstrellas(Alojamiento.Rating)</span>
                <span class="rating-text">(@Alojamiento.TotalResenas reseñas)</span>
            }
            else
            {
                <span class="rating-text">Nuevo · Sin reseñas</span>
            }
        </div>
        <p class="card-text">@Alojamiento.Descripcion.Substring(0, Math.Min(60, Alojamiento.Descripcion.Length))...</p>
        <div class="card-footer">
            <span class="card-price">@AppState.FormatearPrecio(Alojamiento.PrecioNoche)<small> /noche</small></span>
            @if (MostrarBoton)
            {
                <a href="@(UrlDetalle ?? $"/alojamiento/{Alojamiento.Id}")" class="btn btn-small btn-primary">Ver</a>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Alojamiento Alojamiento { get; set; } = default!;
    [Parameter] public bool MostrarBoton { get; set; } = true;
    [Parameter] public string? UrlDetalle { get; set; }

    protected override void OnInitialized() => AppState.OnChange += OnMonedaChanged;
    public void Dispose() => AppState.OnChange -= OnMonedaChanged;
    private void OnMonedaChanged() => InvokeAsync(StateHasChanged);

    private string GenerarEstrellas(double rating)
    {
        int llenas = (int)Math.Round(rating);
        return string.Concat(Enumerable.Range(0, 5).Select(i => i < llenas ? "★" : "☆"));
    }
}