@* Components/Shared/AlojamientoCard.razor *@
<div class="card">
    @if (!string.IsNullOrEmpty(Alojamiento.ImagenUrl))
    {
        <!-- Si tiene imagen, cargamos la foto única -->
        <img src="@Alojamiento.ImagenUrl" alt="@Alojamiento.Nombre" class="card-image" style="width: 100%; height: 200px; object-fit: cover;" />
    }
    else
    {
        <!-- Por si acaso algún alojamiento no tiene foto, dejamos tu gradiente como respaldo -->
        <div class="card-image-placeholder" style="background: @Alojamiento.GradienteColor;"></div>
    }

    <div class="card-body">
        <h3 class="card-title">@Alojamiento.Nombre</h3>
        <div class="rating mb-20">
            <span class="star">@GenerarEstrellas(Alojamiento.Rating)</span>
            <span class="rating-text">(@Alojamiento.TotalResenas reseñas)</span>
        </div>
        <p class="card-text">@Alojamiento.Descripcion.Substring(0, Math.Min(60, Alojamiento.Descripcion.Length))...</p>
        <div class="card-footer">
            <span class="card-price">S/ @Alojamiento.PrecioNoche/noche</span>
            @if (MostrarBoton)
            {
                <a href="/alojamiento/@Alojamiento.Id" class="btn btn-small btn-primary">Ver</a>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Alojamiento Alojamiento { get; set; } = default!;
    [Parameter] public bool MostrarBoton { get; set; } = true;

    private string GenerarEstrellas(double rating)
    {
        int llenas = (int)Math.Round(rating);
        return string.Concat(Enumerable.Range(0, 5).Select(i => i < llenas ? "★" : "☆"));
    }
}