@* Components/Shared/ReservaCard.razor *@
@inject NavigationManager Navigation
@inject BunkiApp.Models.AppState AppState
@implements IDisposable

<article class="rsv-card">

    <!-- MEDIA / PLACEHOLDER PREMIUM -->
    <div class="rsv-media rsv-media--@EstadoSlug">
        <span class="badge @Reserva.EstadoBadgeClass rsv-media-badge">@Reserva.Estado</span>
        <i class="fas fa-bed rsv-media-glyph"></i>
    </div>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="rsv-body">
        <h3 class="rsv-title">@Reserva.AlojamientoNombre</h3>
        <p class="rsv-location"><i class="fas fa-location-dot"></i> @Reserva.Ubicacion</p>

        <div class="rsv-meta">
            <span class="rsv-meta-item">
                <i class="fas fa-calendar-day"></i> @Reserva.FechasTexto
            </span>
            <span class="rsv-meta-item">
                <i class="fas fa-moon"></i> @Reserva.Noches @(Reserva.Noches == 1 ? "noche" : "noches")
            </span>
            <span class="rsv-meta-item">
                <i class="fas fa-user-group"></i> @Reserva.NumHuespedes @(Reserva.NumHuespedes == 1 ? "huésped" : "huéspedes")
            </span>
        </div>
    </div>

    <!-- PRECIO + ACCIONES -->
    <div class="rsv-aside">
        <div class="rsv-price-block">
            <span class="rsv-price-label">Total</span>
            <span class="price price-lg">@AppState.FormatearPrecio(Reserva.Total)</span>
            @if (AppState.MonedaEsReferencial)
            {
                <span class="rsv-price-note">≈ referencial · cobro en S/</span>
            }
        </div>

        <div class="rsv-actions">
            @if (Reserva.Estado == "Pendiente")
            {
                <button class="btn btn-small btn-primary" @onclick="IrAPagar">
                    <i class="fas fa-credit-card"></i> Pagar Ahora
                </button>
                <button class="btn btn-small btn-outline" @onclick="OnCancelar">Cancelar</button>
            }
            else if (Reserva.Estado == "Completada")
            {
                <button class="btn btn-small btn-secondary" @onclick="VerDetalle">Ver Detalles</button>
                <button class="btn btn-small btn-outline" @onclick="OnDejarResena">
                    <i class="fas fa-star"></i> Dejar Reseña
                </button>
            }
            else
            {
                <button class="btn btn-small btn-secondary" @onclick="VerDetalle">Ver Detalles</button>
                <button class="btn btn-small btn-outline" @onclick='() => Navigation.NavigateTo("/mensajes")'>Contactar</button>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Reserva Reserva { get; set; } = default!;
    [Parameter] public EventCallback<Reserva> OnCancelarReserva { get; set; }
    [Parameter] public EventCallback<Reserva> OnDejarResenaCallback { get; set; }

    protected override void OnInitialized() => AppState.OnChange += OnMonedaChanged;
    public void Dispose() => AppState.OnChange -= OnMonedaChanged;
    private void OnMonedaChanged() => InvokeAsync(StateHasChanged);

    // Tinte de la zona media según el estado de la reserva.
    private string EstadoSlug => Reserva.Estado switch
    {
        "Pendiente" => "pendiente",
        "Cancelada" => "cancelada",
        _ => "confirmada"
    };

    // AlojamientoId real de la reserva (DataService ya lo puebla).
    // El "> 0 ? ... : 1" es solo una protección mínima; no debería activarse
    // con los datos mock actuales. En REST, AlojamientoId viene del backend.
    private int AlojamientoIdSeguro => Reserva.AlojamientoId > 0 ? Reserva.AlojamientoId : 1;

    private void IrAPagar()
    {
        var url = $"/pagos?alojamientoId={AlojamientoIdSeguro}" +
                  $"&entrada={Reserva.FechaEntrada:yyyy-MM-dd}" +
                  $"&salida={Reserva.FechaSalida:yyyy-MM-dd}" +
                  $"&huespedes={Reserva.NumHuespedes}";

        Navigation.NavigateTo(url);
    }

    private void VerDetalle()
    {
        var url = $"/alojamiento/{AlojamientoIdSeguro}" +
                  $"?entrada={Reserva.FechaEntrada:yyyy-MM-dd}" +
                  $"&salida={Reserva.FechaSalida:yyyy-MM-dd}" +
                  $"&huespedes={Reserva.NumHuespedes}" +
                  $"&origen=mis-reservas";

        Navigation.NavigateTo(url);
    }

    private async Task OnCancelar() => await OnCancelarReserva.InvokeAsync(Reserva);
    private async Task OnDejarResena() => await OnDejarResenaCallback.InvokeAsync(Reserva);
}
